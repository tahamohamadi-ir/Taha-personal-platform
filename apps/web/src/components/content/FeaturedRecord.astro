---
/* content/FeaturedRecord - WF-04. Highlighted record panel: label, title,
   summary, metadata (composed via MetadataGroup), media slot, CTA slot.
   The whole record collapses when selected is false - an inactive selection
   renders nothing at all, never a placeholder. The title is a heading, not
   a wrapped link: the CTA arrives through the named "cta" slot so the card
   is never one giant focus target. Seams: heading level via as; metadata
   item shape is owned by MetadataGroup. Theming cascades from tokens. */
import MetadataGroup from "./MetadataGroup.astro";

interface MetadataItem {
  label: string;
  value: string;
  ltr?: boolean;
}
interface Props {
  selected?: boolean;
  label: string;
  title: string;
  as?: "h2" | "h3";
  summary?: string;
  metadata?: MetadataItem[];
}
const { selected = true, label, title, as = "h3", summary, metadata } = Astro.props;
const HeadingTag = as;
const hasMedia = Astro.slots.has("media");
const hasCta = Astro.slots.has("cta");
---
{
  selected && (
    <article class="content-featured">
      <p class="content-featured__label">{label}</p>
      <HeadingTag class="content-featured__title">{title}</HeadingTag>
      {summary && <p class="content-featured__summary">{summary}</p>}
      {metadata && metadata.length > 0 && <MetadataGroup items={metadata} />}
      {hasMedia && (
        <div class="content-featured__media">
          <slot name="media" />
        </div>
      )}
      {hasCta && (
        <div class="content-featured__cta">
          <slot name="cta" />
        </div>
      )}
    </article>
  )
}

<style>
  .content-featured {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .content-featured__label {
    margin: 0;
    color: var(--color-ink-tertiary);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [dir="rtl"] .content-featured__label {
    letter-spacing: 0;
    text-transform: none;
  }

  .content-featured__title {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-2xl);
  }

  .content-featured__summary {
    margin: 0;
    color: var(--color-ink-secondary);
  }

  .content-featured__media {
    width: 100%;
  }

  .content-featured__cta {
    margin-block-start: var(--space-2);
  }
</style>
