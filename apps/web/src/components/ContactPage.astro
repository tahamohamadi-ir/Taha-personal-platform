---
/* content/ContactPage - WF-07H. Contact family body, adopted onto the
   UtilityTemplate content slot by the route pages. Props-in/markup-out:
   the contact record arrives from the route loader (getSiteContact),
   never fetched here. The form keeps the frozen /api/contact contract -
   same urlencoded field names (locale, website honeypot, name, email,
   message) and the content.ts label dictionary - rebuilt on the ui
   primitives (InputField/TextareaField/Button) so persistent labels,
   aria-invalid and value retention stay owned by the shared layer.
   Distinct submit states: success renders a ready panel (role=status)
   and failure an error panel (role=alert), both driven by the Astro.url
   query round-trip (?sent=1 / ?sent=0 plus the entered fields); the
   primitives re-render entries via their value props so a failed
   submission keeps what was typed. The endpoint still answers 503
   honestly when SMTP is unset - the page never fakes success.
   Alternative contact paths render verbatim from the CMS contact
   record; phones/personal webmail addresses are excluded upstream
   (board A10).
   Seams: a new contact path is a ContactCTA/details variant proposal;
   form fields extend InputField/TextareaField - do not fork field
   markup. Theming cascades from tokens. */
import InputField from "./ui/InputField.astro";
import TextareaField from "./ui/TextareaField.astro";
import Button from "./ui/Button.astro";
import ContentState from "./ui/ContentState.astro";
import type { LocaleContent } from "../data/content";
import type { PublicSiteContactDto } from "../lib/cms/siteSettings";

interface Props {
  content: LocaleContent;
  contact: PublicSiteContactDto | null;
}

const { content, contact } = Astro.props;
const contactCopy = content.contact;

/* WF-07H value retention: on a failed submission the flow round-trips
   through the query string (?sent=0&name=...&email=...&message=...);
   the primitives re-render the entries via their value props so the
   user never retypes them. Build-time renders (no params) stay empty. */
const params = Astro.url.searchParams;
const sent = params.get("sent") === "1";
const failed = params.get("sent") === "0";
const restore = (field: string): string => params.get(field) ?? "";

const hasContact = Boolean(
  contact &&
    (contact.email !== "" ||
      contact.linkedin !== "" ||
      contact.orcid !== "" ||
      contact.location !== "" ||
      contact.employer !== ""),
);
---

<div class="contact-body">
  {
    hasContact && contact ? (
      <ul class="contact-details">
        {contact.email !== "" && (
          <li>
            <span class="detail-label">Email</span>
            <a href={`mailto:${contact.email}`}>
              <bdi>{contact.email}</bdi>
            </a>
          </li>
        )}
        {contact.linkedin !== "" && (
          <li>
            <span class="detail-label">LinkedIn</span>
            <a href={contact.linkedin} rel="me noopener noreferrer">
              <bdi>{contact.linkedin.replace(/^https?:\/\//, "")}</bdi>
            </a>
          </li>
        )}
        {contact.orcid !== "" && (
          <li>
            <span class="detail-label">ORCID</span>
            <a href={contact.orcid} rel="me noopener noreferrer">
              <bdi>{contact.orcid.replace(/^https?:\/\//, "")}</bdi>
            </a>
          </li>
        )}
        {contact.employer !== "" && (
          <li>
            <span class="detail-label">Work</span>
            {contact.employerUrl !== "" ? (
              <a href={contact.employerUrl} rel="noopener noreferrer">
                {contact.employer}
              </a>
            ) : (
              <span>{contact.employer}</span>
            )}
          </li>
        )}
        {contact.location !== "" && (
          <li>
            <span class="detail-label">Location</span>
            <span>{contact.location}</span>
          </li>
        )}
      </ul>
    ) : (
      <p class="contact-unavailable">{contactCopy.unavailable}</p>
    )
  }

  {
    contact && contact.formEnabled && contact.email !== "" && (
      <form class="contact-form" method="post" action="/api/contact">
        <h2>{contactCopy.formIntro}</h2>
        {sent && <ContentState kind="ready" heading={contactCopy.sentHeading} />}
        {failed && (
          <ContentState kind="error" heading={contactCopy.errorHeading} />
        )}
        <input type="hidden" name="locale" value={content.lang} />
        <input
          type="text"
          name="website"
          value=""
          class="contact-honeypot"
          tabindex={-1}
          autocomplete="off"
          aria-hidden="true"
        />
        <InputField
          label={contactCopy.nameLabel}
          name="name"
          value={restore("name")}
        />
        <InputField
          label={contactCopy.emailLabel}
          name="email"
          required
          value={restore("email")}
        />
        <TextareaField
          label={contactCopy.messageLabel}
          name="message"
          required
          value={restore("message")}
        />
        <div class="contact-form__submit">
          <Button type="submit">{contactCopy.sendLabel}</Button>
        </div>
      </form>
    )
  }
</div>

<style>
  .contact-details {
    list-style: none;
    margin: 0 0 var(--space-8, 2rem);
    padding: 0;
    display: grid;
    gap: var(--space-3, 0.75rem);
    max-width: var(--measure-prose, 62ch);
  }

  .contact-details li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: var(--space-2, 0.5rem);
    border-block-end: 1px solid var(--color-border-subtle);
  }

  .detail-label {
    flex: 0 0 6.5rem;
    color: var(--color-ink-secondary);
    font-size: var(--text-sm, 0.875rem);
    font-weight: 600;
  }

  .contact-details a {
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-details a:hover,
  .contact-details a:focus-visible {
    color: var(--color-brand);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    max-width: 34rem;
  }

  .contact-form h2 {
    font-size: var(--text-lg, 1.125rem);
    margin: 0 0 var(--space-2, 0.5rem);
    color: var(--color-ink);
  }

  .contact-form__submit {
    align-self: flex-start;
    margin-block-start: var(--space-3, 0.75rem);
  }

  .contact-honeypot {
    position: absolute;
    inset-inline-start: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
