---
interface CatalogItem {
  href: string;
  title: string;
  kicker?: string;
  meta?: string[];
  summary?: string;
}

interface Props {
  heading: string;
  intro?: string;
  items: CatalogItem[];
  emptyText?: string;
  emptyActionHref?: string;
  emptyActionLabel?: string;
}

const { heading, intro, items, emptyText, emptyActionHref, emptyActionLabel } = Astro.props;
const hasItems = items.length > 0;
---

<section class="catalog" aria-labelledby="catalog-heading">
  <div class="catalog__head">
    <h1 id="catalog-heading">{heading}</h1>
    {intro && <p class="catalog__intro">{intro}</p>}
  </div>

  {
    hasItems ? (
      <ul class="catalog__list">
        {items.map((item) => (
          <li>
            <a class="catalog__row" href={item.href}>
              <span class="catalog__body">
                {item.kicker && <span class="kicker">{item.kicker}</span>}
                <span class="catalog__title">{item.title}</span>
                {item.summary && <span class="catalog__summary">{item.summary}</span>}
                {item.meta && item.meta.length > 0 && (
                  <span class="meta-row">
                    {item.meta.filter(Boolean).map((m) => (
                      <span>{m}</span>
                    ))}
                  </span>
                )}
              </span>
              <span class="catalog__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-state">
        <p>{emptyText ?? ""}</p>
        {emptyActionHref && emptyActionLabel && (
          <a class="btn btn--quiet btn--sm" href={emptyActionHref}>{emptyActionLabel}</a>
        )}
      </div>
    )
  }
</section>

<style>
  .catalog {
    max-width: var(--measure-catalog, 44rem);
    margin-inline: auto;
    padding-block: var(--space-8, 4rem);
    display: grid;
    gap: var(--space-6, 2rem);
  }
  .catalog__head {
    display: grid;
    gap: var(--space-3, 0.75rem);
  }
  .catalog__head h1 {
    margin: 0;
    color: var(--ink-hi, #f2f6fa);
    font-size: 1.875rem;
    font-weight: 700;
  }
  [dir='rtl'] .catalog__head h1 { letter-spacing: 0; }
  .catalog__intro {
    margin: 0;
    color: var(--ink-mid, #a8b8c8);
    line-height: 1.7;
  }
  .catalog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4, 1rem);
  }
  .catalog__row {
    position: relative;
    display: grid;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-5, 1.5rem);
    background: var(--glass-fill, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--glass-edge, rgba(255, 255, 255, 0.16));
    border-radius: var(--radius-lg, 16px);
    text-decoration: none;
    transition: border-color 160ms ease-out;
  }
  .catalog__row::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .catalog__row { background: var(--surface-read, #101f3c); }
  }
  .catalog__row:hover,
  .catalog__row:focus-visible {
    border-color: var(--brand-text, #3dd6c5);
  }
  .catalog__row:focus-visible {
    outline: 2px solid var(--brand-text, #3dd6c5);
    outline-offset: 2px;
  }
  .catalog__body {
    display: grid;
    gap: var(--space-2, 0.5rem);
  }
  .catalog__title {
    color: var(--ink-hi, #f2f6fa);
    font-size: 1.125rem;
    font-weight: 650;
  }
  .catalog__summary {
    color: var(--ink-mid, #a8b8c8);
    line-height: 1.7;
  }
  .catalog__go {
    align-self: center;
    justify-self: end;
    color: var(--brand-text, #3dd6c5);
    font-size: 1.25rem;
  }
  [dir='rtl'] .catalog__go { transform: scaleX(-1); }
</style>
