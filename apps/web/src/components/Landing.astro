---
import type { LocaleContent } from "../data/content";
import type { Profile } from "../data/profile";
import HeroSection from "./sections/HeroSection.astro";
import PerspectiveGrid from "./sections/PerspectiveGrid.astro";
import FocusStrip from "./sections/FocusStrip.astro";
import EvidenceSection from "./sections/EvidenceSection.astro";
import WritingLatest from "./sections/WritingLatest.astro";
import ContactCTA from "./sections/ContactCTA.astro";

interface Props {
  content: LocaleContent;
  profile: Profile;
}

const { content, profile } = Astro.props;
---

<!--
  Landing is pure composition now (reDesign_plan §۴ home order):
  Hero → Perspective Grid → Focus Strip → Selected Evidence →
  Latest Writing → Contact CTA. Journey (M3/GSAP) slots in between
  Evidence and Writing when C-05 lands.
-->
<div class="landing">
  <HeroSection content={content} />
  <PerspectiveGrid content={content} />
  <FocusStrip content={content} profile={profile} />
  <EvidenceSection content={content} profile={profile} />
  <WritingLatest content={content} />
  <ContactCTA content={content} />
</div>

<style>
  /*
    Night canvas for the home experience (ADR-0031): the migrated sections
    consume §0 night tokens, so the landing carries its own deep-navy stage —
    same pattern as the gateway/404 pages — with the §۱.۲ aurora fields
    recreated inside it (the fixed body-level aurora paints behind this
    wrapper's opaque background).
  */
  .landing {
    background-color: var(--canvas-night, #071225);
    background-image:
      radial-gradient(
        48rem 48rem at 18% -12%,
        rgba(22, 184, 166, 0.08),
        transparent 65%
      ),
      radial-gradient(
        56rem 56rem at 88% 12%,
        rgba(142, 117, 230, 0.06),
        transparent 70%
      );
    color: var(--ink-hi, #f2f6fa);
    overflow-x: clip;
  }
</style>
