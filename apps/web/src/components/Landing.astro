---
/* Landing - WF-07A. Night-stage wrapper for the locale home (ADR-0031).
   After the HomeTemplate adoption the 8-block composition moved to the
   routes (src/pages/{fa,en}/index.astro composing HomeTemplate slots with
   the homeComposition adapter), and this component keeps only the home's
   fixed night canvas plus the §1.2 aurora fields, forwarded as a single
   default slot.
   The stage remaps the semantic role tokens to their §0 night counterparts
   for its subtree - the same swap [data-theme="dark"] performs - so the
   theme-aware WF-04 content components (ContentRow, PublicationRow,
   ContactCTA, ui primitives) stay readable on the night canvas in BOTH
   themes. Every value is a var() reference into the global token tables;
   no new raw design values are introduced.
   Seams: home blocks are HomeTemplate slots (order via the WF-07A adapter);
   another fixed-night page reuses this wrapper instead of re-authoring the
   stage. Theming cascades from tokens.
   WF-09: the stage also carries the portal-orbit-dark hero atmosphere
   (README section 3) as a decorative, aria-hidden full-bleed layer behind
   the lead block: responsive AVIF/WebP srcset from /art-derived/, lossless
   800w PNG fallback, object-position 72% 50% per the master's crop
   guidance, plus a token-only scrim (flat var(--canvas-night) veil +
   color-mix fade to the opaque canvas) so copy contrast never depends on
   the artwork. The stage is fixed-night in both themes (ADR-0031), so only
   the dark master is wired; the light companion stays
   generated-but-unwired (a <picture> can key on prefers-color-scheme but
   not on the site's data-theme attribute - recorded gap in WORK_LOG). No
   imports: this stays a zero-import wrapper. */
---
<div class="landing">
  <div class="landing__art" aria-hidden="true">
    <picture>
      <source
        type="image/avif"
        srcset="/art-derived/portal-orbit-dark-800w.avif 800w, /art-derived/portal-orbit-dark-1200w.avif 1200w, /art-derived/portal-orbit-dark-1600w.avif 1600w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/art-derived/portal-orbit-dark-800w.webp 800w, /art-derived/portal-orbit-dark-1200w.webp 1200w, /art-derived/portal-orbit-dark-1600w.webp 1600w"
        sizes="100vw"
      />
      <img
        class="landing__art-image"
        src="/art-derived/portal-orbit-dark-800w.png"
        alt=""
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
      />
    </picture>
    <div class="landing__art-scrim"></div>
    <div class="landing__art-fade"></div>
  </div>
  <slot />
</div>

<style>
  /*
    Night canvas for the home experience (ADR-0031): the fixed deep-navy
    stage with the §1.2 aurora fields recreated inside it (the fixed
    body-level aurora paints behind this wrapper's opaque background).
  */
  .landing {
    position: relative;
    /* Stacking context: the -1 art layer paints above the night canvas but
       below the slotted HomeTemplate blocks (WF-09). */
    isolation: isolate;
    background-color: var(--canvas-night, #071225);
    background-image:
      radial-gradient(
        48rem 48rem at 18% -12%,
        rgba(22, 184, 166, 0.08),
        transparent 65%
      ),
      radial-gradient(
        56rem 56rem at 88% 12%,
        rgba(142, 117, 230, 0.06),
        transparent 70%
      );
    color: var(--ink-hi, #f2f6fa);
    overflow-x: clip;
    /* Semantic role remap for the night stage (both themes): mirrors the
       [data-theme="dark"] swap using the §0 night token set. */
    --color-canvas: var(--canvas-night);
    --color-surface: var(--surface-read);
    --color-surface-muted: var(--glass-fill-strong);
    --color-ink: var(--ink-hi);
    --color-ink-secondary: var(--ink-mid);
    --color-ink-tertiary: var(--ink-low);
    --color-inverse: var(--canvas-night);
    --color-brand: var(--brand);
    --color-brand-emphasis-hover: var(--brand-text);
    --color-brand-soft: var(--glass-fill-strong);
    --color-signature: var(--gold);
    --color-signature-soft: var(--glass-fill-strong);
    --color-research: var(--violet);
    --color-research-soft: var(--glass-fill-strong);
    --color-context: var(--brand-deep);
    --color-context-soft: var(--glass-fill-strong);
    --color-border-subtle: var(--glass-edge);
    --color-border-strong: var(--ink-low);
    --color-control-border: var(--ink-low);
    --color-focus: var(--brand-text);
    --shadow-sm: var(--glass-shadow-dark);
  }

  /* WF-09 hero art: portal-orbit-dark covers the first viewport of the
     stage (the lead block's backdrop) and fades into the opaque canvas at
     its bottom edge, so there is no seam against the page background. The
     flat scrim is the token-only veil (works without color-mix support);
     the color-mix fade adds the tuned falloff where it is supported. Copy
     contrast rests on the remapped night tokens, never on the artwork. */
  .landing__art {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(100svh, 52rem);
    z-index: -1;
    overflow: hidden;
  }

  .landing__art-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* README crop guidance: preserve the right arch and left negative space. */
    object-position: 72% 50%;
  }

  .landing__art-scrim {
    position: absolute;
    inset: 0;
    background-color: var(--canvas-night);
    opacity: 0.3;
  }

  .landing__art-fade {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      180deg,
      color-mix(in srgb, var(--canvas-night) 55%, transparent) 0%,
      color-mix(in srgb, var(--canvas-night) 22%, transparent) 42%,
      var(--canvas-night) 100%
    );
  }
</style>
