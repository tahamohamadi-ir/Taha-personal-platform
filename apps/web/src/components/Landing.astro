---
import type { LocaleContent } from "../data/content";

interface Props {
  content: LocaleContent;
}

const { content } = Astro.props;
---

<section class="hero">
  <p class="hero-eyebrow">{content.hero.eyebrow}</p>
  <h1 class="hero-name">{content.name}</h1>
  <p class="hero-positioning">{content.positioning}</p>
  <p class="hero-proposition">{content.proposition}</p>
  <div class="hero-actions">
    <a href="#perspectives" class="cta cta--primary">{content.hero.primaryCta}</a>
    <a href="#about" class="cta cta--ghost">{content.hero.secondaryCta}</a>
  </div>
</section>

<section id="perspectives" class="section">
  <h2 class="section-heading">{content.perspectives.heading}</h2>
  <p class="section-intro">{content.perspectives.intro}</p>
  <div class="perspectives-grid">
    {
      content.perspectives.items.map((item) => (
        <article class="perspective">
          <h3 class="perspective-title">{item.title}</h3>
          <p class="perspective-audience">{item.audience}</p>
          <p class="perspective-description">{item.description}</p>
        </article>
      ))
    }
  </div>
  <p class="perspectives-note">{content.perspectives.note}</p>
</section>

<section id="about" class="section section--muted">
  <h2 class="section-heading">{content.about.heading}</h2>
  <p class="about-body">{content.about.body}</p>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 7rem);
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
  }

  .hero-eyebrow {
    color: var(--color-brand);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    margin-block-end: 1rem;
  }

  .hero-name {
    font-size: clamp(2.8rem, 2rem + 4vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-block-end: 1rem;
  }

  .hero-positioning {
    color: var(--color-signature);
    font-weight: 600;
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.5rem);
    margin-block-end: 1rem;
  }

  .hero-proposition {
    color: var(--color-ink-secondary);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    max-width: 42ch;
    margin-block-end: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 700;
  }

  .cta--primary {
    background-color: var(--color-brand);
    color: #fff;
  }

  .cta--primary:hover {
    background-color: var(--color-brand-emphasis);
  }

  .cta--ghost {
    color: var(--color-brand);
    border: 1px solid var(--color-border-strong);
  }

  .cta--ghost:hover {
    background-color: var(--color-brand-soft);
  }

  .section {
    padding-block: clamp(3rem, 8vw, 6rem);
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }

  .section--muted {
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-lg);
  }

  .section-heading {
    font-size: clamp(1.75rem, 1.5rem + 1.5vw, 2.5rem);
    margin-block-end: 0.75rem;
  }

  .section-intro {
    color: var(--color-ink-secondary);
    max-width: 60ch;
    margin-block-end: 2rem;
  }

  .perspectives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin-block-end: 1.5rem;
  }

  .perspective {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .perspective-title {
    font-size: 1.25rem;
    margin-block-end: 0.25rem;
  }

  .perspective-audience {
    color: var(--color-brand);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-block-end: 0.75rem;
  }

  .perspective-description {
    color: var(--color-ink-secondary);
  }

  .perspectives-note {
    color: var(--color-ink-secondary);
    font-size: 0.875rem;
  }

  .about-body {
    max-width: 60ch;
    color: var(--color-ink);
    font-size: 1.125rem;
  }
</style>
