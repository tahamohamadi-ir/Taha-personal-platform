---
import type { LocaleContent } from "../data/content";
import type { Profile } from "../data/profile";
import Constellation3D from "./islands/Constellation3D";
import HeroSection from "./sections/HeroSection.astro";

interface Props {
  content: LocaleContent;
  profile: Profile;
}

const { content, profile } = Astro.props;
const localeProfile = profile;
const home = `/${content.lang}/`;
const perspectiveHref: Record<string, string> = {
  research: `${home}research/`,
  engineering: `${home}projects/`,
  writing: `${home}writing/`,
};
const selectedResearch = localeProfile.researchProjects.slice(0, 2);
const selectedPublications = localeProfile.publications.slice(0, 2);
---

<HeroSection content={content} />

<section id="perspectives" class="section">
  <div class="section-head">
    <span class="section-label">{content.perspectives.label}</span>
    <h2 class="section-heading">{content.perspectives.heading}</h2>
    <p class="section-intro">{content.perspectives.intro}</p>
  </div>
  <div class="perspectives-grid">
    {
      content.perspectives.items.map((item) => {
        const href = perspectiveHref[item.id];
        return (
          <article class={`perspective perspective--${item.id}`}>
            <h3 class="perspective-title">
              {href ? (
                <a class="perspective-link" href={href}>
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>
            <p class="perspective-audience">{item.audience}</p>
            <p class="perspective-description">{item.description}</p>
          </article>
        );
      })
    }
  </div>
  <p class="perspectives-note">{content.perspectives.note}</p>
</section>

<aside class="focus-strip" aria-labelledby="focus-heading">
  <h2 id="focus-heading" class="focus-label">{content.hero.focusLabel}</h2>
  <p class="focus-text">{localeProfile.availability}</p>
</aside>

{
  (selectedResearch.length > 0 || selectedPublications.length > 0) && (
    <section class="section" aria-labelledby="evidence-heading">
      <div class="section-head">
        <span class="section-label">{content.evidence.label}</span>
        <h2 id="evidence-heading" class="section-heading">{content.evidence.heading}</h2>
      </div>
      <ul class="evidence-list">
        {selectedResearch.map((project) => (
          <li>
            <a class="evidence-link" href={`${home}research/`}>
              {project.title}
            </a>
          </li>
        ))}
        {selectedPublications.map((publication) => (
          <li>
            <span class="evidence-title">{publication.title}</span>
            <span class="evidence-status">{publication.status}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<section id="about" class="section section--muted">
  <div class="section-head">
    <span class="section-label">{content.about.label}</span>
    <h2 class="section-heading">{content.about.heading}</h2>
    <div class="rule" aria-hidden="true"><span></span></div>
  </div>
  <p class="about-body">{localeProfile.shortBio}</p>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 7rem);
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
    min-width: 0;
  }

  .hero-copy,
  .hero-visual,
  .section-head,
  .perspectives-grid,
  .perspective {
    min-width: 0;
  }

  .hero-eyebrow {
    color: var(--color-brand);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    margin-block-end: 1rem;
  }

  :global(html[dir="rtl"]) .hero-eyebrow {
    letter-spacing: 0;
  }

  .hero-name {
    font-size: clamp(2.6rem, 1.9rem + 3.6vw, 4.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin-block-end: 1rem;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  :global(html[dir="rtl"]) .hero-name {
    letter-spacing: 0;
  }

  .hero-positioning {
    color: var(--color-ink);
    font-weight: 600;
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.5rem);
    margin-block-end: 1rem;
    overflow-wrap: anywhere;
  }

  .hero-positioning::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 3px;
    margin-block-start: 0.875rem;
    background-color: var(--color-signature);
  }

  .hero-proposition {
    color: var(--color-ink-secondary);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    max-width: 42ch;
    margin-block-end: 2rem;
    overflow-wrap: anywhere;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    max-width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 700;
    overflow-wrap: anywhere;
    transition: background-color 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .cta--primary {
    background-color: var(--color-brand);
    color: var(--color-inverse);
  }

    .cta--primary:hover {
      background-color: var(--color-brand-emphasis-hover);
    }

  .cta--primary:focus-visible {
    outline-color: var(--color-navy-950);
  }

  .cta--ghost {
    color: var(--color-brand);
    border: 1px solid var(--color-control-border);
  }

  .cta--ghost:hover,
  .cta--ghost:focus-visible {
    background-color: var(--color-brand-soft);
    border-color: var(--color-brand);
  }

  .hero-visual {
    display: grid;
    place-items: center;
  }

  .constellation {
    width: 100%;
    max-width: 420px;
    height: auto;
    display: block;
  }

  .hero-visual :global(.constellation-3d) {
    display: none;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1 / 1;
  }

  .hero-visual :global(.constellation-3d[data-ready="true"]) {
    display: block;
  }

  .hero-visual:has(:global(.constellation-3d[data-ready="true"]))
    .constellation {
    display: none;
  }

  /* One-time constellation entrance (B5 Candidate 1, ADR-0030).
     CSS-only: no JS, hero copy untouched. Reduced-motion and no-JS
     users get the static constellation (base styles above are final-state). */
  @media (prefers-reduced-motion: no-preference) {
    .constellation .spoke,
    .constellation .tick,
    .constellation .ring {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: landing-const-draw 1.2s var(--ease-out) forwards;
    }

    .constellation .ring {
      animation-delay: 0ms;
    }

    .constellation .spoke:nth-of-type(1) {
      animation-delay: 100ms;
    }

    .constellation .spoke:nth-of-type(2) {
      animation-delay: 150ms;
    }

    .constellation .spoke:nth-of-type(3) {
      animation-delay: 200ms;
    }

    .constellation .spoke:nth-of-type(4) {
      animation-delay: 250ms;
    }

    .constellation .spoke:nth-of-type(5) {
      animation-delay: 300ms;
    }

    .constellation .tick:nth-of-type(1) {
      animation-delay: 550ms;
    }

    .constellation .tick:nth-of-type(2) {
      animation-delay: 620ms;
    }

    .constellation .tick:nth-of-type(3) {
      animation-delay: 690ms;
    }

    .constellation .tick:nth-of-type(4) {
      animation-delay: 760ms;
    }

    /* Dashed connectors keep their 4/7 dash look, so they fade instead of drawing. */
    .constellation .link {
      opacity: 0;
      animation: landing-const-fade 600ms var(--ease-out) forwards;
    }

    .constellation .link:nth-of-type(1) {
      animation-delay: 750ms;
    }

    .constellation .link:nth-of-type(2) {
      animation-delay: 850ms;
    }

    .constellation .link:nth-of-type(3) {
      animation-delay: 950ms;
    }

    .constellation .node,
    .constellation .core {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      transform: scale(0.3);
      animation: landing-const-node 450ms var(--ease-out) forwards;
    }

    .constellation .node-1 {
      animation-delay: 700ms;
    }

    .constellation .node-2 {
      animation-delay: 770ms;
    }

    .constellation .node-3 {
      animation-delay: 840ms;
    }

    .constellation .node-4 {
      animation-delay: 910ms;
    }

    .constellation .node-5 {
      animation-delay: 980ms;
    }

    .constellation .core {
      animation-delay: 1100ms;
    }
  }

  @keyframes landing-const-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes landing-const-fade {
    to {
      opacity: 0.55;
    }
  }

  @keyframes landing-const-node {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .section {
    padding-block: clamp(3rem, 8vw, 6rem);
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
    min-width: 0;
    overflow-x: clip;
  }

  .section--muted {
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-lg);
  }

  .section-head {
    margin-block-end: 2rem;
  }

  .section-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand);
    margin-block-end: 0.5rem;
  }

  :global(html[dir="rtl"]) .section-label {
    font-family: var(--font-persian);
    letter-spacing: 0.02em;
  }

  .section-heading {
    font-size: clamp(1.75rem, 1.5rem + 1.5vw, 2.5rem);
    margin-block-end: 0.75rem;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .section-intro {
    color: var(--color-ink-secondary);
    max-width: 60ch;
    margin-block-end: 0;
  }

  .rule {
    position: relative;
    height: 1px;
    background-color: var(--color-border-subtle);
    margin-block: 1.25rem 0 0;
  }

  .rule span {
    position: absolute;
    inset-inline-start: 0;
    top: -1px;
    height: 3px;
    width: 64px;
    background-color: var(--color-signature);
  }

  .perspectives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-block-end: 1.5rem;
  }

  .perspective {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--color-brand);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .perspective--research {
    border-inline-start-color: var(--color-research);
  }

  .perspective--engineering {
    border-inline-start-color: var(--color-brand);
  }

  .perspective--writing {
    border-inline-start-color: var(--color-context);
  }

  .perspective-title {
    font-size: 1.25rem;
    margin-block-end: 0.25rem;
    overflow-wrap: anywhere;
  }

  .perspective-link {
    color: inherit;
    text-decoration: none;
  }

  .perspective-link:hover,
  .perspective-link:focus-visible {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .perspective-audience {
    color: var(--color-brand);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-block-end: 0.75rem;
    overflow-wrap: anywhere;
  }

  .perspective--research .perspective-audience {
    color: var(--color-research);
  }

  .perspective--writing .perspective-audience {
    color: var(--color-context);
  }

  .perspective-description {
    color: var(--color-ink-secondary);
    overflow-wrap: anywhere;
  }

  .perspectives-note {
    color: var(--color-ink-secondary);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .about-body {
    max-width: 60ch;
    color: var(--color-ink);
    font-size: 1.125rem;
    overflow-wrap: anywhere;
  }

  .focus-strip {
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
    min-width: 0;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    padding-block: 0 0.5rem;
    overflow-x: clip;
  }

  .focus-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand);
    margin: 0 0 0.5rem;
  }

  :global(html[dir="rtl"]) .focus-label {
    font-family: var(--font-persian);
    letter-spacing: 0.02em;
  }

  .focus-text {
    margin: 0;
    max-width: 60ch;
    color: var(--color-ink);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .evidence-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    overflow-x: clip;
  }

  .evidence-list li {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--color-brand);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .evidence-link,
  .evidence-title {
    display: block;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .evidence-link:hover,
  .evidence-link:focus-visible {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .evidence-status {
    display: block;
    margin-block-start: 0.25rem;
    color: var(--color-ink-secondary);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-visual {
      order: 2;
    }

    .constellation {
      max-width: 240px;
      opacity: 0.9;
    }

    .hero-visual :global(.constellation-3d) {
      max-width: 240px;
    }
  }

  @media (max-width: 12rem) {
    .hero,
    .section {
      padding-inline: 0.75rem;
    }

    .hero-actions {
      width: 100%;
    }

    .cta {
      width: 100%;
      padding-inline: 0.75rem;
    }

    .hero-eyebrow,
    .section-label {
      overflow-wrap: anywhere;
    }
  }
</style>
