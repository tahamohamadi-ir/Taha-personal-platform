---
/* ui/Chip - ATLAS-02 primitive. Compact label token. Seams: variants
   neutral|selected|taxonomy (selected is the brand fill). Optional remove
   affordance is caller-owned via the named "remove" slot - pass a Button
   size sm or an IconButton so the removal stays URL-backed/no-JS. Label
   via default slot; theming cascades from tokens. */
interface Props {
  variant?: "neutral" | "selected" | "taxonomy";
}
const { variant = "neutral" } = Astro.props;
const hasRemove = Astro.slots.has("remove");
---
<span class:list={["ui-chip", `ui-chip--${variant}`]}>
  <span class="ui-chip__label">
    <slot />
  </span>
  {
    hasRemove && (
      <span class="ui-chip__remove">
        <slot name="remove" />
      </span>
    )
  }
</span>

<style>
  .ui-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--space-8);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
  }

  .ui-chip__label {
    display: inline-flex;
    align-items: center;
  }

  .ui-chip__remove {
    display: inline-flex;
  }

  .ui-chip__remove > :global(*) {
    min-height: var(--space-11);
  }

  .ui-chip--taxonomy {
    border-color: transparent;
    background-color: var(--color-brand-soft);
    color: var(--color-ink);
  }

  .ui-chip--selected {
    border-color: var(--color-brand);
    background-color: var(--color-brand);
    color: var(--color-inverse);
  }
</style>
