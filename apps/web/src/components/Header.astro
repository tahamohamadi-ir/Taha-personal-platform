---
import type { LocaleContent } from "../data/content";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
}

const { content } = Astro.props;
const mark = content.lang === "fa" ? "طه" : "TM";
const switchHref = content.lang === "fa" ? "/en/" : "/fa/";
const switchLabel = content.lang === "fa" ? "EN" : "فارسی";
const switchLang = content.lang === "fa" ? "en" : "fa";
---

<header class="site-header">
  <div class="site-header-inner">
    <a href={`/${content.lang}/`} class="brand" aria-label={content.name}>
      <span class="brand-mark" aria-hidden="true">{mark}</span>
      <span class="brand-name">{content.name}</span>
    </a>
    <nav class="header-actions" aria-label={content.footer.switchLabel}>
      <a
        href={switchHref}
        hreflang={switchLang}
        lang={switchLang}
        class="lang-link"
      >
        {switchLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @supports (backdrop-filter: blur(10px)) {
    .site-header {
      background-color: rgba(247, 248, 245, 0.82);
      -webkit-backdrop-filter: blur(10px) saturate(120%);
      backdrop-filter: blur(10px) saturate(120%);
    }
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.625rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    min-height: 2.75rem;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background-color: var(--color-navy-950);
    color: var(--color-turquoise-500);
    border-radius: var(--radius-md);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    text-decoration: none;
    color: var(--color-ink-secondary);
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lang-link:hover {
    color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }
</style>
