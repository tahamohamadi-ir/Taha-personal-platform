---
import type { LocaleContent } from "../data/content";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
}

const { content } = Astro.props;
const mark = content.lang === "fa" ? "طه" : "TM";
const switchHref = content.lang === "fa" ? "/en/" : "/fa/";
const switchLabel = content.lang === "fa" ? "EN" : "فارسی";
const switchLang = content.lang === "fa" ? "en" : "fa";
---

<header class="site-header">
  <a href={`/${content.lang}/`} class="brand" aria-label={content.name}>
    <span class="brand-mark" aria-hidden="true">{mark}</span>
    <span class="brand-name">{content.name}</span>
  </a>
  <nav class="header-actions" aria-label={content.footer.switchLabel}>
    <a href={switchHref} hreflang={switchLang} lang={switchLang} class="lang-link">
      {switchLabel}
    </a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background-color: var(--color-navy-950);
    color: var(--color-turquoise-500);
    border-radius: var(--radius-md);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .lang-link {
    text-decoration: none;
    color: var(--color-ink-secondary);
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-md);
  }

  .lang-link:hover {
    color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }
</style>
