---
import type { LocaleContent } from "../data/content";
import { content as allContent } from "../data/content";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
}

const { content } = Astro.props;
const otherLang = content.lang === "fa" ? "en" : "fa";
const other = allContent[otherLang];
const switchHref = Astro.props.alternateHref ?? `/${otherLang}/`;
const switchLabel =
  content.lang === "fa"
    ? other.gateway.englishLabel
    : other.gateway.persianLabel;
const switchLang = otherLang;
---

<header class="site-header">
  <div class="site-header-inner">
    <a href={`/${content.lang}/`} class="brand" aria-label={content.name}>
      <img
        src="/logo.png"
        alt=""
        class="brand-logo"
        width="64"
        height="58"
        loading="eager"
      />
      <span class="brand-name">{content.name}</span>
    </a>
    <div class="header-nav-group">
      <nav class="header-nav" aria-label={content.about.heading}>
        <a href={`/${content.lang}/about/`} class="header-link">
          {content.about.heading}
        </a>
        <a href={`/${content.lang}/blog/`} class="header-link">
          {content.blog.heading}
        </a>
        <a href={`/${content.lang}/cv/`} class="header-link">
          {content.downloads.heading}
        </a>
      </nav>
      <nav class="header-actions" aria-label={content.footer.switchLabel}>
        <a
          href={switchHref}
          hreflang={switchLang}
          lang={switchLang}
          class="header-link"
        >
          {switchLabel}
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @supports (backdrop-filter: blur(10px)) {
    .site-header {
      background-color: var(--glass-bg-light);
      -webkit-backdrop-filter: blur(10px) saturate(120%);
      backdrop-filter: blur(10px) saturate(120%);
    }
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.625rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
    box-sizing: border-box;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    min-height: 2.75rem;
    min-width: 0;
  }

  .brand-logo {
    width: 2.25rem;
    height: auto;
    display: block;
    flex: none;
  }

  .header-nav-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
    min-width: 0;
    max-width: 100%;
  }

  .header-nav,
  .header-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.15rem;
    min-width: 0;
    max-width: 100%;
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    text-decoration: none;
    color: var(--color-ink-secondary);
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .header-link:hover {
    color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }

  /* About + Writing + CV + language switch: wrap inside the viewport instead
     of expanding document scrollWidth (mobile-overflow QA). */
  @media (max-width: 40rem) {
    .site-header-inner {
      flex-wrap: wrap;
      gap: 0.35rem;
      padding-inline: 0.75rem;
    }

    .brand {
      flex: 1 1 auto;
      gap: 0.5rem;
    }

    .brand-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.9rem;
    }

    .header-nav-group {
      flex: 1 1 12rem;
    }

    .header-link {
      padding-inline: 0.45rem;
      font-size: 0.8125rem;
    }
  }

  /* Zoom-approximation 160/195 CSS px: logo row + 2×2 link grid so every
     `.site-header a` stays within the short viewport after scroll. */
  @media (max-width: 14rem) {
    .site-header-inner {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: stretch;
      gap: 0.25rem;
      padding: 0.5rem;
    }

    .brand {
      grid-column: 1 / -1;
      justify-content: center;
      min-height: 2.25rem;
    }

    .brand-name {
      display: none;
    }

    .header-nav-group,
    .header-nav,
    .header-actions {
      display: contents;
    }

    .header-link {
      justify-content: center;
      width: 100%;
      min-height: 2.25rem;
      padding-inline: 0.25rem;
      font-size: 0.75rem;
      overflow-wrap: anywhere;
    }
  }
</style>
