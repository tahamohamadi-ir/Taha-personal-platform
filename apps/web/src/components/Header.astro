---
import type { LocaleContent } from "../data/content";
import { content as allContent } from "../data/content";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
}

const { content } = Astro.props;
const otherLang = content.lang === "fa" ? "en" : "fa";
const other = allContent[otherLang];
const mark = content.mark;
const switchHref = Astro.props.alternateHref ?? `/${otherLang}/`;
const switchLabel =
  content.lang === "fa"
    ? other.gateway.englishLabel
    : other.gateway.persianLabel;
const switchLang = otherLang;
---

<header class="site-header">
  <div class="site-header-inner">
    <a href={`/${content.lang}/`} class="brand" aria-label={content.name}>
      <span class="brand-mark" aria-hidden="true">{mark}</span>
      <span class="brand-name">{content.name}</span>
    </a>
    <div class="header-nav-group">
      <nav class="header-nav" aria-label={content.about.heading}>
        <a href={`/${content.lang}/about/`} class="header-link">
          {content.about.heading}
        </a>
      </nav>
      <nav class="header-actions" aria-label={content.footer.switchLabel}>
        <a
          href={switchHref}
          hreflang={switchLang}
          lang={switchLang}
          class="header-link"
        >
          {switchLabel}
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @supports (backdrop-filter: blur(10px)) {
    .site-header {
      background-color: var(--glass-bg-light);
      -webkit-backdrop-filter: blur(10px) saturate(120%);
      backdrop-filter: blur(10px) saturate(120%);
    }
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.625rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    min-height: 2.75rem;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background-color: var(--color-navy-950);
    color: var(--color-turquoise-500);
    border-radius: var(--radius-md);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .header-nav-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    text-decoration: none;
    color: var(--color-ink-secondary);
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .header-link:hover {
    color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }

  @media (max-width: 32rem) {
    .site-header-inner {
      gap: 0.25rem;
      padding-inline: 0.75rem;
    }

    .brand {
      min-width: 0;
      flex: 1 1 auto;
      gap: 0.5rem;
    }

    .brand-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.9rem;
    }

    .header-nav-group {
      flex: 0 0 auto;
      gap: 0;
    }

    .header-link {
      padding-inline: 0.5rem;
      font-size: 0.875rem;
    }
  }

  /* At the 160px zoom-approximation viewport, fallback font metrics can make
     the inline brand plus two required navigation links wider than the header.
     Keep every action reachable by giving navigation its own two-column row. */
  @media (max-width: 12rem) {
    .site-header-inner {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0.5rem;
    }

    .brand {
      flex: 0 0 auto;
    }

    .brand-name {
      display: none;
    }

    .header-nav-group {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      flex: 1 0 100%;
      gap: 0.25rem;
      width: 100%;
    }

    .header-nav,
    .header-actions {
      display: flex;
      min-width: 0;
    }

    .header-link {
      justify-content: center;
      width: 100%;
      padding-inline: 0.25rem;
      overflow-wrap: anywhere;
    }
  }
</style>
