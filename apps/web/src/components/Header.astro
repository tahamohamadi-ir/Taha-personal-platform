---
import type { LocaleContent } from "../data/content";
import { content as allContent } from "../data/content";
import { getSiteBrand } from "../lib/cms/siteSettings";
import { isCmsOriginBuild } from "../lib/cms/client";
import logo from "../branding/logo.png";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
}

const { content } = Astro.props;
const otherLang = content.lang === "fa" ? "en" : "fa";
const other = allContent[otherLang];
const switchHref = Astro.props.alternateHref ?? `/${otherLang}/`;
const switchLabel =
  content.lang === "fa"
    ? other.gateway.englishLabel
    : other.gateway.persianLabel;
const switchLang = otherLang;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  currentPath === (href.replace(/\/+$/, "") || "/");
const homeHref = `/${content.lang}/`;
const cmsBrand = await getSiteBrand();
const isCms = isCmsOriginBuild();
const displayName = cmsBrand ?? (isCms ? "" : content.name);
const navItems = [
  { href: `/${content.lang}/about/`, label: content.about.heading },
  { href: `/${content.lang}/research/`, label: content.research.heading },
  { href: `/${content.lang}/projects/`, label: content.projects.heading },
  { href: `/${content.lang}/writing/`, label: content.blog.heading },
  { href: `/${content.lang}/cv/`, label: content.downloads.heading },
  { href: `/${content.lang}/contact/`, label: content.contact.heading },
  { href: `/${content.lang}/search/`, label: content.search.navLabel },
];
// E9/P13 (owner decision 2026-08-24, option B): P8 catalogs live in a "More"
// disclosure group — keeps the top-level header compact, no mega-menu.
const moreLabel = content.lang === "fa" ? "بیشتر" : "More";
const moreItems = [
  {
    href: `/${content.lang}/publications/`,
    label: content.catalog.publicationsHeading,
  },
  { href: `/${content.lang}/books/`, label: content.catalog.booksHeading },
  { href: `/${content.lang}/talks/`, label: content.catalog.talksHeading },
  {
    href: `/${content.lang}/downloads/`,
    label: content.catalog.downloadsHeading,
  },
];
const moreActive = moreItems.some((item) => isCurrent(item.href));
---

<header class="site-header glass-surface">
  <div class="site-header-inner">
    <a
      href={homeHref}
      class="brand"
      aria-label={displayName !== "" ? displayName : content.name}
      aria-current={isCurrent(homeHref) ? "page" : undefined}
    >
      <img
        src={logo.src}
        alt=""
        class="brand-logo"
        width={logo.width}
        height={logo.height}
        loading="eager"
      />
      <span class="brand-name">{displayName}</span>
    </a>
    <div class="header-nav-group">
      <nav class="header-nav" aria-label={content.navLabel}>
        {
          navItems.slice(0, 4).map((item) => (
            <a
              href={item.href}
              class="header-link"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <details class="nav-more" data-active={moreActive ? "true" : undefined}>
          <summary
            class="header-link nav-more-summary"
            aria-current={moreActive ? "page" : undefined}
          >
            {moreLabel}
            <svg class="nav-more-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
              <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </summary>
          <div class="nav-more-panel">
            {
              moreItems.map((item) => (
                <a
                  href={item.href}
                  class="nav-more-link"
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </details>
        {
          navItems.slice(4).map((item) => (
            <a
              href={item.href}
              class="header-link"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <nav class="header-actions" aria-label={content.footer.switchLabel}>
        <a
          href={switchHref}
          hreflang={switchLang}
          lang={switchLang}
          class="header-link"
          aria-label={content.switchAria}
        >
          {switchLabel}
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Glass background/blur come from the shared .glass-surface utility
     (global.css, DEBT-0012): solid canvas fallback, near-opaque glass upgrade. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.625rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
    box-sizing: border-box;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    min-height: 2.75rem;
    min-width: 0;
  }

  .brand-logo {
    width: 2.25rem;
    height: auto;
    display: block;
    flex: none;
  }

  .header-nav-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
    min-width: 0;
    max-width: 100%;
  }

  .header-nav,
  .header-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.15rem;
    min-width: 0;
    max-width: 100%;
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    text-decoration: none;
    color: var(--color-ink-secondary);
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .header-link:hover,
  .header-link:focus-visible {
    color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }

  .header-link[aria-current="page"] {
    color: var(--color-ink);
    position: relative;
  }

  .header-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0.45rem;
    inset-block-end: 0.35rem;
    height: 2px;
    border-radius: 999px;
    background-color: var(--color-brand);
  }

  /* E9/P13: no-JS "More" disclosure — <details> keeps keyboard + touch working
     without JavaScript; panel styled as a compact dropdown. */
  .nav-more {
    position: relative;
    display: inline-flex;
  }

  .nav-more-summary {
    list-style: none;
    cursor: pointer;
    gap: 0.3rem;
  }

  .nav-more-summary::-webkit-details-marker {
    display: none;
  }

  .nav-more-caret {
    transition: transform var(--duration-fast, 140ms) var(--ease-out, ease-out);
  }

  .nav-more[open] .nav-more-caret {
    transform: rotate(180deg);
  }

  .nav-more-panel {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + 0.25rem);
    z-index: 40;
    display: grid;
    min-width: 11rem;
    max-width: calc(100vw - 1rem);
    padding: 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .nav-more:not([open]) .nav-more-panel {
    display: none;
  }

  /* Flip panel to viewport end at tablet/mobile to prevent overflow (CI mobile-overflow 390/768). */
  @media (max-width: 48rem) {
    .nav-more-panel {
      inset-inline-start: auto;
      inset-inline-end: 0;
    }
  }

  .nav-more-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    color: var(--color-ink-secondary);
    font-weight: 600;
    white-space: nowrap;
  }

  .nav-more-link:hover,
  .nav-more-link:focus-visible {
    color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }

  .nav-more-link[aria-current="page"] {
    color: var(--color-ink);
    background-color: var(--color-brand-soft);
  }

  /* About + Writing + CV + language switch: wrap inside the viewport instead
     of expanding document scrollWidth (mobile-overflow QA). */
  @media (max-width: 40rem) {
    .site-header-inner {
      flex-wrap: wrap;
      gap: 0.35rem;
      padding-inline: 0.75rem;
    }

    .brand {
      flex: 1 1 auto;
      gap: 0.5rem;
    }

    .brand-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.9rem;
    }

    .header-nav-group {
      flex: 1 1 12rem;
    }

    .header-link {
      padding-inline: 0.45rem;
      font-size: 0.8125rem;
    }
  }

  /* Zoom-approximation 160/195 CSS px: logo row + 2×2 link grid so every
     `.site-header a` stays within the short viewport after scroll.
     NAMED EXCEPTION (DEFER-0035, documented in DESIGN-CONTRACT.md §3):
     below 224px CSS width, header links are allowed at 36px min-height
     (2.25rem) instead of the 44px floor. */
  @media (max-width: 14rem) {
    .site-header-inner {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: stretch;
      gap: 0.25rem;
      padding: 0.5rem;
    }

    .brand {
      grid-column: 1 / -1;
      justify-content: center;
      min-height: 2.25rem;
    }

    .brand-name {
      display: none;
    }

    .header-nav-group,
    .header-nav,
    .header-actions {
      display: contents;
    }

    .header-link {
      justify-content: center;
      width: 100%;
      min-height: 2.25rem;
      padding-inline: 0.25rem;
      font-size: 0.75rem;
      overflow-wrap: anywhere;
    }
  }
</style>
