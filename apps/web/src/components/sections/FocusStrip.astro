---
import type { LocaleContent } from "../../data/content";
import type { Profile } from "../../data/profile";

interface Props {
  content: LocaleContent;
  profile: Profile;
}

const { content, profile } = Astro.props;
---

{
  profile.availability && (
    <aside class="focus-strip" aria-labelledby="focus-heading">
      <div class="strip card">
        <span class="dot" aria-hidden="true" />
        <div class="copy">
          <h2 id="focus-heading" class="kicker label">
            {content.hero.focusLabel}
          </h2>
          <p class="text">{profile.availability}</p>
        </div>
      </div>
    </aside>
  )
}

<style>
  .focus-strip {
    max-width: var(--measure-wide, 72rem);
    margin-inline: auto;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    min-width: 0;
  }

  /* Narrow glass bar (reDesign_plan §۴.۳) on the shared .card surface. */
  .strip {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4, 1rem);
    padding: var(--space-4, 1rem) var(--space-6, 2rem);
    min-width: 0;
  }

  .dot {
    flex: none;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 999px;
    background-color: var(--gold, #e3b95c);
    margin-block-start: 0.4375rem;
  }

  .copy {
    min-width: 0;
  }

  .label {
    margin: 0 0 var(--space-1, 0.25rem);
  }

  .text {
    color: var(--ink-hi, #f2f6fa);
    font-weight: 600;
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
