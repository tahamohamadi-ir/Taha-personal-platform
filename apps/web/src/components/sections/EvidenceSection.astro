---
import type { LocaleContent } from "../../data/content";
import type { Profile } from "../../data/profile";

interface Props {
  content: LocaleContent;
  profile: Profile;
}

const { content, profile } = Astro.props;
const home = `/${content.lang}/`;
const selectedResearch = profile.researchProjects.slice(0, 2);
const selectedPublications = profile.publications.slice(0, 2);
---

{
  (selectedResearch.length > 0 || selectedPublications.length > 0) && (
    <section class="evidence" aria-labelledby="evidence-heading">
      <div class="head">
        <p class="kicker">{content.evidence.label}</p>
        <h2 id="evidence-heading" class="heading">
          {content.evidence.heading}
        </h2>
      </div>
      <ul class="rows" role="list">
        {selectedResearch.map((project) => (
          <li class="list-row row row--link">
            <span class="kind">{content.research.projectsHeading}</span>
            <a class="row-link" href={`${home}research/`}>
              {project.title}
            </a>
          </li>
        ))}
        {selectedPublications.map((publication) => (
          <li class="list-row row">
            <span class="kind">{content.research.publicationsHeading}</span>
            <span class="title">{publication.title}</span>
            <span class="status">{publication.status}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .evidence {
    max-width: var(--measure-wide, 72rem);
    margin-inline: auto;
    padding-block: var(--space-8, 4rem);
    padding-inline: clamp(1rem, 5vw, 2.5rem);
  }

  .head {
    margin-block-end: var(--space-6, 2rem);
    min-width: 0;
  }

  .kicker {
    color: var(--brand-text, #3dd6c5);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-2, 0.5rem);
  }

  :global([dir="rtl"]) .kicker {
    letter-spacing: 0;
  }

  .heading {
    font-size: clamp(1.75rem, 1.5rem + 1.5vw, 2.5rem);
    line-height: 1.15;
    margin: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  /* Shared .list-row supplies the flex column + hairline; rows sit on the
     readable surface so body text never rests on low-fill glass
     (reDesign_plan §۱.۴). */
  .row {
    background-color: var(--surface-read, #101f3c);
    border: 1px solid var(--glass-edge, rgba(255, 255, 255, 0.16));
    border-radius: var(--radius-md, 12px);
    padding: var(--space-4, 1rem) var(--space-6, 2rem);
    margin-block-end: var(--space-3, 0.75rem);
    transition: border-color var(--duration-night-fast, 160ms) ease-out,
      transform var(--duration-night-fast, 160ms)
        var(--ease-night, cubic-bezier(0.22, 1, 0.36, 1));
  }

  @media (prefers-reduced-motion: reduce) {
    .row {
      transition: none;
    }
  }

  .row--link:hover {
    border-color: var(--brand-text, #3dd6c5);
    transform: translateY(-0.125rem);
  }

  .kind {
    color: var(--ink-low, #6e8095);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global([dir="rtl"]) .kind {
    letter-spacing: 0;
    text-transform: none;
  }

  .row-link,
  .title {
    color: var(--ink-hi, #f2f6fa);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .row-link {
    text-decoration: none;
  }

  .row-link:hover,
  .row-link:focus-visible {
    color: var(--brand-text, #3dd6c5);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .status {
    color: var(--ink-mid, #a8b8c8);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
</style>
