---
import type { LocaleContent } from "../../data/content";

interface Props {
  content: LocaleContent;
}

const { content } = Astro.props;
const home = `/${content.lang}/`;
---

<section class="contact-cta" aria-labelledby="contact-cta-heading">
  <div class="card panel">
    <p class="kicker tagline">{content.footer.tagline}</p>
    <h2 id="contact-cta-heading" class="heading">
      {content.contact.heading}
    </h2>
    <div class="signature" aria-hidden="true" />
    <p class="invite">{content.contact.formIntro}</p>
    <a class="btn btn--primary cta" href={`${home}contact/`}>
      {content.contact.sendLabel}
    </a>
  </div>
</section>

<style>
  .contact-cta {
    max-width: var(--measure-wide, 72rem);
    margin-inline: auto;
    padding-block: var(--space-8, 4rem) var(--space-16, 4rem);
    padding-inline: clamp(1rem, 5vw, 2.5rem);
  }

  /* Wide glass panel — the landing's closing beat (reDesign_plan §۴.۷). */
  .panel {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-4, 1rem);
    padding: clamp(2rem, 7vw, 3.5rem) clamp(1.25rem, 6vw, 2.5rem);
    min-width: 0;
  }

  .tagline {
    margin: 0;
  }

  .heading {
    font-size: clamp(1.75rem, 1.5rem + 1.5vw, 2.5rem);
    line-height: 1.15;
    margin: 0;
    color: var(--ink-hi, #f2f6fa);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  /* Gold signature line — the hero mark echoed at the close. */
  .signature {
    inline-size: 8rem;
    block-size: 2px;
    background-color: var(--gold, #e3b95c);
    border-radius: 999px;
  }

  .invite {
    color: var(--ink-mid, #a8b8c8);
    max-inline-size: 52ch;
    margin: 0;
    overflow-wrap: anywhere;
  }

  :lang(fa) .invite {
    line-height: 1.95;
  }

  .cta {
    min-height: 3rem;
    font-size: 1.125rem;
    padding-inline: var(--space-8, 2rem);
  }
</style>
