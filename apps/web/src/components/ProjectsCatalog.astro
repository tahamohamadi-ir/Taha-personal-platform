---
import type { LocaleContent } from "../data/content";
import type { LocaleCode } from "../data/site";
import type { ProjectListDto } from "../lib/cms/projects";

export interface Props {
  locale: LocaleCode;
  content: LocaleContent;
  projects: ProjectListDto[];
}

const { locale, content, projects } = Astro.props;
const copy = content.projects;

function excerptFrom(text: string, max = 180): string {
  const clean = text.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
  if (clean.length <= max) return clean;
  return `${clean.slice(0, max).trimEnd()}…`;
}

function dateLabel(iso: string | null): string {
  if (!iso) return "";
  return iso.slice(0, 10);
}

const types = Array.from(new Set(projects.map((project) => project.project_type))).sort();
---

{
  projects.length === 0 ? (
    <p class="empty">{copy.empty}</p>
  ) : (
    <div class="project-catalog" data-project-catalog>
      <div class="project-toolbar">
        <label class="project-control">
          <span>{copy.filterLabel}</span>
          <select data-project-filter>
            <option value="all">{copy.filterAll}</option>
            {types.map((type) => (
              <option value={type}>{type}</option>
            ))}
          </select>
        </label>
        <label class="project-control">
          <span>{copy.sortLabel}</span>
          <select data-project-sort>
            <option value="title">{copy.sortTitle}</option>
            <option value="newest">{copy.sortNewest}</option>
          </select>
        </label>
      </div>
      <ul class="project-list" data-project-list>
        {
          projects.map((project) => (
            <li
              class="project-item"
              data-type={project.project_type}
              data-title={project.title}
              data-published={project.published_at ?? ""}
            >
              <a class="project-card" href={`/${locale}/projects/${project.slug}/`}>
                <div class="project-copy">
                  <p class="project-kind">{project.project_type}</p>
                  <p class="project-title">{project.title}</p>
                  {project.objective ? (
                    <p class="project-note">{excerptFrom(project.objective)}</p>
                  ) : null}
                  {project.published_at ? (
                    <p class="project-meta">{dateLabel(project.published_at)}</p>
                  ) : null}
                </div>
                <span class="project-cta">{copy.viewLabel}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  )
}

<script>
  function bindCatalog(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>("[data-project-list]");
    const filter = root.querySelector<HTMLSelectElement>("[data-project-filter]");
    const sort = root.querySelector<HTMLSelectElement>("[data-project-sort]");
    if (!list || !filter || !sort) return;

    const items = Array.from(list.querySelectorAll<HTMLElement>(":scope > li"));

    const apply = () => {
      const type = filter.value;
      const mode = sort.value;
      const visible = items.filter((item) => {
        const match = type === "all" || item.dataset.type === type;
        item.hidden = !match;
        return match;
      });

      visible.sort((a, b) => {
        if (mode === "newest") {
          return (b.dataset.published ?? "").localeCompare(a.dataset.published ?? "");
        }
        return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", undefined, {
          sensitivity: "base",
        });
      });

      for (const item of visible) {
        list.appendChild(item);
      }
    };

    filter.addEventListener("change", apply);
    sort.addEventListener("change", apply);
  }

  document.querySelectorAll<HTMLElement>("[data-project-catalog]").forEach(bindCatalog);
</script>

<style>
  .empty {
    color: var(--color-ink-muted);
  }

  .project-catalog {
    margin-top: 1.5rem;
  }

  .project-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .project-control {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink-secondary);
  }

  .project-control select {
    min-height: 2.75rem;
    min-width: 10rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }

  .project-control select:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .project-item[hidden] {
    display: none;
  }

  .project-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1.5rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    border-color: var(--color-brand);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .project-copy {
    min-width: 0;
    flex: 1 1 16rem;
  }

  .project-kind {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .project-title {
    margin: 0.35rem 0 0;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .project-note {
    margin: 0.375rem 0 0;
    color: var(--color-ink-secondary);
    max-width: 62ch;
  }

  .project-meta {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-ink-tertiary);
  }

  .project-cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-navy-950);
    color: var(--color-inverse);
    font-weight: 600;
    flex: none;
  }

  .project-card:hover .project-cta {
    background-color: var(--color-brand);
    color: var(--color-navy-950);
  }
</style>
