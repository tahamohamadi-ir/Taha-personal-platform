---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  items: Crumb[];
  /** Localized nav landmark name; callers pass it per locale (IA-CONTRACT
      S7). Default keeps the current landmark for pages not yet migrated. */
  label?: string;
}

const { items, label = "Breadcrumb" } = Astro.props;
---

<nav class="breadcrumbs" aria-label={label}>
  <ol class="breadcrumbs-list">
    {
      items.map((item, index) => (
        <li class="breadcrumbs-item">
          {item.href && index < items.length - 1 ? (
            <a class="breadcrumbs-link" href={item.href}>
              {item.label}
            </a>
          ) : (
            <span class="breadcrumbs-current" aria-current={index === items.length - 1 ? "page" : undefined}>
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-block-end: var(--space-6);
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
  }

  .breadcrumbs-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumbs-item:not(:last-child)::after {
    content: "/";
    color: var(--color-ink-tertiary);
  }

  .breadcrumbs-link {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumbs-link:hover,
  .breadcrumbs-link:focus-visible {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumbs-current {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
