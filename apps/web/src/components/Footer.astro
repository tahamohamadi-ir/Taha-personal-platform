---
import type { LocaleContent } from "../data/content";
import { content as allContent } from "../data/content";
import { getSiteBrand, getSiteContact, getSiteTagline, type PublicSiteContactDto } from "../lib/cms/siteSettings";
import { isCmsOriginBuild } from "../lib/cms/client";
import logo from "../branding/logo.png";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
}

const { content } = Astro.props;
const otherLang = content.lang === "fa" ? "en" : "fa";
const other = allContent[otherLang];
const switchHref = Astro.props.alternateHref ?? `/${otherLang}/`;
const switchLabel =
  content.lang === "fa"
    ? other.gateway.englishLabel
    : other.gateway.persianLabel;
const switchLang = otherLang;
const contact: PublicSiteContactDto | null = await getSiteContact();
const hasContactDetails = Boolean(
  contact &&
    (contact.email !== "" ||
      contact.linkedin !== "" ||
      contact.orcid !== "" ||
      contact.location !== "" ||
      contact.employer !== ""),
);
const cmsBrand = await getSiteBrand();
const cmsTagline = await getSiteTagline();
const isCms = isCmsOriginBuild();
const displayName = cmsBrand ?? (isCms ? "" : content.name);
const displayTagline = cmsTagline ?? (isCms ? "" : content.footer.tagline);
/* Explore = the full live sitemap (IA-CONTRACT S4): locale home, section
   roots, P8 catalogs, creative + teaching, CV, contact, search. Every href
   below has a real page for both locales; nothing inactive is listed. */
const exploreItems = [
  { href: `/${content.lang}/`, label: content.footer.homeLabel },
  { href: `/${content.lang}/about/`, label: content.about.heading },
  { href: `/${content.lang}/research/`, label: content.research.heading },
  { href: `/${content.lang}/projects/`, label: content.projects.heading },
  { href: `/${content.lang}/writing/`, label: content.blog.heading },
  { href: `/${content.lang}/publications/`, label: content.catalog.publicationsHeading },
  { href: `/${content.lang}/books/`, label: content.catalog.booksHeading },
  { href: `/${content.lang}/talks/`, label: content.catalog.talksHeading },
  { href: `/${content.lang}/downloads/`, label: content.catalog.downloadsHeading },
  { href: `/${content.lang}/creative/`, label: content.creative.heading },
  { href: `/${content.lang}/teaching/`, label: content.teaching.heading },
  { href: `/${content.lang}/cv/`, label: content.downloads.heading },
  { href: `/${content.lang}/contact/`, label: content.contact.heading },
  { href: `/${content.lang}/search/`, label: content.search.navLabel },
];
---

<footer class="site-footer">
  <div class="footer-brand">
    <img
      class="footer-mark"
      src={logo.src}
      alt=""
      width={logo.width}
      height={logo.height}
      loading="lazy"
    />
    <div class="footer-brand-copy">
      {displayName !== "" && <p class="footer-name">{displayName}</p>}
      {displayTagline !== "" && <p class="footer-tagline">{displayTagline}</p>}
    </div>
  </div>
  <nav class="footer-explore" aria-label={content.footer.exploreLabel}>
    {
      exploreItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
  </nav>
  <div class="footer-meta">
    <a
      href={switchHref}
      hreflang={switchLang}
      lang={switchLang}
      class="footer-switch"
      aria-label={content.switchAria}
    >
      {switchLabel}
    </a>
    {
      hasContactDetails && contact ? (
        <div class="site-contact" id="site-contact">
          <ul class="contact-links">
            {contact.email !== "" && (
              <li>
                <a href={`mailto:${contact.email}`}>
                  <bdi>{contact.email}</bdi>
                </a>
              </li>
            )}
            {contact.linkedin !== "" && (
              <li>
                <a href={contact.linkedin} rel="me noopener noreferrer">
                  LinkedIn
                </a>
              </li>
            )}
            {contact.orcid !== "" && (
              <li>
                <a href={contact.orcid} rel="me noopener noreferrer">
                  ORCID
                </a>
              </li>
            )}
            {contact.employer !== "" && (
              <li>
                {contact.employerUrl !== "" ? (
                  <a href={contact.employerUrl} rel="noopener noreferrer">
                    {contact.employer}
                  </a>
                ) : (
                  <span>{contact.employer}</span>
                )}
              </li>
            )}
            {contact.location !== "" && <li><span>{contact.location}</span></li>}
          </ul>
        </div>
      ) : (
        <span class="contact-state" aria-label={content.contact.heading}>
          {content.contact.unavailable}
        </span>
      )
    }
  </div>
  <p class="footer-identity">
    {content.footer.copyrightMark} <bdi>{new Date().getFullYear()}</bdi>{" "}
    {displayName !== "" ? displayName : content.name}
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2.5rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: var(--measure-page);
    margin-inline: auto;
    width: 100%;
    background-color: var(--canvas-deep);
    border-block-start: 1px solid var(--glass-border-dark);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
  }

  .footer-mark {
    display: block;
    width: 2.25rem;
    height: auto;
    flex-shrink: 0;
  }

  .footer-brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .footer-name {
    color: var(--ink-hi);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .footer-tagline {
    color: var(--ink-mid);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .footer-explore {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .footer-explore a {
    color: var(--ink-mid);
    text-decoration: none;
    font-weight: 600;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .footer-explore a:hover,
  .footer-explore a:focus-visible {
    color: var(--brand-text);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-switch {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    color: var(--brand-text);
    text-decoration: none;
    font-weight: 600;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-md);
    transition: border-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .footer-switch:hover,
  .footer-switch:focus-visible {
    border-color: var(--brand-text);
    background-color: var(--glass-fill);
  }

  .contact-state {
    color: var(--ink-mid);
    font-size: 0.875rem;
  }

  .site-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: min(100%, 22rem);
    flex: 1 1 16rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }

  .contact-links a {
    color: var(--ink-mid);
    text-decoration: none;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .contact-links a:hover,
  .contact-links a:focus-visible {
    color: var(--brand-text);
  }

  .footer-identity {
    color: var(--ink-mid);
    font-size: 0.8125rem;
  }
</style>
