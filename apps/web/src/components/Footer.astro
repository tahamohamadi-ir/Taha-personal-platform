---
import type { LocaleContent } from "../data/content";
import { content as allContent } from "../data/content";
import { getSiteBrand, getSiteContact, getSiteTagline, type PublicSiteContactDto } from "../lib/cms/siteSettings";
import { isCmsOriginBuild } from "../lib/cms/client";
import logo from "../branding/logo.png";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
}

const { content } = Astro.props;
const otherLang = content.lang === "fa" ? "en" : "fa";
const other = allContent[otherLang];
const switchHref = Astro.props.alternateHref ?? `/${otherLang}/`;
const switchLabel =
  content.lang === "fa"
    ? other.gateway.englishLabel
    : other.gateway.persianLabel;
const switchLang = otherLang;
const contact: PublicSiteContactDto | null = await getSiteContact();
const hasContactDetails = Boolean(
  contact &&
    (contact.email !== "" ||
      contact.linkedin !== "" ||
      contact.orcid !== "" ||
      contact.location !== "" ||
      contact.employer !== ""),
);
const cmsBrand = await getSiteBrand();
const cmsTagline = await getSiteTagline();
const isCms = isCmsOriginBuild();
const displayName = cmsBrand ?? (isCms ? "" : content.name);
const displayTagline = cmsTagline ?? (isCms ? "" : content.footer.tagline);
---

<footer class="site-footer">
  <div class="footer-brand">
    <img
      class="footer-mark"
      src={logo.src}
      alt=""
      width={logo.width}
      height={logo.height}
      loading="lazy"
    />
    <div class="footer-brand-copy">
      {displayName !== "" && <p class="footer-name">{displayName}</p>}
      {displayTagline !== "" && <p class="footer-tagline">{displayTagline}</p>}
    </div>
  </div>
  <nav class="footer-explore" aria-label={content.footer.exploreLabel}>
    <a href={`/${content.lang}/`}>{content.footer.homeLabel}</a>
    <a href={`/${content.lang}/about/`}>{content.about.heading}</a>
    <a href={`/${content.lang}/research/`}>{content.research.heading}</a>
    <a href={`/${content.lang}/projects/`}>{content.projects.heading}</a>
    <a href={`/${content.lang}/writing/`}>{content.blog.heading}</a>
    <a href={`/${content.lang}/cv/`}>{content.downloads.heading}</a>
    <a href={`/${content.lang}/contact/`}>{content.contact.heading}</a>
    <a href={`/${content.lang}/search/`}>{content.search.navLabel}</a>
  </nav>
  <div class="footer-meta">
    <a
      href={switchHref}
      hreflang={switchLang}
      lang={switchLang}
      class="footer-switch"
      aria-label={content.switchAria}
    >
      {switchLabel}
    </a>
    {
      hasContactDetails && contact ? (
        <div class="site-contact" id="site-contact">
          <ul class="contact-links">
            {contact.email !== "" && (
              <li>
                <a href={`mailto:${contact.email}`}>
                  <bdi>{contact.email}</bdi>
                </a>
              </li>
            )}
            {contact.linkedin !== "" && (
              <li>
                <a href={contact.linkedin} rel="me noopener noreferrer">
                  LinkedIn
                </a>
              </li>
            )}
            {contact.orcid !== "" && (
              <li>
                <a href={contact.orcid} rel="me noopener noreferrer">
                  ORCID
                </a>
              </li>
            )}
            {contact.employer !== "" && (
              <li>
                {contact.employerUrl !== "" ? (
                  <a href={contact.employerUrl} rel="noopener noreferrer">
                    {contact.employer}
                  </a>
                ) : (
                  <span>{contact.employer}</span>
                )}
              </li>
            )}
            {contact.location !== "" && <li><span>{contact.location}</span></li>}
          </ul>
        </div>
      ) : (
        <span class="contact-state" aria-label={content.contact.heading}>
          {content.contact.unavailable}
        </span>
      )
    }
  </div>
  <p class="footer-identity">
    {content.footer.copyrightMark} <bdi>{new Date().getFullYear()}</bdi>{" "}
    {displayName !== "" ? displayName : content.name}
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2.5rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
    background-color: var(--canvas-deep, #0b1630);
    border-block-start: 1px solid var(--glass-border-dark);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
  }

  .footer-mark {
    display: block;
    width: 2.25rem;
    height: auto;
    flex-shrink: 0;
  }

  .footer-brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .footer-name {
    color: var(--ink-hi, #f2f6fa);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .footer-tagline {
    color: var(--ink-mid, #a8b8c8);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .footer-explore {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .footer-explore a {
    color: var(--ink-mid, #a8b8c8);
    text-decoration: none;
    font-weight: 600;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .footer-explore a:hover,
  .footer-explore a:focus-visible {
    color: var(--brand-text, #3dd6c5);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-switch {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    color: var(--brand-text, #3dd6c5);
    text-decoration: none;
    font-weight: 600;
    border: 1px solid var(--glass-edge, rgba(255,255,255,.16));
    border-radius: var(--radius-md);
    transition: border-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .footer-switch:hover,
  .footer-switch:focus-visible {
    border-color: var(--brand-text, #3dd6c5);
    background-color: var(--glass-fill, rgba(255,255,255,.08));
  }

  .contact-state {
    color: var(--ink-mid, #a8b8c8);
    font-size: 0.875rem;
  }

  .site-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    min-width: min(100%, 22rem);
    flex: 1 1 16rem;
  }

  .contact-heading {
    font-weight: 600;
    color: var(--ink-hi, #f2f6fa);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }

  .contact-links a {
    color: var(--ink-mid, #a8b8c8);
    text-decoration: none;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .contact-links a:hover,
  .contact-links a:focus-visible {
    color: var(--brand-text, #3dd6c5);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    max-width: 26rem;
  }

  .contact-form-intro {
    margin: 0;
    color: var(--ink-mid, #a8b8c8);
    font-size: 0.8125rem;
  }

  .contact-form input:not(.contact-honeypot),
  .contact-form textarea {
    font: inherit;
    color: var(--ink-hi, #f2f6fa);
    background: var(--surface-read, #101f3c);
    border: 1px solid var(--glass-edge, rgba(255,255,255,.16));
    border-radius: var(--radius-sm, 8px);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form button {
    align-self: flex-start;
    min-height: 2.75rem;
    padding-inline: var(--space-4, 1rem);
    font: inherit;
    font-weight: 600;
    color: var(--color-inverse);
    background: var(--brand-text, #3dd6c5);
    border: 1px solid var(--brand-text, #3dd6c5);
    border-radius: var(--radius-sm, 8px);
    cursor: pointer;
    transition: background-color var(--duration-fast, 140ms) var(--ease-out, ease-out);
  }

  .contact-form button:hover,
  .contact-form button:focus-visible {
    background: var(--color-brand-emphasis-hover);
  }

  .contact-honeypot {
    position: absolute;
    inset-inline-start: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .footer-identity {
    color: var(--ink-mid, #a8b8c8);
    font-size: 0.8125rem;
  }
</style>
