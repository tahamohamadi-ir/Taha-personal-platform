---
import type { LocaleContent } from "../data/content";
import { content as allContent } from "../data/content";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
}

const { content } = Astro.props;
const otherLang = content.lang === "fa" ? "en" : "fa";
const other = allContent[otherLang];
const mark = content.mark;
const switchHref = `/${otherLang}/`;
const switchLabel =
  content.lang === "fa"
    ? other.gateway.englishLabel
    : other.gateway.persianLabel;
const switchLang = otherLang;
---

<footer class="site-footer">
  <div class="footer-brand">
    <span class="footer-mark" aria-hidden="true">{mark}</span>
    <div class="footer-brand-copy">
      <p class="footer-name">{content.name}</p>
      <p class="footer-tagline">{content.footer.tagline}</p>
    </div>
  </div>
  <div class="footer-meta">
    <a
      href={switchHref}
      hreflang={switchLang}
      lang={switchLang}
      class="footer-switch"
    >
      {switchLabel}
    </a>
    <span class="contact-state" aria-label={content.contact.heading}>
      {content.contact.unavailable}
    </span>
  </div>
  <p class="footer-identity">
    {content.footer.copyrightMark} <bdi>{new Date().getFullYear()}</bdi>{" "}
    {content.name}
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2.5rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
    border-block-start: 1px solid var(--color-border-subtle);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .footer-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    background-color: var(--color-navy-950);
    color: var(--color-turquoise-500);
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .footer-brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .footer-name {
    color: var(--color-ink);
    font-weight: 600;
  }

  .footer-tagline {
    color: var(--color-ink-secondary);
    font-size: 0.875rem;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-switch {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    color: var(--color-brand);
    text-decoration: none;
    font-weight: 600;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    transition: border-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .footer-switch:hover {
    border-color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }

  .contact-state {
    color: var(--color-ink-secondary);
    font-size: 0.875rem;
  }

  .footer-identity {
    color: var(--color-ink-secondary);
    font-size: 0.8125rem;
  }
</style>
