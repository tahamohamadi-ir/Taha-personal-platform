---
import type { ArticleListDto } from "../../lib/cms/articles";

interface Props {
  locale: "fa" | "en";
  prev: ArticleListDto | null;
  next: ArticleListDto | null;
  prevLabel: string;
  nextLabel: string;
  seriesLabel: string;
}

const { locale, prev, next, prevLabel, nextLabel, seriesLabel } = Astro.props;
---

{
  (prev || next) && (
    <nav class="series-nav" aria-label={seriesLabel}>
      {prev && (
        <a class="series-nav-prev" href={`/${locale}/writing/${prev.slug}/`}>
          <span>{prevLabel}</span>
          <strong>{prev.title}</strong>
        </a>
      )}
      {next && (
        <a class="series-nav-next" href={`/${locale}/writing/${next.slug}/`}>
          <span>{nextLabel}</span>
          <strong>{next.title}</strong>
        </a>
      )}
    </nav>
  )
}

<style>
  .series-nav {
    display: grid;
    gap: 1rem;
    margin-block: 2rem 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 640px) {
    .series-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  .series-nav a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .series-nav a:hover strong,
  .series-nav a:focus-visible strong {
    text-decoration: underline;
  }

  .series-nav span {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }

  .series-nav-next {
    text-align: end;
  }
</style>
