---
import type { ArticleListDto } from "../../lib/cms/articles";
import TagList from "./TagList.astro";

interface Props {
  locale: "fa" | "en";
  article: ArticleListDto;
  readingLabel: string;
}

const { locale, article, readingLabel } = Astro.props;
const dateLabel = article.published_at
  ? new Date(article.published_at).toLocaleDateString(locale === "fa" ? "fa-IR" : "en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : null;
---

<article class="article-card">
  <h2 class="article-card-title">
    <a href={`/${locale}/blog/${article.slug}/`}>{article.title}</a>
  </h2>
  {
    article.excerpt && (
      <p class="article-card-excerpt">{article.excerpt}</p>
    )
  }
  <p class="article-card-meta">
    {
      dateLabel && (
        <time datetime={article.published_at ?? undefined}>{dateLabel}</time>
      )
    }
    {
      article.reading_time_minutes > 0 && (
        <span>
          {article.reading_time_minutes} {readingLabel}
        </span>
      )
    }
  </p>
  <TagList locale={locale} tags={article.topic_tags} />
</article>

<style>
  .article-card {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .article-card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 0 0 0.35rem;
  }

  .article-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .article-card-title a:hover,
  .article-card-title a:focus-visible {
    text-decoration: underline;
  }

  .article-card-excerpt {
    margin: 0 0 0.5rem;
    color: var(--color-ink-muted);
  }

  .article-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }
</style>
