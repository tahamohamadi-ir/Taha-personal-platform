---
import type { ArticleDetailDto } from "../../lib/cms/articles";
import TagList from "./TagList.astro";

interface Props {
  locale: "fa" | "en";
  article: ArticleDetailDto;
  readingLabel: string;
  licenseLabel: string;
}

const { locale, article, readingLabel, licenseLabel } = Astro.props;
const dateLabel = article.published_at
  ? new Date(article.published_at).toLocaleDateString(locale === "fa" ? "fa-IR" : "en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<article class="article-detail">
  <header class="article-detail-header">
    <h1>{article.title}</h1>
    <p class="article-detail-meta">
      {
        dateLabel && (
          <time datetime={article.published_at ?? undefined}>{dateLabel}</time>
        )
      }
      {
        article.reading_time_minutes > 0 && (
          <span>
            {article.reading_time_minutes} {readingLabel}
          </span>
        )
      }
      <span>
        {licenseLabel}: {article.license}
      </span>
    </p>
    <TagList locale={locale} tags={article.topic_tags} />
  </header>
  <div class="article-detail-body" set:html={article.body} />
  {
    article.accessibility_notes && (
      <aside class="article-a11y">
        <p>{article.accessibility_notes}</p>
      </aside>
    )
  }
</article>

<style>
  .article-detail-header {
    margin-bottom: 1.5rem;
  }

  .article-detail-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin: 0 0 0.75rem;
  }

  .article-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 0 0 1rem;
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }

  .article-detail-body :global(h2),
  .article-detail-body :global(h3),
  .article-detail-body :global(h4) {
    font-family: var(--font-display);
    margin-top: 1.5rem;
  }

  .article-detail-body :global(p),
  .article-detail-body :global(li) {
    line-height: 1.7;
  }

  .article-detail-body :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-border-subtle);
    color: var(--color-ink-muted);
  }

  .article-a11y {
    margin-top: 2rem;
    padding: 1rem;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }
</style>
