---
import type { LocaleContent } from "../data/content";
import type { Profile } from "../data/profile";

interface Props {
  content: LocaleContent;
  profile: Profile;
}

const { content, profile } = Astro.props;
const sections = content.sections;
---

<section class="about">
  <div class="about-head">
    <span class="about-label">{content.about.label}</span>
    <h1 class="about-title">{content.name}</h1>
    <p class="about-positioning">{content.positioning}</p>
    <div class="rule" aria-hidden="true"><span></span></div>
  </div>

  <p class="about-bio">{profile.shortBio}</p>

  {
    profile.longBio && <p class="about-bio-long">{profile.longBio}</p>
  }

  {
    profile.experience.length > 0 && (
      <section class="about-section">
        {sections?.experience && <h2 class="section-title">{sections.experience}</h2>}
        <div class="entries">
          {
            profile.experience.map((entry) => (
              <article class="entry">
                <h3 class="entry-title">
                  {entry.role}
                  {entry.website && (
                    <a class="entry-link" href={entry.website} rel="noopener" target="_blank">
                      {entry.organization}
                    </a>
                  )}
                  {!entry.website && <span class="entry-org">{entry.organization}</span>}
                </h3>
                <p class="entry-meta">
                  {entry.period}
                  {entry.location && <span aria-hidden="true"> · </span>}
                  {entry.location}
                </p>
                <ul class="entry-bullets">
                  {entry.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>
    )
  }

  {
    profile.education.length > 0 && (
      <section class="about-section">
        {sections?.education && <h2 class="section-title">{sections.education}</h2>}
        <div class="entries">
          {
            profile.education.map((entry) => (
              <article class="entry">
                <h3 class="entry-title">{entry.degree} — {entry.field}</h3>
                <p class="entry-meta">
                  {entry.institution}
                  <span aria-hidden="true"> · </span>
                  {entry.period}
                  {entry.gpa && <span> · GPA {entry.gpa}</span>}
                </p>
                {entry.thesis && <p class="entry-thesis">{entry.thesis}</p>}
              </article>
            ))
          }
        </div>
      </section>
    )
  }

  {
    profile.skills.length > 0 && (
      <section class="about-section">
        {sections?.skills && <h2 class="section-title">{sections.skills}</h2>}
        <ul class="skills">
          {
            profile.skills.map((skill) => (
              <li class="skill">
                <h3 class="skill-name">{skill.name}</h3>
                <p class="skill-meta">
                  <span class="skill-category">{skill.category}</span>
                  <span class="skill-separator" aria-hidden="true">·</span>
                  <span class="skill-source">{skill.source}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

  {
    profile.researchProjects.length > 0 && (
      <section class="about-section">
        {sections?.research && <h2 class="section-title">{sections.research}</h2>}
        <div class="entries">
          {
            profile.researchProjects.map((project) => (
              <article class="entry">
                <h3 class="entry-title">{project.title}</h3>
                <p class="entry-text">{project.summary}</p>
              </article>
            ))
          }
        </div>
      </section>
    )
  }

  {
    profile.publications.length > 0 && (
      <section class="about-section">
        {sections?.publications && <h2 class="section-title">{sections.publications}</h2>}
        <ul class="plain-list">
          {
            profile.publications.map((pub) => (
              <li class="plain-item">
                <p class="pub-title">{pub.title}</p>
                <p class="pub-status">{pub.status}</p>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

  {
    profile.certificates.length > 0 && (
      <section class="about-section">
        {sections?.certificates && <h2 class="section-title">{sections.certificates}</h2>}
        <ul class="plain-list">
          {
            profile.certificates.map((cert) => (
              <li class="plain-item">
                <p class="cert-name">{cert.name}</p>
                {cert.detail && <p class="cert-detail">{cert.detail}</p>}
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

  {
    profile.socials.length > 0 && (
      <div class="socials">
        {profile.socials.map((s) => (
          <a class="social-link" href={s.url} rel="me noopener" target="_blank">
            {s.platform}
          </a>
        ))}
      </div>
    )
  }

  <aside class="availability">
    <p class="availability-text">{profile.availability}</p>
  </aside>

  <div class="contact-state">
    <span class="contact-state-label">{content.contact.heading}</span>
    <p class="contact-state-text">{content.contact.unavailable}</p>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(3rem, 8vw, 6rem);
    padding-inline: clamp(1rem, 5vw, 2.5rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }

  .about-head {
    margin-block-end: 2.5rem;
  }

  .about-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand);
    margin-block-end: 0.5rem;
  }

  :global(html[dir="rtl"]) .about-label {
    font-family: var(--font-persian);
    letter-spacing: 0.02em;
  }

  .about-title {
    font-size: clamp(2.6rem, 1.9rem + 3.6vw, 4.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin-block-end: 1rem;
    text-wrap: balance;
  }

  :global(html[dir="rtl"]) .about-title {
    letter-spacing: 0;
  }

  .about-positioning {
    color: var(--color-ink);
    font-weight: 600;
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.5rem);
    margin-block-end: 1rem;
  }

  .about-positioning::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 3px;
    margin-block-start: 0.875rem;
    background-color: var(--color-gold-500);
  }

  .rule {
    position: relative;
    height: 1px;
    background-color: var(--color-border-subtle);
    margin-block: 1.25rem 0 0;
  }

  .rule span {
    position: absolute;
    inset-inline-start: 0;
    top: -1px;
    height: 3px;
    width: 64px;
    background-color: var(--color-gold-500);
  }

  .about-bio {
    max-width: 60ch;
    color: var(--color-ink);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    margin-block-end: 2rem;
  }

  .about-bio-long {
    max-width: 68ch;
    color: var(--color-ink-secondary);
    font-size: 1rem;
    margin-block-end: 3rem;
  }

  .about-section {
    margin-block-end: 3rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
    margin-block-end: 1.25rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--color-brand);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .entry-title {
    font-size: 1.125rem;
    margin-block-end: 0.25rem;
  }

  .entry-org,
  .entry-link {
    font-weight: 600;
    color: var(--color-brand);
  }

  .entry-link:hover {
    text-decoration: underline;
  }

  .entry-meta {
    margin: 0 0 0.75rem;
    color: var(--color-ink-secondary);
    font-size: 0.875rem;
  }

  .entry-bullets {
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-ink-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .entry-thesis,
  .entry-text {
    margin: 0;
    color: var(--color-ink-secondary);
  }

  .skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .skill {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--color-brand);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .skill-name {
    font-size: 1.0625rem;
    margin-block-end: 0.375rem;
  }

  .skill-meta {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: 0.8125rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .skill-category {
    color: var(--color-brand);
    font-weight: 600;
  }

  .skill-separator {
    color: var(--color-ink-secondary);
  }

  .plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .plain-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .pub-title,
  .cert-name {
    margin: 0 0 0.25rem;
    font-weight: 600;
  }

  .pub-status,
  .cert-detail {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: 0.875rem;
  }

  .socials {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-block-end: 2rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    color: var(--color-brand);
    text-decoration: none;
    font-weight: 600;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    transition: background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .social-link:hover {
    background-color: var(--color-brand-soft);
    border-color: var(--color-brand);
  }

  .availability {
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    margin-block-end: 2rem;
  }

  .availability-text {
    margin: 0;
    color: var(--color-ink);
    font-weight: 600;
    max-width: 60ch;
  }

  .contact-state {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    border-block-start: 1px solid var(--color-border-subtle);
    padding-block-start: 1.5rem;
  }

  .contact-state-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand);
  }

  :global(html[dir="rtl"]) .contact-state-label {
    font-family: var(--font-persian);
    letter-spacing: 0.02em;
  }

  .contact-state-text {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: 0.875rem;
  }
</style>
