---
import Lightbox from "./Lightbox.astro";

export interface StoryMedia {
  id: number;
  url: string;
  mime: string;
  alt: string;
  altFa: string;
  altEn: string;
  title: string;
}

export interface StoryBlock {
  blockType: string;
  settings: Record<string, unknown>;
}

export interface StorySection {
  layout: string;
  ratio: string;
  blocks: StoryBlock[];
}

export interface StoryDocument {
  locale: string;
  title: string;
  sections: StorySection[];
}

interface Props {
  locale: "fa" | "en";
  story: StoryDocument;
}

function mediaOf(settings: Record<string, unknown>): StoryMedia | StoryMedia[] | null {
  const media = settings.media;
  if (Array.isArray(media)) {
    return media as StoryMedia[];
  }
  if (media && typeof media === "object" && "url" in media) {
    return media as StoryMedia;
  }
  return null;
}

function itemsOf(settings: Record<string, unknown>): Array<Record<string, unknown>> {
  const items = settings.items;
  return Array.isArray(items) ? (items as Array<Record<string, unknown>>) : [];
}

function stringOf(value: unknown): string {
  return typeof value === "string" ? value : "";
}

function altFor(locale: "fa" | "en", item: StoryMedia): string {
  if (locale === "fa" && item.altFa) return item.altFa;
  if (locale === "en" && item.altEn) return item.altEn;
  return item.alt || item.title;
}

function columnStyle(layout: string, ratio: string): string {
  if (layout === "2col") {
    if (ratio === "1:2") return "1fr 2fr";
    if (ratio === "2:1") return "2fr 1fr";
    return "1fr 1fr";
  }
  if (layout === "3col") {
    return "1fr 1fr 1fr";
  }
  return "1fr";
}

const { locale, story } = Astro.props;

const needsLightbox = story.sections.some((section) =>
  section.blocks.some((block) => {
    if (block.blockType !== "figure" && block.blockType !== "gallery") return false;
    const media = mediaOf(block.settings);
    if (Array.isArray(media)) return media.some((m) => Boolean(m.url));
    return Boolean(media?.url);
  }),
);
---

{
  story.sections.map((section: StorySection, sectionIndex: number) => (
    <section
      class="story-section"
      style={`display:grid;gap:1rem;grid-template-columns:${columnStyle(section.layout, section.ratio)}`}
    >
      {
        section.blocks.map((block: StoryBlock, blockIndex: number) => {
          const s = block.settings;
          const media = mediaOf(s);
          const caption = typeof s.caption === "string" ? s.caption : "";
          const blockKey = `${sectionIndex}-${blockIndex}`;
          if (block.blockType === "heading") {
            const text = typeof s.text === "string" ? s.text : "";
            if (s.level === "h3") {
              return <h3 class="story-heading">{text}</h3>;
            }
            if (s.level === "h4") {
              return <h4 class="story-heading">{text}</h4>;
            }
            return <h2 class="story-heading">{text}</h2>;
          }
          if (block.blockType === "text") {
            return (
              <div class="story-text" set:html={typeof s.body === "string" ? s.body : ""} />
            );
          }
          if (block.blockType === "quote") {
            return (
              <blockquote class="story-quote">
                <div set:html={typeof s.body === "string" ? s.body : ""} />
                {typeof s.source === "string" && s.source && <footer>{s.source}</footer>}
              </blockquote>
            );
          }
          if (block.blockType === "cta") {
            const href = typeof s.url === "string" ? s.url : "";
            const label = typeof s.label === "string" ? s.label : href;
            return href ? (
              <p>
                <a href={href}>{label}</a>
              </p>
            ) : (
              <p>{label}</p>
            );
          }
          if (block.blockType === "figure" && media && !Array.isArray(media)) {
            return (
              <figure>
                <a
                  href={media.url}
                  data-lightbox
                  data-lightbox-alt={altFor(locale, media)}
                >
                  <img src={media.url} alt={altFor(locale, media)} />
                </a>
                {caption && <figcaption>{caption}</figcaption>}
              </figure>
            );
          }
          if (block.blockType === "gallery" && Array.isArray(media)) {
            return (
              <div class="story-gallery">
                {media.map((item: StoryMedia) => (
                  <figure>
                    <a
                      href={item.url}
                      data-lightbox
                      data-lightbox-alt={altFor(locale, item)}
                    >
                      <img src={item.url} alt={altFor(locale, item)} />
                    </a>
                  </figure>
                ))}
              </div>
            );
          }
          if (block.blockType === "slider" && Array.isArray(media)) {
            return (
              <div class="story-slider" role="region" aria-label="Gallery">
                {media.map((item: StoryMedia) => (
                  <figure class="story-slider-slide">
                    <img src={item.url} alt={altFor(locale, item)} loading="lazy" />
                  </figure>
                ))}
              </div>
            );
          }
          if (block.blockType === "video" && media && !Array.isArray(media)) {
            return (
              <figure>
                <video controls src={media.url} preload="metadata">
                  <a href={media.url}>{media.title}</a>
                </video>
                {caption && <figcaption>{caption}</figcaption>}
              </figure>
            );
          }
          if (block.blockType === "audio" && media && !Array.isArray(media)) {
            return (
              <figure>
                <audio controls src={media.url} preload="metadata">
                  <a href={media.url}>{media.title}</a>
                </audio>
                {caption && <figcaption>{caption}</figcaption>}
              </figure>
            );
          }
          if (block.blockType === "math") {
            return (
              <div
                class="story-math"
                set:html={typeof s.html === "string" ? s.html : ""}
              />
            );
          }
          if (block.blockType === "accordion") {
            const items = itemsOf(s);
            return (
              <div class="story-accordion">
                {items.map((item) => (
                  <details class="story-accordion-item">
                    <summary>{stringOf(item.title)}</summary>
                    <div class="story-accordion-body" set:html={stringOf(item.body)} />
                  </details>
                ))}
              </div>
            );
          }
          if (block.blockType === "tabs") {
            const items = itemsOf(s);
            const groupName = `story-tabs-${blockKey}`;
            return (
              <div class="story-tabs">
                {items.map((_item, index) => (
                  <input
                    type="radio"
                    name={groupName}
                    id={`${groupName}-${index}`}
                    checked={index === 0}
                    class="story-tabs-input"
                  />
                ))}
                <div class="story-tabs-labels" role="tablist">
                  {items.map((item, index) => (
                    <label
                      class="story-tabs-label"
                      for={`${groupName}-${index}`}
                      role="tab"
                    >
                      {stringOf(item.label)}
                    </label>
                  ))}
                </div>
                <div class="story-tabs-panels">
                  {items.map((item, index) => (
                    <div
                      class="story-tab-panel"
                      role="tabpanel"
                      aria-labelledby={`${groupName}-${index}`}
                    >
                      <div set:html={stringOf(item.body)} />
                    </div>
                  ))}
                </div>
              </div>
            );
          }
          if (block.blockType === "timeline") {
            const items = itemsOf(s);
            return (
              <ol class="story-timeline">
                {items.map((item) => (
                  <li class="story-timeline-item">
                    <time class="story-timeline-date" datetime={stringOf(item.date)}>
                      {stringOf(item.date)}
                    </time>
                    <h3 class="story-timeline-title">{stringOf(item.title)}</h3>
                    {stringOf(item.body) && (
                      <div class="story-timeline-body" set:html={stringOf(item.body)} />
                    )}
                  </li>
                ))}
              </ol>
            );
          }
          if (block.blockType === "counters") {
            const items = itemsOf(s);
            return (
              <dl class="story-counters">
                {items.map((item) => (
                  <div class="story-counter">
                    <dt class="story-counter-label">{stringOf(item.label)}</dt>
                    <dd class="story-counter-value">{stringOf(item.value)}</dd>
                  </div>
                ))}
              </dl>
            );
          }
          if (block.blockType === "before_after") {
            const beforeMedia =
              s.beforeMedia && typeof s.beforeMedia === "object" && "url" in s.beforeMedia
                ? (s.beforeMedia as StoryMedia)
                : null;
            const afterMedia =
              s.afterMedia && typeof s.afterMedia === "object" && "url" in s.afterMedia
                ? (s.afterMedia as StoryMedia)
                : null;
            if (!beforeMedia || !afterMedia) {
              return null;
            }
            const beforeLabel = stringOf(s.beforeLabel) || (locale === "fa" ? "قبل" : "Before");
            const afterLabel = stringOf(s.afterLabel) || (locale === "fa" ? "بعد" : "After");
            const beforeCaption = stringOf(s.beforeCaption);
            const afterCaption = stringOf(s.afterCaption);
            return (
              <div class="story-before-after">
                <figure class="story-before-after-figure">
                  <figcaption class="story-before-after-label">{beforeLabel}</figcaption>
                  <img src={beforeMedia.url} alt={altFor(locale, beforeMedia)} />
                  {beforeCaption && <figcaption>{beforeCaption}</figcaption>}
                </figure>
                <figure class="story-before-after-figure">
                  <figcaption class="story-before-after-label">{afterLabel}</figcaption>
                  <img src={afterMedia.url} alt={altFor(locale, afterMedia)} />
                  {afterCaption && <figcaption>{afterCaption}</figcaption>}
                </figure>
              </div>
            );
          }
          if (block.blockType === "divider") {
            return <hr />;
          }
          return null;
        })
      }
    </section>
  ))
}

{needsLightbox && <Lightbox />}

<style>
  .story-section {
    margin-block: 1.25rem;
  }

  .story-heading {
    font-family: var(--font-display);
    margin: 0;
  }

  .story-text :global(p),
  .story-quote {
    line-height: 1.7;
  }

  .story-quote {
    margin-inline: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-border-subtle);
    color: var(--color-ink-muted);
  }

  .story-gallery {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }

  .story-section :global(img),
  .story-section :global(video) {
    max-width: 100%;
    height: auto;
  }

  .story-section :global(audio) {
    width: 100%;
  }

  .story-math {
    overflow-x: auto;
  }

  .story-accordion {
    display: grid;
    gap: 0.5rem;
  }

  .story-accordion-item {
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.25rem;
    padding: 0.5rem 0.75rem;
  }

  .story-accordion-item summary {
    cursor: pointer;
    font-weight: 600;
  }

  .story-accordion-body {
    margin-block-start: 0.5rem;
    line-height: 1.7;
  }

  .story-tabs-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .story-tabs-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .story-tabs-label {
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    border-bottom: none;
    margin-bottom: -1px;
  }

  .story-tabs {
    display: grid;
    gap: 0;
  }

  .story-tabs-panels {
    padding-block-start: 0.75rem;
  }

  .story-tab-panel {
    display: none;
    line-height: 1.7;
  }

  .story-tabs-input:nth-of-type(1):checked ~ .story-tabs-panels .story-tab-panel:nth-child(1),
  .story-tabs-input:nth-of-type(2):checked ~ .story-tabs-panels .story-tab-panel:nth-child(2),
  .story-tabs-input:nth-of-type(3):checked ~ .story-tabs-panels .story-tab-panel:nth-child(3),
  .story-tabs-input:nth-of-type(4):checked ~ .story-tabs-panels .story-tab-panel:nth-child(4),
  .story-tabs-input:nth-of-type(5):checked ~ .story-tabs-panels .story-tab-panel:nth-child(5),
  .story-tabs-input:nth-of-type(6):checked ~ .story-tabs-panels .story-tab-panel:nth-child(6),
  .story-tabs-input:nth-of-type(7):checked ~ .story-tabs-panels .story-tab-panel:nth-child(7),
  .story-tabs-input:nth-of-type(8):checked ~ .story-tabs-panels .story-tab-panel:nth-child(8) {
    display: block;
  }

  .story-tabs-input:nth-of-type(1):checked ~ .story-tabs-labels .story-tabs-label:nth-child(1),
  .story-tabs-input:nth-of-type(2):checked ~ .story-tabs-labels .story-tabs-label:nth-child(2),
  .story-tabs-input:nth-of-type(3):checked ~ .story-tabs-labels .story-tabs-label:nth-child(3),
  .story-tabs-input:nth-of-type(4):checked ~ .story-tabs-labels .story-tabs-label:nth-child(4),
  .story-tabs-input:nth-of-type(5):checked ~ .story-tabs-labels .story-tabs-label:nth-child(5),
  .story-tabs-input:nth-of-type(6):checked ~ .story-tabs-labels .story-tabs-label:nth-child(6),
  .story-tabs-input:nth-of-type(7):checked ~ .story-tabs-labels .story-tabs-label:nth-child(7),
  .story-tabs-input:nth-of-type(8):checked ~ .story-tabs-labels .story-tabs-label:nth-child(8) {
    border-color: var(--color-border-subtle);
    background: var(--color-surface-raised, transparent);
    font-weight: 600;
  }

  .story-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-inline-start: 2px solid var(--color-border-subtle);
    padding-inline-start: 1rem;
    display: grid;
    gap: 1.25rem;
  }

  .story-timeline-item {
    position: relative;
  }

  .story-timeline-item::before {
    content: "";
    position: absolute;
    inset-inline-start: -1.35rem;
    top: 0.35rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--color-accent, currentColor);
  }

  .story-timeline-date {
    display: block;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  .story-timeline-title {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .story-timeline-body {
    margin-block-start: 0.35rem;
    line-height: 1.7;
  }

  .story-counters {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    margin: 0;
  }

  .story-counter {
    text-align: center;
    padding: 0.75rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.25rem;
  }

  .story-counter-label {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  .story-counter-value {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
  }

  .story-before-after {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .story-before-after-figure {
    margin: 0;
  }

  .story-before-after-label {
    font-weight: 600;
    margin-block-end: 0.35rem;
  }

  .story-slider {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block-end: 0.5rem;
  }

  .story-slider-slide {
    flex: 0 0 min(85%, 24rem);
    scroll-snap-align: start;
    margin: 0;
  }

  .story-slider-slide img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
