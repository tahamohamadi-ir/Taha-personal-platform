---
import type { ProjectDetailDto } from "../../lib/cms/projects";
import AvailabilityBar from "./AvailabilityBar.astro";
import DiagramBlock from "./DiagramBlock.astro";
import Lightbox from "../Lightbox.astro";

interface Props {
  locale: "en" | "fa";
  project: ProjectDetailDto;
  copy: {
    problemHeading: string;
    constraintsHeading: string;
    decisionsHeading: string;
    tradeOffsHeading: string;
    outcomesHeading: string;
    lessonsHeading: string;
    testingHeading: string;
    evidenceHeading: string;
    collaboratorsHeading: string;
    fundingHeading: string;
    diagramsHeading: string;
    screenshotsHeading: string;
    relatedHeading: string;
    topicsHeading: string;
    publicationsHeading: string;
    licenseLabel: string;
    versionLabel: string;
    dateLabel: string;
    availabilityLabel: string;
    codeLabel: string;
    dataLabel: string;
    demoLabel: string;
  };
}

const { locale, project, copy } = Astro.props;
const caseStudy = project.case_study;
const hasLightboxable =
  project.screenshots.some((s) => Boolean(s.image?.url)) ||
  project.diagrams.some((d) => Boolean(d.image?.url));
---

<article class="case-study-detail">
  <p class="meta">{project.project_type} · {copy.licenseLabel}: {project.license}</p>
  {project.objective && <p class="lead">{project.objective}</p>}

  {
    caseStudy?.problem && (
      <>
        <h2>{copy.problemHeading}</h2>
        <p>{caseStudy.problem}</p>
      </>
    )
  }

  {
    project.diagrams.length > 0 && (
      <>
        <h2>{copy.diagramsHeading}</h2>
        {project.diagrams.map((diagram) => (
          <DiagramBlock
            diagram={diagram}
            labels={{ versionLabel: copy.versionLabel, dateLabel: copy.dateLabel }}
          />
        ))}
      </>
    )
  }

  {
    caseStudy?.constraints && (
      <>
        <h2>{copy.constraintsHeading}</h2>
        <p>{caseStudy.constraints}</p>
      </>
    )
  }

  {
    caseStudy?.technical_decisions && (
      <>
        <h2>{copy.decisionsHeading}</h2>
        <div class="richtext" set:html={caseStudy.technical_decisions} />
      </>
    )
  }

  {
    caseStudy?.trade_offs && (
      <>
        <h2>{copy.tradeOffsHeading}</h2>
        <p>{caseStudy.trade_offs}</p>
      </>
    )
  }

  {
    caseStudy?.outcomes_summary && (
      <>
        <h2>{copy.outcomesHeading}</h2>
        <p>{caseStudy.outcomes_summary}</p>
      </>
    )
  }

  {
    project.evidence.length > 0 && (
      <>
        <h2>{copy.evidenceHeading}</h2>
        <ul>
          {project.evidence.map((e) => (
            <li>
              <strong>{e.label}</strong>: {e.value}
              <span class="source"> ({e.source})</span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    caseStudy?.lessons_learned && (
      <>
        <h2>{copy.lessonsHeading}</h2>
        <p>{caseStudy.lessons_learned}</p>
      </>
    )
  }

  {
    caseStudy?.testing_summary && (
      <>
        <h2>{copy.testingHeading}</h2>
        <p>{caseStudy.testing_summary}</p>
      </>
    )
  }

  <AvailabilityBar
    locale={locale}
    project={project}
    labels={{
      availabilityLabel: copy.availabilityLabel,
      codeLabel: copy.codeLabel,
      dataLabel: copy.dataLabel,
      demoLabel: copy.demoLabel,
    }}
  />

  {
    project.screenshots.length > 0 && (
      <>
        <h2>{copy.screenshotsHeading}</h2>
        <ul class="screenshot-list">
          {project.screenshots.map((shot) => (
            <li class="screenshot-item">
              {
                shot.image?.url ? (
                  <figure class="screenshot-figure">
                    <a
                      href={shot.image.url}
                      data-lightbox
                      data-lightbox-alt={shot.alt_text || shot.image.alt || shot.caption}
                    >
                      <img
                        src={shot.image.url}
                        alt={shot.alt_text || shot.image.alt || shot.caption}
                        loading="lazy"
                      />
                    </a>
                    <figcaption>
                      <strong>{shot.caption}</strong>
                      {
                        shot.external_url ? (
                          <>
                            {" "}
                            —{" "}
                            <a href={shot.external_url} rel="noopener noreferrer">
                              {shot.external_url}
                            </a>
                          </>
                        ) : null
                      }
                    </figcaption>
                  </figure>
                ) : (
                  <>
                    <strong>{shot.caption}</strong> — {shot.alt_text}
                    {
                      shot.external_url ? (
                        <>
                          {" "}
                          (
                          <a href={shot.external_url} rel="noopener noreferrer">
                            {shot.external_url}
                          </a>
                          )
                        </>
                      ) : null
                    }
                  </>
                )
              }
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    project.collaborators.length > 0 && (
      <>
        <h2>{copy.collaboratorsHeading}</h2>
        <ul>
          {project.collaborators.map((c) => (
            <li>{c.name}{c.role ? ` — ${c.role}` : ""}</li>
          ))}
        </ul>
      </>
    )
  }

  {
    project.funding.length > 0 && (
      <>
        <h2>{copy.fundingHeading}</h2>
        <ul>
          {project.funding.map((f) => (
            <li>{f.funder}{f.grant_id ? ` (${f.grant_id})` : ""}</li>
          ))}
        </ul>
      </>
    )
  }

  <h2>{copy.relatedHeading}</h2>
  <h3>{copy.topicsHeading}</h3>
  <ul>
    {project.topics.map((t) => (
      <li><a href={`/${locale}/research/topics/${t.slug}/`}>{t.title}</a></li>
    ))}
  </ul>
  <h3>{copy.publicationsHeading}</h3>
  <ul>
    {project.publications.map((p) => (
      <li><a href={`/${locale}/research/publications/${p.slug}/`}>{p.title}</a></li>
    ))}
  </ul>
</article>

{hasLightboxable && <Lightbox />}

<style>
  .case-study-detail h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 1.5rem 0 0.5rem;
  }
  .meta, .lead, .source {
    color: var(--color-ink-muted);
  }
  ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  li {
    margin-bottom: 0.5rem;
  }
  .screenshot-list {
    display: grid;
    gap: 1rem;
  }
  .screenshot-figure {
    margin: 0;
  }
  .screenshot-figure img {
    max-width: 100%;
    height: auto;
  }
  .richtext :global(p) {
    margin: 0 0 0.75rem;
  }
</style>
