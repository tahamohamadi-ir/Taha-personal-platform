---
import type { LocaleContent } from "../../data/content";
import type { ResearchGraphModel } from "../../lib/cms/research-graph";
import ResearchGraphIsland from "./ResearchGraphIsland";

export interface Props {
  graph: ResearchGraphModel;
  content: LocaleContent;
}

const { graph, content } = Astro.props;
const research = content.research;
const dir = content.dir;
---

<section class="research-graph" aria-labelledby="research-graph-heading">
  <h2 id="research-graph-heading">{research.graphHeading}</h2>
  <p class="research-graph-intro">{research.graphIntro}</p>

  <ResearchGraphIsland
    client:visible
    graph={graph}
    dir={dir}
    labels={{
      interactiveLabel: research.graphInteractiveLabel,
      zoomIn: research.graphZoomIn,
      zoomOut: research.graphZoomOut,
      resetView: research.graphResetView,
      focusHint: research.graphFocusHint,
      topicKind: research.topicsHeading,
      projectKind: research.projectsHeading,
      publicationKind: research.publicationsHeading,
    }}
  />

  <div class="research-graph-tree">
    <h3>{research.graphTreeLabel}</h3>
    {
      graph.tree.length === 0 ? (
        <p class="empty">{research.empty}</p>
      ) : (
        <ul class="topic-tree">
          {graph.tree.map((topic) => (
            <li>
              <a href={topic.href}>{topic.title}</a>
              {(topic.projects.length > 0 || topic.publications.length > 0) && (
                <ul>
                  {topic.projects.length > 0 && (
                    <li>
                      <span class="branch-label">{research.projectsHeading}</span>
                      <ul>
                        {topic.projects.map((p) => (
                          <li>
                            <a href={p.href}>{p.title}</a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  )}
                  {topic.publications.length > 0 && (
                    <li>
                      <span class="branch-label">{research.publicationsHeading}</span>
                      <ul>
                        {topic.publications.map((p) => (
                          <li>
                            <a href={p.href}>{p.title}</a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  )}
                </ul>
              )}
            </li>
          ))}
        </ul>
      )
    }
    {
      graph.orphanProjects.length > 0 && (
        <>
          <h4>{research.graphOrphanProjectsLabel}</h4>
          <ul>
            {graph.orphanProjects.map((p) => (
              <li>
                <a href={p.href}>{p.title}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
    {
      graph.orphanPublications.length > 0 && (
        <>
          <h4>{research.graphOrphanPublicationsLabel}</h4>
          <ul>
            {graph.orphanPublications.map((p) => (
              <li>
                <a href={p.href}>{p.title}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>

<style>
  .research-graph {
    margin-block: 2rem 2.5rem;
  }
  .research-graph h2 {
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.5rem);
  }
  .research-graph-intro,
  .empty {
    color: var(--color-ink-secondary);
    max-width: 62ch;
  }
  .research-graph-intro {
    margin: 0.5rem 0 0;
  }
  .research-graph-tree {
    margin-top: 1.25rem;
  }
  .research-graph-tree h3,
  .research-graph-tree h4 {
    margin: 1rem 0 0.5rem;
    font-size: 1rem;
  }
  .topic-tree,
  .topic-tree ul,
  .research-graph-tree > ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topic-tree > li {
    margin-bottom: 0.85rem;
    padding-block: 0.35rem;
    border-block-end: 1px solid var(--color-border-subtle);
  }
  .topic-tree a {
    font-weight: 600;
    color: inherit;
  }
  .topic-tree a:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .branch-label {
    display: block;
    margin-block: 0.35rem 0.15rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-brand);
  }
  .topic-tree ul ul a {
    font-weight: 500;
    color: var(--color-ink-secondary);
  }
</style>
