---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { LocaleContent } from "../data/content";
import { site } from "../data/site";
import type { JsonLdBlock } from "../data/structured";
import { websiteJsonLd, personJsonLd, validateStructuredData, jsonLdScriptContent } from "../data/structured";
import {
  getPrimaryColorOverride,
  getSiteSeoDefaults,
  validateBrandContrast,
  ALLOWED_BRAND_COLORS,
  FALLBACK_PRIMARY_COLOR,
} from "../lib/cms/siteSettings";
import { isCmsOriginBuild } from "../lib/cms/client";

interface Props {
  content: LocaleContent;
  alternateHref?: string | null;
  structured?: JsonLdBlock[];
  title?: string;
  description?: string;
  cmsBuildOrigin?: "snapshot" | "cms";
  /** Site-root path or absolute URL. Defaults to /og-default.png. */
  ogImage?: string | null;
}

const {
  content,
  alternateHref = null,
  structured = [websiteJsonLd(), personJsonLd(content.lang)],
  title = content.meta.title,
  description = content.meta.description,
  cmsBuildOrigin,
  ogImage = null,
} = Astro.props;
const defaultOgImage = new URL("/og-default.png", site.url).href;
const resolvedOgImage = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : new URL(ogImage, site.url).href
  : defaultOgImage;
const rssHref = new URL(`/${content.lang}/writing/rss.xml`, site.url).href;
const canonical = new URL(Astro.url.pathname, site.url).href;
const altLang = content.lang === "fa" ? "en" : "fa";
validateStructuredData(...structured);
const seoDefaults = await getSiteSeoDefaults();
const isCms = isCmsOriginBuild();
// E7/RISK-0014: an owner-chosen primaryColor that fails WCAG AA (white on the
// fill, or brand vs canvas, worst case < 4.5:1) is clamped to the first
// allowlisted turquoise that passes — never a build failure.
const requestedPrimaryColor = await getPrimaryColorOverride();
let primaryColor: string | null = null;
if (requestedPrimaryColor && isCms) {
  const verdict = validateBrandContrast(requestedPrimaryColor);
  if (verdict.ok) {
    primaryColor = requestedPrimaryColor;
  } else {
    primaryColor =
      ALLOWED_BRAND_COLORS.find((candidate) => validateBrandContrast(candidate).ok) ??
      FALLBACK_PRIMARY_COLOR;
    console.warn(
      `[cms] primaryColor ${requestedPrimaryColor} fails WCAG AA contrast (${verdict.ratio.toFixed(2)}:1); clamped to ${primaryColor}`,
    );
  }
}
const effectiveTitle =
  title !== content.meta.title || !isCms || !seoDefaults.title ? title : seoDefaults.title;
const effectiveDescription =
  description !== content.meta.description || !isCms || !seoDefaults.description
    ? description
    : seoDefaults.description;
const effectiveOrigin = cmsBuildOrigin ?? (isCms ? "cms" : "snapshot");
---

<!doctype html>
<html lang={content.lang} dir={content.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f5" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{effectiveTitle}</title>
    <meta name="description" content={effectiveDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={content.lang} href={canonical} />
    {
      alternateHref && (
        <link rel="alternate" hreflang={altLang} href={new URL(alternateHref, site.url).href} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={content.lang === "fa" ? "fa_IR" : "en_US"} />
    <meta property="og:title" content={effectiveTitle} />
    <meta property="og:description" content={effectiveDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={content.blog.heading}
      href={rssHref}
    />
    <meta name="robots" content="index,follow" />
    <meta name="cms-build-origin" content={effectiveOrigin} />
    {
      primaryColor && (
        <style is:inline set:html={`:root { --color-brand: ${primaryColor}; }`} />
      )
    }
    {
      structured.map((block) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={jsonLdScriptContent(block)}
        />
      ))
    }
  </head>
  <body class="site-shell">
    <a class="skip-link" href="#main">{content.skip}</a>
    <Header content={content} alternateHref={alternateHref} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer content={content} alternateHref={alternateHref} />
  </body>
</html>
