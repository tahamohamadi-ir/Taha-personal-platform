---
/* layouts/EditorialIndexTemplate - WF-05. Editorial index for the writing
   and learning families (writing index/series/tag; teaching). Like the
   collection index plus the optional featured-record rail after the
   section lead (templates.json: "optional FeaturedRecord"). The featured
   region renders only when its slot has content - no wrapper gap.
   Semantic composition only: the route fills the named slots with
   Breadcrumbs, SectionLead as="h1", content/FeaturedRecord, the no-JS
   filter seam, ContentRow results and pagination; header and footer
   landmarks are owned by BaseLayout. No data fetching, no CMS calls, no
   route policy.
   Seams: a new editorial family reuses this template through its route
   adapter; featured anatomy belongs to content/FeaturedRecord. Theming
   cascades from tokens. */
const hasFeatured = Astro.slots.has("featured");
---
<div class="tpl-editorial">
  <div class="tpl-editorial__breadcrumbs"><slot name="breadcrumbs" /></div>
  <div class="tpl-editorial__lead"><slot name="sectionLead" /></div>
  {
    hasFeatured && (
      <div class="tpl-editorial__featured">
        <slot name="featured" />
      </div>
    )
  }
  <div class="tpl-editorial__filters"><slot name="filters" /></div>
  <div class="tpl-editorial__results"><slot name="results" /></div>
  <div class="tpl-editorial__pagination"><slot name="pagination" /></div>
</div>

<style>
  .tpl-editorial {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--measure-page);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
    padding-block: var(--space-section);
  }
</style>
