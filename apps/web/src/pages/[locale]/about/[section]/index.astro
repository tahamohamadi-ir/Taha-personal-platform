---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import TranslationUnavailable from "../../../../components/TranslationUnavailable.astro";
import { content as allContent } from "../../../../data/content";
import {
  getAboutSection,
  getSectionAlternateHref,
  type AboutSectionId,
} from "../../../../data/aboutSections";
import { loadPublicProfile } from "../../../../data/cmsProfile";
import { breadcrumbJsonLd, personJsonLd, websiteJsonLd } from "../../../../data/structured";
import { site, type LocaleCode } from "../../../../data/site";

export async function getStaticPaths() {
  const validSections: AboutSectionId[] = [
    "experience",
    "education",
    "skills",
    "research",
    "publications",
    "certificates",
  ];
  const paths: Array<{ params: { locale: LocaleCode; section: AboutSectionId } }> = [];

  for (const locale of site.locales) {
    const profileResult = await loadPublicProfile(locale);
    if (profileResult.kind !== "profile") {
      for (const section of validSections) {
        paths.push({ params: { locale, section } });
      }
      continue;
    }

    const sections = validSections.filter((section) =>
      Boolean(getAboutSection(allContent[locale], profileResult.profile, section)),
    );
    for (const section of sections) {
      paths.push({ params: { locale, section } });
    }
  }

  return paths;
}

const locale = Astro.params.locale as LocaleCode;
const sectionId = Astro.params.section as AboutSectionId;
const content = allContent[locale];
const alternateLocale = locale === "fa" ? "en" : "fa";
const profileResult = await loadPublicProfile(locale);
const validSections: AboutSectionId[] = [
  "experience",
  "education",
  "skills",
  "research",
  "publications",
  "certificates",
];

if (!site.locales.includes(locale) || !validSections.includes(sectionId)) {
  Astro.response.status = 404;
}

const section =
  profileResult.kind === "profile"
    ? getAboutSection(content, profileResult.profile, sectionId)
    : undefined;

if (profileResult.kind === "not-found" || (profileResult.kind === "profile" && !section)) {
  Astro.response.status = 404;
}

const sectionHref = `/${locale}/about/${sectionId}/`;
const breadcrumbs =
  section && profileResult.kind === "profile"
    ? [
        { label: content.name, href: `/${locale}/` },
        { label: content.about.heading, href: `/${locale}/about/` },
        { label: section.label, href: sectionHref },
      ]
    : [];
const structured =
  profileResult.kind === "profile" && section
    ? [
        websiteJsonLd(),
        personJsonLd(locale, profileResult.profile),
        breadcrumbJsonLd(
          breadcrumbs.map((item) => ({
            name: item.label,
            path: item.href,
          })),
        ),
      ]
    : [websiteJsonLd()];
const title = section ? `${section.label} · ${content.about.heading} · ${content.name}` : content.meta.title;
const description = section
  ? `Published ${section.label.toLowerCase()} entries from the CMS-managed About profile.`
  : content.meta.description;
---

<BaseLayout
  content={content}
  alternateHref={getSectionAlternateHref(locale, sectionId)}
  structured={structured}
  title={title}
  description={description}
>
  {
    profileResult.kind === "translation-unavailable" ? (
      <TranslationUnavailable
        kicker={locale === "fa" ? "ترجمه در دسترس نیست" : "Translation unavailable"}
        title={content.about.heading}
        message={
          locale === "fa"
            ? "این بخش هنوز به فارسی منتشر نشده است. می‌توانید به صفحهٔ درباره برگردید یا نسخهٔ انگلیسی را ببینید."
            : "This section is not published in English yet. You can return to About or open the published Persian version."
        }
        parentHref={`/${locale}/about/`}
        parentLabel={content.about.heading}
        alternateHref={
          profileResult.availableLocales.includes(alternateLocale)
            ? `/${alternateLocale}/about/${sectionId}/`
            : null
        }
        alternateLabel={alternateLocale === "fa" ? "فارسی" : "English"}
      />
    ) : section ? (
      <section class="about-section-page">
        <div class="about-section-shell">
          <Breadcrumbs items={breadcrumbs} />
          <header class="about-section-header">
            <p class="about-section-kicker">{content.about.heading}</p>
            <h1 class="about-section-title">{section.label}</h1>
            <p class="about-section-intro">
              {locale === "fa"
                ? "این فهرست از پروفایل CMS در زمان build خوانده شده است."
                : "This list is read from the CMS-managed profile at build time."}
            </p>
          </header>
          <div class="about-section-list">
            {
              section.items.map((item) => (
                <article class="about-section-card">
                  <div class="about-section-card-head">
                    <p class="about-section-card-eyebrow">{item.eyebrow}</p>
                    {item.detailSlug && item.detailBody ? (
                      <h2 class="about-section-card-title">
                        <a href={`${sectionHref}${item.detailSlug}/`}>{item.title}</a>
                      </h2>
                    ) : (
                      <h2 class="about-section-card-title">{item.title}</h2>
                    )}
                    {item.meta && <p class="about-section-card-meta">{item.meta}</p>}
                  </div>
                  {item.body && <p class="about-section-card-body">{item.body}</p>}
                  {item.bullets && item.bullets.length > 0 && (
                    <ul class="about-section-card-bullets">
                      {item.bullets.map((bullet) => <li>{bullet}</li>)}
                    </ul>
                  )}
                  {item.href && (
                    <p class="about-section-card-link-row">
                      <a class="about-section-card-link" href={item.href} rel="noopener" target="_blank">
                        {item.hrefLabel ?? item.href}
                      </a>
                    </p>
                  )}
                </article>
              ))
            }
          </div>
          <aside class="about-next-step">
            <h2 class="about-next-step-title">
              {locale === "fa" ? "گام بعدی" : "Next step"}
            </h2>
            <p class="about-next-step-copy">
              {locale === "fa"
                ? "برای زمینهٔ کامل، به صفحهٔ درباره برگردید یا نسخه‌های CV و رزومه را ببینید."
                : "Return to About for the full profile context, or open the CV and resume downloads."}
            </p>
            <div class="about-next-step-actions">
              <a class="about-next-step-link" href={`/${locale}/about/`}>
                {content.about.heading}
              </a>
              <a class="about-next-step-link" href={`/${locale}/cv/`}>
                {content.downloads.heading}
              </a>
            </div>
          </aside>
        </div>
      </section>
    ) : null
  }
</BaseLayout>

<style>
  .about-section-page {
    padding-block: var(--space-section);
    padding-inline: var(--space-gutter);
  }

  .about-section-shell {
    max-width: var(--measure-page);
    margin-inline: auto;
  }

  .about-section-header {
    max-width: var(--measure-prose);
    margin-block-end: var(--space-8);
  }

  .about-section-kicker {
    margin: 0 0 var(--space-3);
    color: var(--color-brand);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .about-section-title {
    margin: 0 0 var(--space-4);
    font-size: var(--text-display);
  }

  .about-section-intro {
    margin: 0;
    color: var(--color-ink-secondary);
    max-width: var(--measure-prose);
  }

  .about-section-list {
    display: grid;
    gap: var(--space-5);
    margin-block-end: var(--space-10);
  }

  .about-section-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .about-section-card-head {
    margin-block-end: var(--space-4);
  }

  .about-section-card-eyebrow,
  .about-section-card-meta {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
  }

  .about-section-card-eyebrow {
    margin-block-end: var(--space-2);
    font-weight: 600;
  }

  .about-section-card-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .about-section-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .about-section-card-title a:hover,
  .about-section-card-title a:focus-visible {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .about-section-card-body,
  .about-section-card-bullets {
    margin: 0;
    color: var(--color-ink-secondary);
    max-width: var(--measure-prose);
  }

  .about-section-card-bullets {
    padding-inline-start: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .about-section-card-link-row {
    margin: var(--space-4) 0 0;
  }

  .about-section-card-link {
    color: var(--color-brand);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .about-next-step {
    padding: var(--space-7);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-muted);
  }

  .about-next-step-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .about-next-step-copy {
    margin: 0 0 var(--space-5);
    color: var(--color-ink-secondary);
    max-width: var(--measure-prose);
  }

  .about-next-step-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .about-next-step-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-brand);
    text-decoration: none;
    font-weight: 600;
  }

  .about-next-step-link:hover,
  .about-next-step-link:focus-visible {
    background-color: var(--color-brand-soft);
    border-color: var(--color-brand);
  }
</style>
