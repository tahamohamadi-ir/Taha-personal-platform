---
/* WF-07G: gated About detail page adopted onto UtilityTemplate. The
   breadcrumbs slot stays FILLED (sub-pages may carry breadcrumbs; existing
   behavior + breadcrumb JSON-LD kept). The lead is SectionLead as="h1" with
   the item eyebrow/title, followed by the item meta and summary in the
   original order; the body keeps the published-story branch (StoryBody) and
   the detailBody paragraph fallback. Build-time gating (Latin slug +
   non-empty body/story via hasDetailContent) and the CMS profile loader
   unchanged. */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import UtilityTemplate from "../../../../layouts/UtilityTemplate.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import SectionLead from "../../../../components/content/SectionLead.astro";
import { content as allContent } from "../../../../data/content";
import {
  getAboutSection,
  getDetailAlternateHref,
  hasDetailContent,
  type AboutSectionId,
} from "../../../../data/aboutSections";
import StoryBody from "../../../../components/StoryBody.astro";
import { hasPublishedStory } from "../../../../lib/cms/story";
import { loadPublicProfile } from "../../../../data/cmsProfile";
import { breadcrumbJsonLd, personJsonLd, websiteJsonLd } from "../../../../data/structured";
import { site, type LocaleCode } from "../../../../data/site";

export async function getStaticPaths() {
  const validSections: AboutSectionId[] = [
    "experience",
    "education",
    "skills",
    "research",
    "publications",
    "certificates",
  ];
  const paths: Array<{ params: { locale: LocaleCode; section: AboutSectionId; slug: string } }> = [];

  for (const locale of site.locales) {
    const profileResult = await loadPublicProfile(locale);
    if (profileResult.kind !== "profile") {
      continue;
    }

    for (const sectionId of validSections) {
      const section = getAboutSection(allContent[locale], profileResult.profile, sectionId);
      for (const item of section?.items ?? []) {
        if (hasDetailContent(item)) {
          paths.push({
            params: {
              locale,
              section: sectionId,
              slug: item.detailSlug!,
            },
          });
        }
      }
    }
  }

  return paths;
}

const locale = Astro.params.locale as LocaleCode;
const sectionId = Astro.params.section as AboutSectionId;
const slug = Astro.params.slug ?? "";
const content = allContent[locale];
const alternateLocale = locale === "fa" ? "en" : "fa";
const profileResult = await loadPublicProfile(locale);
const alternateProfileResult = await loadPublicProfile(alternateLocale);

if (!site.locales.includes(locale)) {
  Astro.response.status = 404;
}

const section =
  profileResult.kind === "profile"
    ? getAboutSection(content, profileResult.profile, sectionId)
    : undefined;
const item = section?.items.find(
  (candidate) => candidate.detailSlug === slug && hasDetailContent(candidate),
);
const detailParagraphs = item?.detailBody?.split(/\n{2,}/) ?? [];
const itemHasStory = hasPublishedStory(item?.story);

if (!item || profileResult.kind !== "profile") {
  Astro.response.status = 404;
}

const nextStepTitle = locale === "fa" ? "گام بعدی" : "Next step";
const nextStepCopy =
  locale === "fa"
    ? "به فهرست این بخش برگردید یا نمای کامل پروفایل را در صفحهٔ درباره ببینید."
    : "Return to this section index, or go back to About for the full profile context.";
const breadcrumbs =
  item && section
    ? [
        { label: content.name, href: `/${locale}/` },
        { label: content.about.heading, href: `/${locale}/about/` },
        { label: section.label, href: `/${locale}/about/${sectionId}/` },
        { label: item.title, href: `/${locale}/about/${sectionId}/${slug}/` },
      ]
    : [];
const alternateHref =
  item &&
  alternateProfileResult.kind === "profile" &&
  section
    ? getDetailAlternateHref(
        locale,
        section.id,
        item,
        alternateProfileResult.profile,
        allContent[alternateLocale],
      )
    : null;
const structured =
  item && profileResult.kind === "profile"
    ? [
        websiteJsonLd(),
        personJsonLd(locale, profileResult.profile),
        breadcrumbJsonLd(
          breadcrumbs.map((entry) => ({
            name: entry.label,
            path: entry.href,
          })),
        ),
      ]
    : [websiteJsonLd()];
const title = item ? `${item.title} · ${section?.label} · ${content.name}` : content.meta.title;
const description = item?.body ?? content.meta.description;
---

<BaseLayout
  content={content}
  alternateHref={alternateHref}
  structured={structured}
  title={title}
  description={description}
>
  <UtilityTemplate>
    {
      item && section && <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
    }
    <Fragment slot="lead">
      <SectionLead as="h1" eyebrow={item?.eyebrow} heading={item ? item.title : content.about.heading} />
      {item?.meta && <p class="about-detail-meta">{item.meta}</p>}
      {item?.body && <p class="about-detail-summary">{item.body}</p>}
    </Fragment>
    {
      item && section ? (
        <article class="about-detail-body-wrap" slot="content">
          <div class="about-detail-body">
            {
              itemHasStory && item?.story ? (
                <StoryBody locale={locale} story={item.story} />
              ) : (
                detailParagraphs.map((paragraph) => <p>{paragraph}</p>)
              )
            }
          </div>

          <aside class="about-detail-next-step">
            <h2 class="about-detail-next-step-title">
              {nextStepTitle}
            </h2>
            <p class="about-detail-next-step-copy">
              {nextStepCopy}
            </p>
            <div class="about-detail-next-step-actions">
              <a class="about-detail-next-step-link" href={`/${locale}/about/${sectionId}/`}>
                {section.label}
              </a>
              <a class="about-detail-next-step-link" href={`/${locale}/about/`}>
                {content.about.heading}
              </a>
            </div>
          </aside>
        </article>
      ) : null
    }
  </UtilityTemplate>
</BaseLayout>

<style>
  .about-detail-meta {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
  }

  .about-detail-summary {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-secondary);
  }

  .about-detail-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure-prose);
    margin-block-end: var(--space-10);
  }

  .about-detail-body p {
    margin: 0;
    color: var(--color-ink);
  }

  .about-detail-next-step {
    padding: var(--space-7);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-muted);
  }

  .about-detail-next-step-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .about-detail-next-step-copy {
    margin: 0 0 var(--space-5);
    color: var(--color-ink-secondary);
    max-width: var(--measure-prose);
  }

  .about-detail-next-step-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .about-detail-next-step-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-brand);
    text-decoration: none;
    font-weight: 600;
  }

  .about-detail-next-step-link:hover,
  .about-detail-next-step-link:focus-visible {
    background-color: var(--color-brand-soft);
    border-color: var(--color-brand);
  }
</style>
