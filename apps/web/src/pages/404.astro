---
import "../styles/global.css";
import { content } from "../data/content";

const en = content.en;
const fa = content.fa;

const pathname = Astro.url.pathname;
const locale = pathname.startsWith("/fa/") || pathname === "/fa"
  ? fa
  : pathname.startsWith("/en/") || pathname === "/en"
    ? en
    : null;

const page = locale ?? en;
const title = locale
  ? `${page.notfound.heading} · ${page.name}`
  : `${en.notfound.heading} · ${en.name}`;
const actionsLabel = locale
  ? page.notfound.gatewayLabel
  : `${en.notfound.gatewayLabel} / ${fa.notfound.gatewayLabel}`;
const skip = locale?.skip ?? en.notfound.skip;
const homeHref = locale ? `/${page.lang}/` : "/";
const aboutHref = locale ? `/${page.lang}/about/` : null;
const cvHref = locale ? `/${page.lang}/cv/` : null;
---

<!doctype html>
<html lang={locale?.lang ?? "en"} dir={locale?.dir ?? "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071225" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="notfound">
    <a class="skip-link" href="#main">{skip}</a>
    <main class="notfound-panel glass-surface glass-surface--dark" id="main">
      <p class="notfound-code">{page.notfound.code}</p>
      <h1 class="notfound-title">
        {locale ? (
          page.notfound.heading
        ) : (
          <>
            <span lang="en" dir="ltr">{en.notfound.heading}</span>
            <span lang="fa" dir="rtl">{fa.notfound.heading}</span>
          </>
        )}
      </h1>
      <nav class="notfound-actions" aria-label={actionsLabel}>
        {locale ? (
          <>
            <a href={homeHref}>{page.notfound.gatewayLabel}</a>
            {aboutHref && <a href={aboutHref}>{page.about.heading}</a>}
            {cvHref && <a href={cvHref}>{page.downloads.heading}</a>}
          </>
        ) : (
          <>
            <a href="/">{actionsLabel}</a>
            <a href="/en/" hreflang="en" lang="en" dir="ltr">{en.notfound.enLabel}</a>
            <a href="/fa/" hreflang="fa" lang="fa" dir="rtl">{fa.notfound.faLabel}</a>
          </>
        )}
      </nav>
    </main>
  </body>
</html>

<style>
  .notfound {
    margin: 0;
    min-height: 100vh;
    min-height: 100svh;
    overflow-x: clip;
    background-color: var(--canvas-night);
    color: var(--ink-hi);
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  /* Glass background/border/shadow/blur come from the shared
     .glass-surface--dark utility (global.css, DEBT-0012); navy-900 is its
     opaque fallback when backdrop-filter is unsupported. The A-01 aurora
     body::before supplies the depth behind the card. */
  .notfound-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    margin-block: auto;
    padding: clamp(2rem, 6vw, 3rem) clamp(1.25rem, 6vw, 2.5rem);
    max-width: 34rem;
    border-radius: var(--radius-lg);
  }

  .notfound-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(4rem, 3rem + 6vw, 7rem);
    line-height: 1;
    font-weight: 700;
    color: var(--brand-text);
    letter-spacing: 0.04em;
  }

  .notfound-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    font-weight: 600;
    color: var(--ink-hi);
  }

  .notfound-title span {
    unicode-bidi: isolate;
  }

  .notfound-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-block-start: 1rem;
  }

  /* Same glass card pattern as the gateway language cards — fill + edge,
     hover brightens the fill; home link carries the brand accent. */
  .notfound-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.625rem 1.375rem;
    border-radius: var(--radius-md);
    background-color: var(--glass-fill);
    color: var(--ink-mid);
    border: 1px solid var(--glass-edge);
    text-decoration: none;
    font-weight: 700;
    transition: background-color var(--duration-night-fast) var(--ease-night),
      border-color var(--duration-night-fast) var(--ease-night);
  }

  .notfound-actions a:hover,
  .notfound-actions a:focus-visible {
    background-color: var(--glass-fill-strong);
    color: var(--ink-hi);
  }

  .notfound-actions a:focus-visible {
    outline-color: var(--ink-hi);
    outline-offset: 3px;
  }

  .notfound-actions a:first-child {
    color: var(--brand-text);
  }

  @media (max-width: 14rem) {
    .notfound-panel {
      padding-block: 1.5rem;
    }

    .notfound-code {
      font-size: clamp(2.5rem, 2rem + 8vw, 4rem);
    }

    .notfound-title {
      font-size: 1.125rem;
    }

    .notfound-actions a {
      padding: 0.5rem 0.875rem;
    }
  }
</style>
