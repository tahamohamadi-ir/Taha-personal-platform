---
import "../styles/global.css";
import { content } from "../data/content";

const en = content.en;
const fa = content.fa;

const pathname = Astro.url.pathname;
const locale = pathname.startsWith("/fa/") || pathname === "/fa"
  ? fa
  : pathname.startsWith("/en/") || pathname === "/en"
    ? en
    : null;

const page = locale ?? en;
const title = locale
  ? `${page.notfound.heading} · ${page.name}`
  : `${en.notfound.heading} · ${en.name}`;
const actionsLabel = locale
  ? page.notfound.gatewayLabel
  : `${en.notfound.gatewayLabel} / ${fa.notfound.gatewayLabel}`;
const skip = locale?.skip ?? en.notfound.skip;
const homeHref = locale ? `/${page.lang}/` : "/";
const aboutHref = locale ? `/${page.lang}/about/` : null;
const cvHref = locale ? `/${page.lang}/cv/` : null;
---

<!doctype html>
<html lang={locale?.lang ?? "en"} dir={locale?.dir ?? "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071225" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="notfound">
    <a class="skip-link" href="#main">{skip}</a>
    <svg
      class="notfound-field"
      aria-hidden="true"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
    >
      <g stroke="rgba(255,255,255,0.08)" stroke-width="1">
        <path d="M720 460 L420 260" />
        <path d="M720 460 L1010 300" />
        <path d="M720 460 L400 640" />
        <path d="M720 460 L1040 660" />
      </g>
      <circle cx="420" cy="260" r="5" fill="rgba(22,184,166,0.4)" />
      <circle cx="1010" cy="300" r="5" fill="rgba(22,184,166,0.4)" />
      <circle cx="400" cy="640" r="5" fill="rgba(22,184,166,0.4)" />
      <circle cx="1040" cy="660" r="5" fill="rgba(22,184,166,0.4)" />
    </svg>
    <main class="notfound-panel" id="main">
      <p class="notfound-code">{page.notfound.code}</p>
      <h1 class="notfound-title">
        {locale ? (
          page.notfound.heading
        ) : (
          <>
            <span lang="en" dir="ltr">{en.notfound.heading}</span>
            <span lang="fa" dir="rtl">{fa.notfound.heading}</span>
          </>
        )}
      </h1>
      <nav class="notfound-actions" aria-label={actionsLabel}>
        {locale ? (
          <>
            <a href={homeHref}>{page.notfound.gatewayLabel}</a>
            {aboutHref && <a href={aboutHref}>{page.about.heading}</a>}
            {cvHref && <a href={cvHref}>{page.downloads.heading}</a>}
          </>
        ) : (
          <>
            <a href="/">{actionsLabel}</a>
            <a href="/en/" hreflang="en" lang="en" dir="ltr">{en.notfound.enLabel}</a>
            <a href="/fa/" hreflang="fa" lang="fa" dir="rtl">{fa.notfound.faLabel}</a>
          </>
        )}
      </nav>
    </main>
  </body>
</html>

<style>
  .notfound {
    margin: 0;
    min-height: 100vh;
    min-height: 100svh;
    overflow-x: clip;
    background-color: var(--color-navy-950);
    color: var(--color-inverse);
    display: grid;
    place-items: center;
  }

  .notfound-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .notfound-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    margin-block: auto;
    padding: clamp(2rem, 6vw, 3rem) clamp(1rem, 5vw, 2rem);
    max-width: 34rem;
  }

  .notfound-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(4rem, 3rem + 6vw, 7rem);
    line-height: 1;
    font-weight: 700;
    color: var(--color-turquoise-500);
    letter-spacing: 0.04em;
  }

  .notfound-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
  }

  .notfound-title span {
    unicode-bidi: isolate;
  }

  .notfound-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-block-start: 1rem;
  }

  .notfound-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.625rem 1.375rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 700;
    color: var(--color-gold-500);
    border: 1px solid var(--color-gold-500);
    transition: background-color 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .notfound-actions a:hover {
    background-color: var(--color-gold-500);
    color: var(--color-navy-950);
  }

  .notfound-actions a:focus-visible {
    outline-color: var(--color-inverse);
  }

  .notfound-actions a:first-child {
    color: var(--color-turquoise-500);
    border-color: var(--color-turquoise-500);
  }

  .notfound-actions a:first-child:hover {
    background-color: var(--color-turquoise-500);
    color: var(--color-navy-950);
  }

  @media (max-width: 14rem) {
    .notfound-panel {
      padding-block: 1.5rem;
    }

    .notfound-code {
      font-size: clamp(2.5rem, 2rem + 8vw, 4rem);
    }

    .notfound-title {
      font-size: 1.125rem;
    }

    .notfound-actions a {
      padding: 0.5rem 0.875rem;
    }
  }
</style>
