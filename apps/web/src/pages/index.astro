---
/* Language Gateway (WF-03) - IA-CONTRACT S1: "/" is NOT a homepage and never
   redirects; it offers both locale roots and nothing else. Standalone document
   (no BaseLayout): the gateway is always-night, so <html> pins
   data-theme="dark" and the ui/Button primitive renders its Dark palette over
   the night canvas. Copy comes only from the content.ts gateway/identity
   strings. Glass panel consumes the shared .glass-surface--dark utility
   (DESIGN-CONTRACT S2b - gateway is one of the two allowed glass surfaces). */
import "../styles/global.css";
import { site } from "../data/site";
import { content } from "../data/content";
import { websiteJsonLd, validateStructuredData } from "../data/structured";
import Button from "../components/ui/Button.astro";

const structured = websiteJsonLd();
validateStructuredData(structured);

const en = content.en;
const fa = content.fa;
const title = en.gateway.title;
const description = `${title} — ${en.gateway.prompt} / ${fa.gateway.prompt}`;
const canonical = new URL("/", site.url).href;

/* WF-09 hero art (README section 3 delivery rule): portal-centered-dark is the
   always-night gateway master (dark-only page -> dark-only art; the light
   companion is generated but unwired - data-theme cannot drive a <picture>,
   see WORK_LOG). Responsive AVIF/WebP srcset from /art-derived/ with the
   lossless 800w PNG as the <img> fallback; decorative per README (empty alt,
   aria-hidden wrapper). This art is the gateway LCP, so it is preloaded
   (AVIF candidates only - every browser that supports imagesrcset also
   supports AVIF) and fetched eagerly. */
const heroBase = "/art-derived/portal-centered-dark";
const heroWidths = [800, 1200, 1600];
const heroSrcset = (ext: string) =>
  heroWidths.map((w) => `${heroBase}-${w}w.${ext} ${w}w`).join(", ");

/* Intrinsic size of public/logo-gateway.png (256x233); attributes reserve the
   box so the panel cannot shift while the image loads. */
const markWidth = 256;
const markHeight = 233;
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mirrors the --canvas-night token; <meta> cannot reference a CSS var. -->
    <meta name="theme-color" content="#071225" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      as="image"
      href={`${heroBase}-800w.png`}
      imagesrcset={heroSrcset("avif")}
      imagesizes="100vw"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", site.url).href} />
    <link rel="alternate" hreflang="fa" href={new URL("/fa/", site.url).href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structured)}
    />
  </head>
  <body class="gateway">
    <a class="skip-link" href="#main">{en.skip}</a>
    <main class="gateway-stage" id="main">
      <div class="gateway-art" aria-hidden="true">
        <picture>
          <source type="image/avif" srcset={heroSrcset("avif")} sizes="100vw" />
          <source type="image/webp" srcset={heroSrcset("webp")} sizes="100vw" />
          <img
            class="gateway-art-image"
            src={`${heroBase}-800w.png`}
            alt=""
            width="1600"
            height="900"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="gateway-art-scrim"></div>
        <div class="gateway-art-fade"></div>
      </div>
      <div class="gateway-panel glass-surface glass-surface--dark">
        <img
          class="gateway-mark"
          src="/logo-gateway.png"
          alt=""
          width={markWidth}
          height={markHeight}
          loading="eager"
        />
        <h1 class="gateway-name">
          <span class="gateway-name-line" lang="en" dir="ltr">{en.name}</span>
          <span class="gateway-name-line" lang="fa" dir="rtl">{fa.name}</span>
        </h1>
        <p class="gateway-kicker">
          <span lang="en" dir="ltr">{en.hero.eyebrow}</span>
          <span aria-hidden="true">·</span>
          <span lang="fa" dir="rtl">{fa.hero.eyebrow}</span>
        </p>
        <p class="gateway-prompt">
          <span lang="en" dir="ltr">{en.gateway.prompt}</span>
          <span aria-hidden="true">/</span>
          <span lang="fa" dir="rtl">{fa.gateway.prompt}</span>
        </p>
        <nav
          class="gateway-actions"
          aria-label={`${en.gateway.prompt} / ${fa.gateway.prompt}`}
        >
          <Button variant="primary" href="/en/">
            {en.gateway.englishLabel}
          </Button>
          <Button variant="secondary" href="/fa/">
            <span lang="fa" dir="rtl">{fa.gateway.persianLabel}</span>
          </Button>
        </nav>
      </div>
    </main>
  </body>
</html>

<style>
  .gateway {
    margin: 0;
    min-height: 100vh;
    min-height: 100svh;
    overflow-x: clip;
    background-color: var(--canvas-night);
    color: var(--ink-hi);
    display: grid;
    place-items: center;
  }

  .gateway-stage {
    position: relative;
    /* Stacking context: the -1 art layer paints above the night canvas but
       below the panel (WF-09). */
    isolation: isolate;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 2rem);
    min-width: 0;
  }

  /* WF-09 hero art: full-bleed portal-centered-dark behind the panel. The
      flat scrim is the token-only veil (works without color-mix); the fade
      adds the seamless canvas-night falloff where color-mix is supported.
      Panel readability rests on the glass opaque fallback (DESIGN-CONTRACT
      2b), not on the blur or the art. */
  .gateway-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .gateway-art-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .gateway-art-scrim {
    position: absolute;
    inset: 0;
    background-color: var(--canvas-night);
    opacity: 0.3;
  }

  .gateway-art-fade {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      180deg,
      color-mix(in srgb, var(--canvas-night) 58%, transparent) 0%,
      color-mix(in srgb, var(--canvas-night) 26%, transparent) 45%,
      var(--canvas-night) 100%
    );
  }

  /* Glass background/border/shadow/blur come from the shared
     .glass-surface--dark utility (global.css, DEBT-0012); navy-900 is its
     opaque fallback when backdrop-filter is unsupported. */
  .gateway-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    width: min(100%, 34rem);
    max-width: 100%;
    min-width: 0;
    margin-block: auto;
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 7vw, 3.5rem) clamp(1.25rem, 6vw, 2.5rem);
  }

  .gateway-mark {
    display: block;
    width: 4.5rem;
    height: auto;
    max-width: 100%;
  }

  .gateway-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: clamp(1.75rem, 1.15rem + 2vw, 2.75rem);
    line-height: 1.2;
    font-weight: 700;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gateway-name-line {
    unicode-bidi: isolate;
  }

  .gateway-name-line[lang="fa"] {
    font-weight: 500;
  }

  .gateway-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin: 0;
    color: var(--brand-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gateway-kicker span {
    unicode-bidi: isolate;
  }

  .gateway-kicker span[lang="fa"] {
    letter-spacing: 0;
  }

  .gateway-prompt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: 0;
    color: var(--ink-mid);
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gateway-prompt span {
    unicode-bidi: isolate;
  }

  .gateway-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 100%;
    min-width: 0;
  }

  @media (max-width: 28rem) {
    .gateway-actions {
      width: min(100%, 18rem);
      flex-direction: column;
    }

    .gateway-actions :global(.ui-button) {
      width: 100%;
    }
  }
</style>
