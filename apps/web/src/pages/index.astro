---
import "../styles/global.css";
import { site } from "../data/site";
import { content } from "../data/content";
import { websiteJsonLd, validateStructuredData } from "../data/structured";
import logoGateway from "../branding/logo-gateway.png";

const structured = websiteJsonLd();
validateStructuredData(structured);

const en = content.en;
const fa = content.fa;
const title = en.gateway.title;
const description = `${title} — ${en.gateway.prompt} / ${fa.gateway.prompt}`;
const canonical = new URL("/", site.url).href;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071225" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", site.url).href} />
    <link rel="alternate" hreflang="fa" href={new URL("/fa/", site.url).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structured)}
    />
  </head>
  <body class="gateway">
    <a class="skip-link" href="#main">{en.skip}</a>
    <main class="gateway-stage" id="main">
      <div class="gateway-panel glass-surface glass-surface--dark">
        <img
          class="gateway-mark"
          src={logoGateway.src}
          alt=""
          width={logoGateway.width}
          height={logoGateway.height}
          loading="eager"
        />
        <h1 class="gateway-name">
          <span class="gateway-name-en" lang="en" dir="ltr">{en.name}</span>
          <span class="gateway-name-fa" lang="fa" dir="rtl">{fa.name}</span>
        </h1>
        <p class="gateway-kicker">
          <span lang="en" dir="ltr">{en.hero.eyebrow}</span>
          <span aria-hidden="true">·</span>
          <span lang="fa" dir="rtl">{fa.hero.eyebrow}</span>
        </p>
        <p class="gateway-prompt">
          <span lang="en" dir="ltr">{en.gateway.prompt}</span>
          <span class="gateway-prompt-divider" aria-hidden="true">/</span>
          <span lang="fa" dir="rtl">{fa.gateway.prompt}</span>
        </p>
        <nav
          class="gateway-actions"
          aria-label={`${en.gateway.prompt} / ${fa.gateway.prompt}`}
        >
          <a class="gateway-action gateway-action--en" href="/en/" hreflang="en" lang="en" dir="ltr">
            {en.gateway.englishLabel}
          </a>
          <a
            class="gateway-action gateway-action--fa"
            href="/fa/"
            hreflang="fa"
            lang="fa"
            dir="rtl"
          >
            {fa.gateway.persianLabel}
          </a>
        </nav>
      </div>
    </main>
  </body>
</html>

<style>
  .gateway {
    margin: 0;
    min-height: 100vh;
    min-height: 100svh;
    overflow-x: clip;
    background-color: var(--canvas-night);
    color: var(--ink-hi);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
  }

  .gateway-stage {
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 4vw, 2rem);
    min-width: 0;
  }

  /* Glass background/border/shadow/blur come from the shared
     .glass-surface--dark utility (global.css, DEBT-0012); navy-900 is its
     opaque fallback when backdrop-filter is unsupported. */
  .gateway-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    width: min(100%, 34rem);
    max-width: 100%;
    min-width: 0;
    margin-block: auto;
    position: relative;
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 7vw, 3.5rem) clamp(1.25rem, 6vw, 2.5rem);
  }

  .gateway-mark {
    display: block;
    width: 4.5rem;
    height: auto;
    max-width: 100%;
  }

  .gateway-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: clamp(1.75rem, 1.15rem + 2vw, 2.75rem);
    line-height: 1.2;
    font-weight: 700;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gateway-name-en,
  .gateway-name-fa {
    unicode-bidi: isolate;
  }

  .gateway-name-fa {
    font-weight: 500;
  }

  /* Gold signature line under the bilingual name — decorative only,
     drawn from ::after so the DOM structure stays unchanged. */
  .gateway-name::after {
    content: "";
    display: block;
    width: clamp(3.5rem, 32%, 6rem);
    height: 2px;
    border-radius: var(--radius-pill);
    background: linear-gradient(
      90deg,
      transparent,
      var(--gold) 30%,
      var(--gold) 70%,
      transparent
    );
    box-shadow: 0 0 12px rgba(227, 185, 92, 0.35);
  }

  .gateway-prompt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: 0;
    color: var(--ink-mid);
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gateway-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--brand-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gateway-kicker span {
    unicode-bidi: isolate;
  }

  .gateway-kicker span[lang="fa"] {
    letter-spacing: 0;
  }

  .gateway-prompt span {
    unicode-bidi: isolate;
  }

  .gateway-prompt-divider {
    color: var(--gold);
    opacity: 0.8;
  }

  .gateway-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 100%;
    min-width: 0;
  }

  /* Language cards — §0 glass recipe: fill + edge, hover brightens the fill
     only so the brand label colors stay AA on night (no color inversion). */
  .gateway-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 7.5rem;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    background-color: var(--glass-fill);
    color: var(--ink-hi);
    border: 1px solid var(--glass-edge);
    text-decoration: none;
    font-weight: 700;
    overflow-wrap: anywhere;
    cursor: pointer;
    transition: background-color var(--duration-night-fast) var(--ease-night),
      border-color var(--duration-night-fast) var(--ease-night);
  }

  .gateway-action:hover,
  .gateway-action:focus-visible {
    background-color: var(--glass-fill-strong);
  }

  .gateway-action--en {
    color: var(--brand-text);
  }

  .gateway-action--fa {
    color: var(--gold);
  }

  .gateway-action:focus-visible {
    outline-color: var(--ink-hi);
    outline-offset: 3px;
  }

  @media (max-width: 28rem) {
    .gateway-actions {
      width: min(100%, 18rem);
      flex-direction: column;
    }

    .gateway-action {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      padding-inline: 1rem;
    }
  }
</style>
