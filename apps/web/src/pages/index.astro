---
import "../styles/global.css";
import { site } from "../data/site";
import { content } from "../data/content";

const en = content.en;
const fa = content.fa;
const title = "Taha Mohammadi · طه محمدی";
const canonical = new URL("/", site.url).href;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071225" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", site.url).href} />
    <link rel="alternate" hreflang="fa" href={new URL("/fa/", site.url).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
  </head>
  <body class="gateway">
    <svg class="gateway-field" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="dot-field" width="28" height="28" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="1.5" fill="rgba(255,255,255,0.10)" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#dot-field)" />
      <line x1="8%" y1="18%" x2="92%" y2="18%" stroke="rgba(22,184,166,0.18)" stroke-width="1" />
      <line x1="18%" y1="8%" x2="18%" y2="92%" stroke="rgba(22,184,166,0.14)" stroke-width="1" />
      <line x1="78%" y1="26%" x2="92%" y2="72%" stroke="rgba(200,155,60,0.14)" stroke-width="1" />
    </svg>
    <main class="gateway-stage">
      <div class="gateway-panel">
        <span class="gateway-mark" aria-hidden="true">TM</span>
        <h1 class="gateway-name">
          <span class="gateway-name-en" lang="en" dir="ltr">Taha Mohammadi</span>
          <span class="gateway-name-fa" lang="fa" dir="rtl">طه محمدی</span>
        </h1>
        <p class="gateway-kicker">
          <span lang="en" dir="ltr">{en.hero.eyebrow}</span>
          <span aria-hidden="true">·</span>
          <span lang="fa" dir="rtl">{fa.hero.eyebrow}</span>
        </p>
        <p class="gateway-prompt">
          <span lang="en" dir="ltr">{en.gateway.prompt}</span>
          <span class="gateway-prompt-divider" aria-hidden="true">/</span>
          <span lang="fa" dir="rtl">{fa.gateway.prompt}</span>
        </p>
        <nav
          class="gateway-actions"
          aria-label={`${en.gateway.prompt} / ${fa.gateway.prompt}`}
        >
          <a class="gateway-action gateway-action--en" href="/en/" hreflang="en" lang="en" dir="ltr">
            {en.gateway.englishLabel}
          </a>
          <a
            class="gateway-action gateway-action--fa"
            href="/fa/"
            hreflang="fa"
            lang="fa"
            dir="rtl"
          >
            {fa.gateway.persianLabel}
          </a>
        </nav>
      </div>
    </main>
  </body>
</html>

<style>
  .gateway {
    margin: 0;
    min-height: 100svh;
    overflow: hidden;
    background-color: var(--color-navy-950);
    color: #fff;
    display: grid;
    place-items: center;
  }

  .gateway-field {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.82;
  }

  .gateway-stage {
    width: 100%;
    min-height: 100svh;
    display: grid;
    place-items: center;
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .gateway-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    width: min(100%, 34rem);
    position: relative;
    background-color: rgba(11, 22, 48, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 7vw, 3.5rem) clamp(1.25rem, 6vw, 2.5rem);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.24);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    backdrop-filter: blur(16px) saturate(120%);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .gateway-panel {
      background-color: var(--color-navy-900);
    }
  }

  .gateway-mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background-color: var(--color-turquoise-500);
    color: var(--color-navy-950);
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1.25rem;
  }

  .gateway-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: clamp(1.75rem, 1.15rem + 2vw, 2.75rem);
    line-height: 1.2;
    font-weight: 700;
  }

  .gateway-name-en,
  .gateway-name-fa {
    unicode-bidi: isolate;
  }

  .gateway-name-fa {
    font-weight: 500;
  }

  .gateway-prompt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
  }

  .gateway-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--color-turquoise-500);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gateway-kicker span {
    unicode-bidi: isolate;
  }

  .gateway-kicker span[lang="fa"] {
    letter-spacing: 0;
  }

  .gateway-prompt span {
    unicode-bidi: isolate;
  }

  .gateway-prompt-divider {
    color: var(--color-gold-500);
    opacity: 0.8;
  }

  .gateway-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .gateway-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 7.5rem;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.04);
    color: #fff;
    border: 1px solid transparent;
    text-decoration: none;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gateway-action:hover {
    color: var(--color-navy-950);
  }

  .gateway-action--en {
    color: var(--color-turquoise-500);
    border-color: var(--color-turquoise-500);
  }

  .gateway-action--en:hover {
    background-color: var(--color-turquoise-500);
  }

  .gateway-action--fa {
    color: var(--color-gold-500);
    border-color: var(--color-gold-500);
  }

  .gateway-action--fa:hover {
    background-color: var(--color-gold-500);
  }

  @media (max-width: 28rem) {
    .gateway-actions {
      width: min(100%, 18rem);
      flex-direction: column;
    }

    .gateway-action {
      width: 100%;
    }
  }
</style>
