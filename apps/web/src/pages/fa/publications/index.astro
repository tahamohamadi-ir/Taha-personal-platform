---
/* WF-07B adoption: publications index onto CollectionIndexTemplate (frozen
   route-map family "publications"). Rows render through content/
   PublicationRow (citation-first; unverified venue/date omit themselves)
   wrapped in the canonical /publications/{slug}/ detail link so the p8
   API-count == dist-links parity holds. Zero publications renders the
   honest ui/ContentState empty panel with the family next-action note.
   The filters/pagination slots stay unfilled: this catalog has no filter
   controls and no pagination to preserve. Copy from the locale dictionary. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CollectionIndexTemplate from "../../../layouts/CollectionIndexTemplate.astro";
import SectionLead from "../../../components/content/SectionLead.astro";
import PublicationRow from "../../../components/content/PublicationRow.astro";
import ContentState from "../../../components/ui/ContentState.astro";
import { content } from "../../../data/content";
import { isCmsOriginBuild } from "../../../lib/cms/client";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getPublications } from "../../../lib/cms/publications";

const locale = "fa" as const;
const pageContent = content[locale];
const catalog = pageContent.catalog;
const publications = await getPublications(locale);

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: catalog.publicationsHeading, path: `/${locale}/publications/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout cmsBuildOrigin={isCmsOriginBuild() ? "cms" : "snapshot"}
  content={{
    ...pageContent,
    meta: {
      title: `${catalog.publicationsHeading} \u2014 ${pageContent.name}`,
      description: catalog.publicationsIntro,
    },
  }}
  alternateHref="/en/publications/"
>
  {
    structured.map((block) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={jsonLdScriptContent(block)}
      />
    ))
  }
  <CollectionIndexTemplate>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: catalog.publicationsHeading },
      ]}
    />
    <SectionLead
      slot="sectionLead"
      as="h1"
      heading={catalog.publicationsHeading}
      summary={catalog.publicationsIntro}
    />
    <div slot="results">
      {
        publications.length === 0 ? (
          <ContentState kind="empty" explanation={catalog.publicationsEmpty}>
            <p slot="action">{catalog.emptyNextAction}</p>
          </ContentState>
        ) : (
          publications.map((pub) => (
            <a
              class="publication-row-link"
              href={`/${locale}/publications/${pub.slug}/`}
            >
              <PublicationRow
                title={pub.title}
                authors={pub.authors ? [pub.authors] : []}
                venue={pub.venue || undefined}
                date={pub.date ?? undefined}
              />
            </a>
          ))
        )
      }
    </div>
  </CollectionIndexTemplate>
</BaseLayout>

<style>
  .publication-row-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .publication-row-link:hover :global(.content-publication__title) {
    color: var(--color-brand);
  }
</style>
