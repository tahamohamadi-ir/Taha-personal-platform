---
/* WF-07D: creative detail adopted onto EvidenceDetailTemplate. Lead =
   SectionLead as="h1"; metadata = MetadataGroup over creator/role/date/
   license/rights (absent loader fields are omitted, never stubbed); media
   slot = cover MediaTile + gallery wired to the shared native <dialog>
   Lightbox (focus-trap, Esc, reduced-motion; no-JS keeps direct file
   links); access_state gates the asset - a restricted work renders the
   honest unavailable note and never cover/gallery/body. Related = real
   sibling creative works from the CMS loader. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import EvidenceDetailTemplate from "../../../layouts/EvidenceDetailTemplate.astro";
import SectionLead from "../../../components/content/SectionLead.astro";
import MetadataGroup from "../../../components/content/MetadataGroup.astro";
import MediaTile from "../../../components/content/MediaTile.astro";
import ContentRow from "../../../components/content/ContentRow.astro";
import ContentState from "../../../components/ui/ContentState.astro";
import Lightbox from "../../../components/Lightbox.astro";
import { content } from "../../../data/content";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getCreativeWork, getCreativeWorks } from "../../../lib/cms/creative";

export async function getStaticPaths() {
  const locale = "fa" as const;
  const items = await getCreativeWorks(locale);
  return items.map((item) => ({ params: { slug: item.slug } }));
}

const locale = "fa" as const;
const pageContent = content[locale];
const t = pageContent.creative;
const slug = Astro.params.slug as string;
const work = await getCreativeWork(locale, slug);
if (!work) return Astro.redirect(`/${locale}/creative/`, 302);

const alternateExists = (await getCreativeWork("en", slug)) !== null;
const isRestricted = work.access_state !== "public";
const hasCover = !isRestricted && Boolean(work.cover?.url);
const hasGallery = !isRestricted && work.gallery.length > 0;
const hasMedia = hasCover || hasGallery;
const related = (await getCreativeWorks(locale))
  .filter((item) => item.slug !== work.slug)
  .slice(0, 3);

const metadata = [
  { label: t.creatorLabel, value: work.creator_name },
  { label: t.roleLabel, value: work.creator_role },
  { label: t.dateLabel, value: work.creation_date ?? "" },
  { label: t.licenseLabel, value: work.license },
  { label: t.rightsLabel, value: work.rights_statement },
];

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: t.heading, path: `/${locale}/creative/` },
    { name: work.title, path: `/${locale}/creative/${work.slug}/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout
  content={{
    ...pageContent,
    meta: { title: `${work.title} — ${pageContent.name}`, description: work.description || t.intro },
  }}
  alternateHref={alternateExists ? `/en/creative/${work.slug}/` : null}
>
  {structured.map((block) => <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(block)} />)}
  <EvidenceDetailTemplate>
    <Breadcrumbs slot="breadcrumbs" items={[{ label: pageContent.name, href: `/${locale}/` }, { label: t.heading, href: `/${locale}/creative/` }, { label: work.title }]} />
    <Fragment slot="lead">
      <SectionLead as="h1" heading={work.title} summary={work.description || undefined} />
      {!alternateExists && <ContentState kind="unavailable-translation" explanation={t.missingTranslation} />}
      {isRestricted && <p class="creative-unavailable" role="status">{t.restrictedNote}</p>}
    </Fragment>
    <MetadataGroup slot="metadata" items={metadata} />
    {
      hasMedia && (
        <Fragment slot="media">
          {hasCover && work.cover?.url && (
            <MediaTile
              variant="lead"
              src={work.cover.url}
              alt={work.cover.alt}
              width={4}
              height={3}
              caption={work.title}
              record={{ href: `/${locale}/creative/${work.slug}/`, label: work.title }}
            />
          )}
          {hasGallery && (
            <>
              <h2>{t.galleryLabel}</h2>
              <div class="creative-gallery">
                {work.gallery.map((img) => (
                  <figure class="creative-gallery__item">
                    <a href={img.url} data-lightbox data-lightbox-alt={img.alt}>
                      <img src={img.url} alt={img.alt} loading="lazy" decoding="async" />
                    </a>
                    {img.caption && <figcaption>{img.caption}</figcaption>}
                  </figure>
                ))}
              </div>
              <Lightbox />
            </>
          )}
        </Fragment>
      )
    }
    <Fragment slot="body">
      {!isRestricted && work.body && <div set:html={work.body} />}
    </Fragment>
    {
      !isRestricted && work.accessibility_notes && (
        <Fragment slot="limitations">
          <h2>{t.accessibilityLabel}</h2>
          <p>{work.accessibility_notes}</p>
        </Fragment>
      )
    }
    <Fragment slot="related">
      {related.map((item) => (
        <ContentRow title={item.title} href={`/${locale}/creative/${item.slug}/`} />
      ))}
      <p><a href={`/${locale}/contact/`}>{pageContent.contact.heading}</a></p>
    </Fragment>
  </EvidenceDetailTemplate>
</BaseLayout>

<style>
  .creative-gallery {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(var(--space-24), 1fr));
  }

  .creative-gallery__item {
    margin: 0;
  }

  .creative-gallery__item figcaption {
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
  }

  .creative-gallery :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
