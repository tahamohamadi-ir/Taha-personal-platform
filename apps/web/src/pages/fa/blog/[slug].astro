---
import {
  getPublishedArticles,
  getArticleRedirects,
} from "../../../lib/cms/articles";

export async function getStaticPaths() {
  const locale = "fa" as const;
  const articles = await getPublishedArticles(locale);
  const redirects = await getArticleRedirects(locale);
  return [
    ...articles.map((article) => ({ params: { slug: article.slug } })),
    ...redirects
      .filter((r) => !articles.some((a) => a.slug === r.old_slug))
      .map((r) => ({ params: { slug: r.old_slug } })),
  ];
}

const slug = Astro.params.slug as string;
return Astro.redirect("/fa/writing/" + slug + "/", 301);
---
