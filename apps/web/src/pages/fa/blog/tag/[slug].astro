---
import { getTopicTags } from "../../../../lib/cms/articles";

export async function getStaticPaths() {
  const locale = "fa" as const;
  const items = await getTopicTags(locale);
  return items.map((item) => ({ params: { slug: item.slug } }));
}

const slug = Astro.params.slug as string;
return Astro.redirect("/fa/writing/tag/" + slug + "/", 301);
---
