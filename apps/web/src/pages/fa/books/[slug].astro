---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/blog/Breadcrumbs.astro";
import { content } from "../../../data/content";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getBooks, getBook } from "../../../lib/cms/publications";

export async function getStaticPaths() {
  const locale = "fa" as const;
  const items = await getBooks(locale);
  return items.map((item) => ({ params: { slug: item.slug } }));
}

const locale = "fa" as const;
const pageContent = content[locale];
const catalog = pageContent.catalog;
const slug = Astro.params.slug as string;
const item = await getBook(locale, slug);
if (!item) {
  return Astro.redirect(`/${locale}/books/`, 302);
}
const alt = "en" as const;
const alternateExists = (await getBook(alt, item.slug)) !== null;

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: catalog.booksHeading, path: `/${locale}/books/` },
    { name: item.title, path: `/${locale}/books/${item.slug}/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${item.title} — ${pageContent.name}`,
      description: catalog.booksIntro,
    },
  }}
  alternateHref={alternateExists ? `/${alt}/books/${item.slug}/` : null}
>
  {structured.map((block) => (
    <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(block)} />
  ))}
  <section class="catalog-page">
    <Breadcrumbs items={[
      { label: pageContent.name, href: `/${locale}/` },
      { label: catalog.booksHeading, href: `/${locale}/books/` },
      { label: item.title },
    ]} />
    {!alternateExists && <p class="missing">{catalog.missingTranslation}</p>}
    <h1>{item.title}</h1>
    
    {item.authors && <p class="meta">{item.authors}</p>}
    {(item.publisher || item.publication_date) && (
      <p class="meta">{[item.publisher, item.publication_date].filter(Boolean).join(" · ")}</p>
    )}
    {item.isbn && <p class="meta">ISBN: {item.isbn}</p>}
    <p class="meta">{catalog.licenseLabel}: {item.license}</p>
    {item.description && <p>{item.description}</p>}
    {item.url && <p><a href={item.url} rel="noopener noreferrer">{item.url}</a></p>}
    {item.cover?.url ? (
      <p><img src={item.cover.url} alt={item.cover.alt || item.title} /></p>
    ) : item.access_state !== "public" ? (
      <p class="meta">{catalog.restrictedNote}</p>
    ) : null}

    <p><a href={`/${locale}/books/`}>{catalog.booksHeading}</a></p>
  </section>
</BaseLayout>

<style>
  .catalog-page { max-width: 44rem; margin-inline: auto; padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 2.5rem) 3rem; }
  .catalog-page h1 { font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.4rem); margin: 0 0 0.5rem; }
  .catalog-page h2 { font-family: var(--font-display); font-size: 1.2rem; margin: 1.5rem 0 0.5rem; }
  .meta, .missing { color: var(--color-ink-muted); }
</style>
