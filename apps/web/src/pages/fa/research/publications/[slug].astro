---
/** Permanent redirect: research-nested publication URL → canonical publications detail. */
import { getPublications } from "../../../../lib/cms/publications";

export async function getStaticPaths() {
  const publications = await getPublications("fa");
  return publications.map((pub) => ({ params: { slug: pub.slug } }));
}

return Astro.redirect(`/fa/publications/${Astro.params.slug}/`, 301);
---
