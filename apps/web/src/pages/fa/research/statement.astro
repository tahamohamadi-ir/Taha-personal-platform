---
/* WF-07B adoption: research statement onto LongFormTemplate (frozen
   route-map family "research statement"). The prose/statement body keeps
   its published-story projection and the PDF link fields; the honest-empty
   ContentState renders when no statement is published. The related close
   reuses the family contact note (IA-CONTRACT S6: a detail page never
   ends with only the footer). All copy comes from the locale dictionary. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import LongFormTemplate from "../../../layouts/LongFormTemplate.astro";
import SectionLead from "../../../components/content/SectionLead.astro";
import ContentState from "../../../components/ui/ContentState.astro";
import { content } from "../../../data/content";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getResearchStatement } from "../../../lib/cms/research";
import StoryBody from "../../../components/StoryBody.astro";
import { hasPublishedStory } from "../../../lib/cms/story";

const locale = "fa" as const;
const pageContent = content[locale];
const research = pageContent.research;
const statement = await getResearchStatement(locale);

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: research.heading, path: `/${locale}/research/` },
    { name: research.statementHeading, path: `/${locale}/research/statement/` },
  ]),
];
validateStructuredData(...structured);

const title = statement?.title ?? research.statementHeading;
const description = statement
  ? statement.body.replace(/<[^>]+>/g, " ").trim().slice(0, 160)
  : research.statementEmpty;
const statementHasStory = hasPublishedStory(statement?.story);
const pdf = statement?.statement_pdf ?? null;

function formatBytes(n: number | undefined): string {
  if (!n || n <= 0) return "";
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / (1024 * 1024)).toFixed(1)} MB`;
}
---

<BaseLayout
  content={{
    ...pageContent,
    meta: { title: `${title} \u2014 ${pageContent.name}`, description },
  }}
  alternateHref="/en/research/statement/"
>
  <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(structured[0])} />
  <LongFormTemplate>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: research.heading, href: `/${locale}/research/` },
        { label: research.statementHeading },
      ]}
    />
    <div slot="articleLead">
      <SectionLead as="h1" heading={title} />
      {
        pdf?.url && (
          <p class="statement-pdf">
            <a href={pdf.url} download rel="noopener">
              {pageContent.downloads.downloadLabel}
              {pdf.title ? `: ${pdf.title}` : ""}
            </a>
            {
              (pdf.mime || pdf.size) && (
                <span class="statement-pdf-meta">
                  {" "}
                  ({[pdf.mime, formatBytes(pdf.size)].filter(Boolean).join(" \u00b7 ")})
                </span>
              )
            }
          </p>
        )
      }
    </div>
    <div slot="body" class="statement-body">
      {
        statement ? (
          statementHasStory && statement.story ? (
            <StoryBody locale={locale} story={statement.story} />
          ) : (
            <div set:html={statement.body} />
          )
        ) : (
          <ContentState kind="empty" explanation={research.statementEmpty} />
        )
      }
    </div>
    <div slot="related" class="statement-related">
      <p class="statement-contact-note">
        <a href={`/${locale}/about/`}>{pageContent.about.heading}</a>
        {" \u2014 "}
        {research.contactNote}
      </p>
    </div>
  </LongFormTemplate>
</BaseLayout>

<style>
  .statement-pdf {
    margin: var(--space-4) 0 0;
  }
  .statement-pdf-meta {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .statement-contact-note {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .statement-body :global(p) {
    margin: 0 0 var(--space-4);
    line-height: 1.7;
  }
</style>
