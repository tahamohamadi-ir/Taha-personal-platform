---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { content } from "../../../data/content";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getCourse, getCourses } from "../../../lib/cms/courses";

export async function getStaticPaths() {
  const locale = "fa" as const;
  const items = await getCourses(locale);
  return items.map((item) => ({ params: { slug: item.slug } }));
}

const locale = "fa" as const;
const pageContent = content[locale];
const t = pageContent.teaching;
const slug = Astro.params.slug as string;
const course = await getCourse(locale, slug);
if (!course) return Astro.redirect(`/${locale}/teaching/`, 302);

const alternateExists = (await getCourse("en", slug)) !== null;
const prerequisitesDisplay = (course.prerequisites || "").trim() || t.noPrerequisites;
const isUnavailable = ["private", "not_available", "restricted"].includes(course.availability);
const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: t.heading, path: `/${locale}/teaching/` },
    { name: course.title, path: `/${locale}/teaching/${course.slug}/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${course.title} — ${pageContent.name}`,
      description: course.description || t.intro,
    },
  }}
  alternateHref={alternateExists ? `/en/teaching/${course.slug}/` : null}
>
  {structured.map((block) => <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(block)} />)}
  <section class="catalog-page">
    <Breadcrumbs items={[{ label: pageContent.name, href: `/${locale}/` }, { label: t.heading, href: `/${locale}/teaching/` }, { label: course.title }]} />
    {!alternateExists && <p class="missing">{t.missingTranslation}</p>}
    <h1>{course.title}</h1>
    {course.description && <p class="lead">{course.description}</p>}
    {course.cover?.url && <img src={course.cover.url} alt={course.cover.alt} loading="lazy" style="max-width:100%;border-radius:8px;margin:1rem 0" />}

    <dl class="meta-grid">
      <dt>{t.levelLabel}</dt><dd>{course.level}</dd>
      <dt>{t.formatLabel}</dt><dd>{course.course_format}</dd>
      <dt>{t.languageLabel}</dt><dd>{course.course_language}</dd>
      <dt>{t.availabilityLabel}</dt><dd>{course.availability}</dd>
      <dt>{t.licenseLabel}</dt><dd>{course.license}</dd>
      {course.last_updated && <><dt>{t.lastUpdatedLabel}</dt><dd>{course.last_updated}</dd></>}
    </dl>

    {isUnavailable && <p class="unavailable" role="status">{t.unavailableNote}</p>}

    <h2>{t.prerequisitesLabel}</h2>
    <p>{prerequisitesDisplay}</p>

    {course.outcomes && (
      <>
        <h2>{t.outcomesLabel}</h2>
        <p style="white-space:pre-wrap">{course.outcomes}</p>
      </>
    )}

    {course.body && <div class="body" set:html={course.body} />}

    {course.accessibility_notes && (
      <>
        <h2>{t.accessibilityLabel}</h2>
        <p class="meta">{course.accessibility_notes}</p>
      </>
    )}

    <p class="meta">هیچ سامانهٔ LMS، ثبت‌نام یا پرداختی ارائه نمی‌شود.</p>
    <p><a href={`/${locale}/teaching/`}>{t.heading}</a> · <a href={`/${locale}/contact/`}>{pageContent.contact.heading}</a></p>
  </section>
</BaseLayout>

<style>
  .catalog-page { max-width: 44rem; margin-inline: auto; padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 2.5rem) 3rem; }
  .catalog-page h1 { font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.4rem); margin: 0 0 0.5rem; }
  .catalog-page h2 { font-family: var(--font-display); font-size: 1.2rem; margin: 1.5rem 0 0.5rem; }
  .lead, .meta, .missing { color: var(--color-ink-muted); }
  .unavailable { color: #92400e; background: #fef3c7; padding: 0.75rem; border-radius: 0.5rem; }
  .meta-grid { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; margin: 1rem 0; }
  .meta-grid dt { font-weight: 600; }
</style>
