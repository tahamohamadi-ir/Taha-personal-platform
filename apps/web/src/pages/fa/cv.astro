---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Downloads from "../../components/Downloads.astro";
import { content } from "../../data/content";
import { resolveCvDownloadFiles } from "../../data/cvDownloads";

const fa = content.fa;
const files = await resolveCvDownloadFiles("fa");
---

<BaseLayout content={fa} alternateHref="/en/cv/">
  <Downloads content={fa} files={files} />
</BaseLayout>
