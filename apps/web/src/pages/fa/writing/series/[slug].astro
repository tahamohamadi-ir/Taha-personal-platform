---
/* WF-07E adoption: writing series page onto EditorialIndexTemplate (frozen
   route-map family "writing series"). Results are ContentRow rows from the
   existing series loader helpers; the loader exposes no featured flag, no
   pagination and the family had no filter controls, so the featured slot
   and the filters slot stay honestly unfilled - nothing is invented. The
   date label reuses the existing generic dictionary value from the
   projects namespace (the blog namespace carries no date label today).
   All copy comes from the locale dictionary. */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import EditorialIndexTemplate from "../../../../layouts/EditorialIndexTemplate.astro";
import SectionLead from "../../../../components/content/SectionLead.astro";
import ContentRow from "../../../../components/content/ContentRow.astro";
import ContentState from "../../../../components/ui/ContentState.astro";
import { content } from "../../../../data/content";
import { formatDate } from "../../../../lib/format";
import {
  articlesForSeries,
  getPublishedArticles,
  getPublishedSeries,
} from "../../../../lib/cms/articles";

export async function getStaticPaths() {
  const locale = "fa" as const;
  const seriesList = await getPublishedSeries(locale);
  return seriesList.map((series) => ({
    params: { slug: series.slug },
    props: { series },
  }));
}

const locale = "fa" as const;
const pageContent = content[locale];
const blog = pageContent.blog;
const { series } = Astro.props;
const articles = articlesForSeries(await getPublishedArticles(locale), series.slug);
const dateLabel = pageContent.projects.dateLabel;
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${series.title} — ${blog.heading}`,
      description: series.description || blog.intro,
    },
  }}
  alternateHref={`/en/writing/series/${series.slug}/`}
>
  <EditorialIndexTemplate>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: blog.heading, href: `/${locale}/writing/` },
        { label: series.title },
      ]}
    />
    <SectionLead
      slot="sectionLead"
      as="h1"
      heading={series.title}
      summary={series.description || undefined}
    />
    {
      articles.length === 0 ? (
        <ContentState slot="results" kind="empty" explanation={blog.empty} />
      ) : (
        <div slot="results">
          {articles.map((article) => (
            <ContentRow
              title={article.title}
              href={`/${locale}/writing/${article.slug}/`}
              excerpt={article.excerpt}
              metadata={
                article.published_at
                  ? [{ label: dateLabel, value: formatDate(article.published_at, locale) }]
                  : undefined
              }
              tags={article.topic_tags.map((tag) => tag.name)}
            />
          ))}
        </div>
      )
    }
  </EditorialIndexTemplate>
</BaseLayout>
