---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/blog/Breadcrumbs.astro";
import ProjectsCatalog from "../../../components/ProjectsCatalog.astro";
import { content } from "../../../data/content";
import { isCmsOriginBuild } from "../../../lib/cms/client";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getProjects } from "../../../lib/cms/projects";

const locale = "en" as const;
const pageContent = content[locale];
const projectsCopy = pageContent.projects;
const projects = await getProjects(locale);

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: projectsCopy.heading, path: `/${locale}/projects/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout cmsBuildOrigin={isCmsOriginBuild() ? "cms" : "snapshot"}
  content={{
    ...pageContent,
    meta: {
      title: `${projectsCopy.heading} — ${pageContent.name}`,
      description: projectsCopy.intro,
    },
  }}
  alternateHref="/fa/projects/"
>
  <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(structured[0])} />
  <section class="projects-page">
    <Breadcrumbs
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: projectsCopy.heading },
      ]}
    />
    <h1>{projectsCopy.heading}</h1>
    <p class="lead">{projectsCopy.intro}</p>
    <ProjectsCatalog locale={locale} content={pageContent} projects={projects} />
  </section>
</BaseLayout>

<style>
  .projects-page {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 2.5rem) 3rem;
  }
  .projects-page h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin: 0 0 0.5rem;
  }
  .lead {
    color: var(--color-ink-muted);
  }
</style>
