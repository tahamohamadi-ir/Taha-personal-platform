---
/* WF-07B adoption: research index onto CollectionIndexTemplate (frozen
   route-map family "research"). Results render through content/ContentRow
   rows built from the existing research loaders; the URL-driven type/sort
   filter markup is preserved inside the filters slot; topics are linked as
   taxonomy Chip links (no raster graph). Zero records renders the honest
   ui/ContentState empty panel. All copy comes from the locale dictionary. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CollectionIndexTemplate from "../../../layouts/CollectionIndexTemplate.astro";
import SectionLead from "../../../components/content/SectionLead.astro";
import ContentRow from "../../../components/content/ContentRow.astro";
import Chip from "../../../components/ui/Chip.astro";
import ContentState from "../../../components/ui/ContentState.astro";
import ResearchGraph from "../../../components/research/ResearchGraph.astro";
import { content } from "../../../data/content";
import { isCmsOriginBuild } from "../../../lib/cms/client";
import { getResearchGraph } from "../../../lib/cms/research-graph";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import {
  getResearchProjects,
  getResearchPublications,
  getResearchStatement,
  getResearchTopics,
} from "../../../lib/cms/research";

const locale = "en" as const;
const pageContent = content[locale];
const research = pageContent.research;
const topics = await getResearchTopics(locale);
const projects = await getResearchProjects(locale);
const publications = await getResearchPublications(locale);
const statement = await getResearchStatement(locale);
/* WF-08: the relationship graph renders from the BK-05 published payload;
   null/empty omits the section honestly. */
const graph = await getResearchGraph(locale);
const empty =
  topics.length === 0 &&
  projects.length === 0 &&
  publications.length === 0 &&
  !statement;

type Kind = "statement" | "topic" | "project" | "publication";

interface IndexCard {
  kind: Kind;
  kindLabel: string;
  title: string;
  excerpt: string;
  href: string;
  publishedAt: string | null;
  sortKey: string;
}

function excerptFrom(text: string, max = 180): string {
  const clean = text.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
  if (clean.length <= max) return clean;
  return `${clean.slice(0, max).trimEnd()}\u2026`;
}

const kindLabels: Record<Kind, string> = {
  statement: research.statementHeading,
  topic: research.topicsHeading,
  project: research.projectsHeading,
  publication: research.publicationsHeading,
};

const cards: IndexCard[] = [];

if (statement) {
  cards.push({
    kind: "statement",
    kindLabel: kindLabels.statement,
    title: statement.title,
    excerpt: excerptFrom(statement.body),
    href: `/${locale}/research/statement/`,
    publishedAt: statement.published_at,
    sortKey: `0-${statement.title}`,
  });
}

for (const topic of topics) {
  cards.push({
    kind: "topic",
    kindLabel: kindLabels.topic,
    title: topic.title,
    excerpt: excerptFrom(topic.summary),
    href: `/${locale}/research/topics/${topic.slug}/`,
    publishedAt: topic.published_at,
    sortKey: `1-${topic.title}`,
  });
}

for (const project of projects) {
  cards.push({
    kind: "project",
    kindLabel: kindLabels.project,
    title: project.title,
    excerpt: excerptFrom(project.objective),
    href: `/${locale}/research/projects/${project.slug}/`,
    publishedAt: project.published_at,
    sortKey: `2-${project.title}`,
  });
}

for (const pub of publications) {
  const byline = [pub.authors, pub.venue].filter(Boolean).join(" \u2014 ");
  cards.push({
    kind: "publication",
    kindLabel: kindLabels.publication,
    title: pub.title,
    excerpt: excerptFrom(byline),
    href: `/${locale}/publications/${pub.slug}/`,
    publishedAt: pub.published_at,
    sortKey: `3-${pub.title}`,
  });
}

cards.sort((a, b) => a.sortKey.localeCompare(b.sortKey, locale));

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: research.heading, path: `/${locale}/research/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout cmsBuildOrigin={isCmsOriginBuild() ? "cms" : "snapshot"}
  content={{
    ...pageContent,
    meta: {
      title: `${research.heading} \u2014 ${pageContent.name}`,
      description: research.intro,
    },
  }}
  alternateHref="/fa/research/"
>
  <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(structured[0])} />
  <CollectionIndexTemplate>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: research.heading },
      ]}
    />
    <SectionLead
      slot="sectionLead"
      as="h1"
      heading={research.heading}
      summary={research.intro}
    />
    {
      !empty && (
        <div slot="filters" class="research-filters" data-research-filters>
          <div class="research-toolbar">
            <label class="research-control">
              <span>{research.filterLabel}</span>
              <select data-research-filter>
                <option value="all">{research.filterAll}</option>
                <option value="statement">{research.statementHeading}</option>
                <option value="topic">{research.topicsHeading}</option>
                <option value="project">{research.projectsHeading}</option>
                <option value="publication">{research.publicationsHeading}</option>
              </select>
            </label>
            <label class="research-control">
              <span>{research.sortLabel}</span>
              <select data-research-sort>
                <option value="kind">{research.sortKind}</option>
                <option value="title">{research.sortTitle}</option>
                <option value="newest">{research.sortNewest}</option>
              </select>
            </label>
          </div>
          {topics.length > 0 && (
            <nav class="research-topic-chips" aria-label={research.topicsHeading}>
              {topics.map((topic) => (
                <a href={`/${locale}/research/topics/${topic.slug}/`}>
                  <Chip variant="taxonomy">{topic.title}</Chip>
                </a>
              ))}
            </nav>
          )}
        </div>
      )
    }
    <div slot="results">
      <div data-research-list>
        {
          empty ? (
            <ContentState kind="empty" explanation={research.empty} />
          ) : (
            cards.map((card) => (
              <div
                data-research-item
                data-kind={card.kind}
                data-title={card.title}
                data-published={card.publishedAt ?? ""}
                data-sort-key={card.sortKey}
              >
                <ContentRow
                  type={card.kindLabel}
                  title={card.title}
                  href={card.href}
                  excerpt={card.excerpt}
                />
              </div>
            ))
          )
        }
        <p class="research-contact-note">
          <a href={`/${locale}/about/`}>{pageContent.about.heading}</a>
          {" \u2014 "}
          {research.contactNote}
        </p>
      </div>
      {
        graph && graph.nodes.length > 0 && (
          <ResearchGraph graph={graph} heading={research.relatedHeading} />
        )
      }
    </div>
  </CollectionIndexTemplate>
</BaseLayout>

<script>
  const list = document.querySelector<HTMLElement>("[data-research-list]");
  const filter = document.querySelector<HTMLSelectElement>("[data-research-filter]");
  const sort = document.querySelector<HTMLSelectElement>("[data-research-sort]");
  if (list && filter && sort) {
    const items = Array.from(
      list.querySelectorAll<HTMLElement>(":scope > [data-research-item]"),
    );

    const apply = () => {
      const kind = filter.value;
      const mode = sort.value;
      const visible = items.filter((item) => {
        const match = kind === "all" || item.dataset.kind === kind;
        item.hidden = !match;
        return match;
      });

      visible.sort((a, b) => {
        if (mode === "title") {
          return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", undefined, {
            sensitivity: "base",
          });
        }
        if (mode === "newest") {
          return (b.dataset.published ?? "").localeCompare(a.dataset.published ?? "");
        }
        return (a.dataset.sortKey ?? "").localeCompare(b.dataset.sortKey ?? "");
      });

      for (const item of visible) {
        list.appendChild(item);
      }
    };

    const params = new URLSearchParams(window.location.search);
    const typeFromUrl = params.get("type");
    const sortFromUrl = params.get("sort");
    if (typeFromUrl && [...filter.options].some((o) => o.value === typeFromUrl)) {
      filter.value = typeFromUrl;
    }
    if (sortFromUrl && [...sort.options].some((o) => o.value === sortFromUrl)) {
      sort.value = sortFromUrl;
    }

    const syncUrl = () => {
      const next = new URLSearchParams(window.location.search);
      if (filter.value && filter.value !== "all") next.set("type", filter.value);
      else next.delete("type");
      const defaultSort = sort.options[0]?.value ?? "";
      if (sort.value && sort.value !== defaultSort) next.set("sort", sort.value);
      else next.delete("sort");
      const qs = next.toString();
      const url = qs
        ? `${window.location.pathname}?${qs}${window.location.hash}`
        : `${window.location.pathname}${window.location.hash}`;
      window.history.replaceState({}, "", url);
    };

    const applyAndSync = () => {
      apply();
      syncUrl();
    };

    filter.addEventListener("change", applyAndSync);
    sort.addEventListener("change", applyAndSync);
    apply();
  }
</script>

<style>
  .research-filters {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .research-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
  }
  .research-control {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-secondary);
  }
  .research-control select {
    min-height: var(--space-11);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }
  .research-topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .research-topic-chips a {
    text-decoration: none;
  }
  .research-contact-note {
    margin: var(--space-6) 0 0;
    color: var(--color-ink-secondary);
  }
</style>
