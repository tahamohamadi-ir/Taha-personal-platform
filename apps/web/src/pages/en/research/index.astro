---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/blog/Breadcrumbs.astro";
import ResearchCatalog from "../../../components/ResearchCatalog.astro";
import ResearchGraphSection from "../../../components/research/ResearchGraphSection.astro";
import { content } from "../../../data/content";
import { isCmsOriginBuild } from "../../../lib/cms/client";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getResearchGraph } from "../../../lib/cms/research-graph";
import {
  getResearchProjects,
  getResearchPublications,
  getResearchStatement,
  getResearchTopics,
} from "../../../lib/cms/research";

const locale = "en" as const;
const pageContent = content[locale];
const research = pageContent.research;
const topics = await getResearchTopics(locale);
const projects = await getResearchProjects(locale);
const publications = await getResearchPublications(locale);
const statement = await getResearchStatement(locale);
const graph = await getResearchGraph(locale);
const empty =
  topics.length === 0 &&
  projects.length === 0 &&
  publications.length === 0 &&
  !statement;

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: research.heading, path: `/${locale}/research/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout cmsBuildOrigin={isCmsOriginBuild() ? "cms" : "snapshot"}
  content={{
    ...pageContent,
    meta: {
      title: `${research.heading} — ${pageContent.name}`,
      description: research.intro,
    },
  }}
  alternateHref="/fa/research/"
>
  <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(structured[0])} />
  <section class="research-page">
    <Breadcrumbs
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: research.heading },
      ]}
    />
    <h1>{research.heading}</h1>
    <p class="lead">{research.intro}</p>
    {graph ? <ResearchGraphSection graph={graph} content={pageContent} /> : null}
    {
      empty ? (
        <p class="empty">{research.empty}</p>
      ) : (
        <ResearchCatalog
          locale={locale}
          content={pageContent}
          statement={statement}
          topics={topics}
          projects={projects}
          publications={publications}
        />
      )
    }
    <p class="contact-note">
      <a href={`/${locale}/about/`}>{pageContent.about.heading}</a>
      {" — "}
      {research.contactNote}
    </p>
  </section>
</BaseLayout>

<style>
  .research-page {
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
    padding-block: 3rem 4rem;
    padding-inline: clamp(1rem, 5vw, 2.5rem);
  }
  .research-page h1 {
    margin: 0;
    font-size: clamp(1.75rem, 1.15rem + 2vw, 2.5rem);
    line-height: 1.2;
    font-weight: 700;
  }
  .lead,
  .empty,
  .contact-note {
    color: var(--color-ink-secondary);
  }
  .lead {
    margin: 0.75rem 0 0;
    max-width: 60ch;
  }
  .contact-note {
    margin: 2rem 0 0;
  }
</style>
