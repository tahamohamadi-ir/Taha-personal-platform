---
/* WF-07B adoption: research topic detail onto CollectionIndexTemplate
   (frozen route-map family "research topics"). The topic lead opens the
   collection; sibling topics render as Chip links in the filters slot
   (current topic marked selected); the topic body (story projection or
   prose sections) and the related project/publication ContentRow lists
   fill the results slot; each empty list stays honestly empty. All copy
   comes from the locale dictionary. */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import CollectionIndexTemplate from "../../../../layouts/CollectionIndexTemplate.astro";
import SectionLead from "../../../../components/content/SectionLead.astro";
import ContentRow from "../../../../components/content/ContentRow.astro";
import ContentState from "../../../../components/ui/ContentState.astro";
import Chip from "../../../../components/ui/Chip.astro";
import { content } from "../../../../data/content";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../../data/structured";
import { getResearchTopic, getResearchTopics } from "../../../../lib/cms/research";
import StoryBody from "../../../../components/StoryBody.astro";
import { hasPublishedStory } from "../../../../lib/cms/story";

export async function getStaticPaths() {
  const locale = "en" as const;
  const topics = await getResearchTopics(locale);
  return topics.map((topic) => ({ params: { slug: topic.slug } }));
}

const locale = "en" as const;
const pageContent = content[locale];
const research = pageContent.research;
const slug = Astro.params.slug as string;
const topic = await getResearchTopic(locale, slug);
if (!topic) {
  return Astro.redirect(`/${locale}/research/`, 302);
}
const allTopics = await getResearchTopics(locale);

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: research.heading, path: `/${locale}/research/` },
    { name: topic.title, path: `/${locale}/research/topics/${topic.slug}/` },
  ]),
];
validateStructuredData(...structured);
const alternateExists = (await getResearchTopic("fa", topic.slug)) !== null;
const topicHasStory = hasPublishedStory(topic.story);
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${topic.title} \u2014 ${pageContent.name}`,
      description: topic.summary || research.intro,
    },
  }}
  alternateHref={alternateExists ? `/fa/research/topics/${topic.slug}/` : null}
>
  <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(structured[0])} />
  <CollectionIndexTemplate>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: research.heading, href: `/${locale}/research/` },
        { label: topic.title },
      ]}
    />
    <div slot="sectionLead">
      <SectionLead
        as="h1"
        heading={topic.title}
        summary={topic.summary || undefined}
      />
      {
        !alternateExists && (
          <ContentState
            kind="unavailable-translation"
            explanation={research.missingTranslation}
          />
        )
      }
    </div>
    {
      allTopics.length > 0 && (
        <nav slot="filters" class="topic-chips" aria-label={research.topicsHeading}>
          {allTopics.map((t) => (
            <a
              href={`/${locale}/research/topics/${t.slug}/`}
              aria-current={t.slug === topic.slug ? "page" : undefined}
            >
              <Chip variant={t.slug === topic.slug ? "selected" : "taxonomy"}>
                {t.title}
              </Chip>
            </a>
          ))}
        </nav>
      )
    }
    <div slot="results" class="topic-results">
      {
        topicHasStory && topic.story ? (
          <StoryBody locale={locale} story={topic.story} />
        ) : (
          <div class="topic-prose">
            {topic.motivation && (
              <>
                <h2>Motivation</h2>
                <p>{topic.motivation}</p>
              </>
            )}
            {topic.problems && (
              <>
                <h2>Problems</h2>
                <p>{topic.problems}</p>
              </>
            )}
            {topic.research_questions && (
              <>
                <h2>Research questions</h2>
                <p>{topic.research_questions}</p>
              </>
            )}
            {topic.methods && (
              <>
                <h2>Methods</h2>
                <p>{topic.methods}</p>
              </>
            )}
            {topic.future_directions && (
              <>
                <h2>Future directions</h2>
                <p>{topic.future_directions}</p>
              </>
            )}
          </div>
        )
      }
      <h2 class="topic-related-heading">{research.relatedHeading}</h2>
      {
        topic.projects.length === 0 ? (
          <p class="topic-empty">{research.empty}</p>
        ) : (
          topic.projects.map((p) => (
            <ContentRow
              type={research.projectsHeading}
              title={p.title}
              href={`/${locale}/research/projects/${p.slug}/`}
            />
          ))
        )
      }
      {
        topic.publications.length === 0 ? (
          <p class="topic-empty">{research.empty}</p>
        ) : (
          topic.publications.map((p) => (
            <ContentRow
              type={research.publicationsHeading}
              title={p.title}
              href={`/${locale}/publications/${p.slug}/`}
            />
          ))
        )
      }
      <p class="topic-contact-note">
        <a href={`/${locale}/about/`}>{pageContent.about.heading}</a>
        {" \u2014 "}
        {research.contactNote}
      </p>
    </div>
  </CollectionIndexTemplate>
</BaseLayout>

<style>
  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .topic-chips a {
    text-decoration: none;
  }
  .topic-results h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin: var(--space-6) 0 var(--space-3);
  }
  .topic-empty {
    margin: 0 0 var(--space-4);
    color: var(--color-ink-muted);
  }
  .topic-contact-note {
    margin: var(--space-6) 0 0;
    color: var(--color-ink-muted);
  }
</style>
