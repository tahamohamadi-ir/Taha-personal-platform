---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { content } from "../../../data/content";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getDownloads, getDownload } from "../../../lib/cms/publications";

export async function getStaticPaths() {
  const locale = "en" as const;
  const items = await getDownloads(locale);
  return items.map((item) => ({ params: { slug: item.slug } }));
}

const locale = "en" as const;
const pageContent = content[locale];
const catalog = pageContent.catalog;
const slug = Astro.params.slug as string;
const item = await getDownload(locale, slug);
if (!item) {
  return Astro.redirect(`/${locale}/downloads/`, 302);
}
const alt = "fa" as const;
const alternateExists = (await getDownload(alt, item.slug)) !== null;

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: catalog.downloadsHeading, path: `/${locale}/downloads/` },
    { name: item.title, path: `/${locale}/downloads/${item.slug}/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${item.title} — ${pageContent.name}`,
      description: catalog.downloadsIntro,
    },
  }}
  alternateHref={alternateExists ? `/${alt}/downloads/${item.slug}/` : null}
>
  {structured.map((block) => (
    <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(block)} />
  ))}
  <section class="catalog-page">
    <Breadcrumbs items={[
      { label: pageContent.name, href: `/${locale}/` },
      { label: catalog.downloadsHeading, href: `/${locale}/downloads/` },
      { label: item.title },
    ]} />
    {!alternateExists && <p class="missing">{catalog.missingTranslation}</p>}
    <h1>{item.title}</h1>
    
    {item.description && <p>{item.description}</p>}
    <p class="meta">{item.download_type}{item.language ? ` · ${item.language}` : ""}</p>
    <p class="meta">{catalog.licenseLabel}: {item.license}</p>
    {item.file?.url ? (
      <p>
        <a href={item.file.url} rel="noopener noreferrer">{catalog.downloadLabel}</a>
        {item.size_bytes != null && <span class="meta"> ({item.size_bytes} bytes)</span>}
      </p>
    ) : (
      <p class="meta">{catalog.restrictedNote}</p>
    )}

    <p><a href={`/${locale}/downloads/`}>{catalog.downloadsHeading}</a></p>
  </section>
</BaseLayout>

<style>
  .catalog-page { max-width: 44rem; margin-inline: auto; padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 2.5rem) 3rem; }
  .catalog-page h1 { font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.4rem); margin: 0 0 0.5rem; }
  .catalog-page h2 { font-family: var(--font-display); font-size: 1.2rem; margin: 1.5rem 0 0.5rem; }
  .meta, .missing { color: var(--color-ink-muted); }
</style>
