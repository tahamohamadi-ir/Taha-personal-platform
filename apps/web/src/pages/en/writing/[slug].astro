---
/* WF-07E adoption: writing detail onto LongFormTemplate (frozen route-map
   family "writing detail"). The single H1 arrives through SectionLead
   as="h1" in the articleLead slot with the Jalali build-time date,
   reading time and topic tag chips; the body keeps the published-story
   branch plus the plain-body fallback and the license/accessibility
   footer; related carries only real records - series prev/next via the
   family SeriesNav and siblings that share the primary topic tag. The
   toc slot stays honestly unfilled: StoryBody exposes no headings
   extraction with anchor ids, so no TOC data exists today. Slug
   redirects, JSON-LD, alternate/ogImage wiring and word count are
   preserved verbatim from the pre-adoption route. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import LongFormTemplate from "../../../layouts/LongFormTemplate.astro";
import SectionLead from "../../../components/content/SectionLead.astro";
import Chip from "../../../components/ui/Chip.astro";
import StoryBody from "../../../components/StoryBody.astro";
import SeriesNav from "../../../components/blog/SeriesNav.astro";
import { content } from "../../../data/content";
import { formatDate, formatNumber } from "../../../lib/format";
import {
  blogPostingJsonLd,
  breadcrumbJsonLd,
  jsonLdScriptContent,
  validateStructuredData,
} from "../../../data/structured";
import {
  articlesForTag,
  getArticleRedirects,
  getPublishedArticle,
  getPublishedArticles,
  seriesNeighbors,
} from "../../../lib/cms/articles";

export async function getStaticPaths() {
  const locale = "en" as const;
  const articles = await getPublishedArticles(locale);
  const redirects = await getArticleRedirects(locale);
  const articlePaths = articles.map((article) => ({
    params: { slug: article.slug },
    props: { mode: "article" as const, targetSlug: article.slug },
  }));
  const redirectPaths = redirects
    .filter((r) => !articles.some((a) => a.slug === r.old_slug))
    .map((r) => ({
      params: { slug: r.old_slug },
      redirect: `/${locale}/writing/${r.new_slug}/`,
    }));
  return [...articlePaths, ...redirectPaths];
}

const locale = "en" as const;
const pageContent = content[locale];
const blog = pageContent.blog;
const { targetSlug } = Astro.props as { mode: "article"; targetSlug: string };

const article = await getPublishedArticle(locale, targetSlug);
if (!article) {
  return Astro.redirect(`/${locale}/writing/`, 302);
}

const allArticles = await getPublishedArticles(locale);
const primarySeries = article.series[0];
const neighbors = primarySeries
  ? seriesNeighbors(allArticles, primarySeries.slug, article.slug)
  : { prev: null, next: null };

const primaryTag = article.topic_tags[0] ?? null;
const tagSiblings = primaryTag
  ? articlesForTag(allArticles, primaryTag.slug).filter((a) => a.slug !== article.slug)
  : [];

const hasStory =
  article.story !== null &&
  article.story !== undefined &&
  article.story.sections.length > 0;
const license = article.license?.trim() ?? "";
const notes = article.accessibility_notes?.trim() ?? "";
const publishedDate = article.published_at
  ? formatDate(article.published_at, locale)
  : "";

const description =
  article.excerpt ||
  article.body.replace(/<[^>]+>/g, " ").trim().slice(0, 160);
const pageMeta = {
  ...pageContent,
  meta: {
    title: `${article.title} — ${pageContent.name}`,
    description,
  },
};

const structured = [
  blogPostingJsonLd({
    locale,
    title: article.title,
    description,
    slug: article.slug,
    publishedAt: article.published_at,
    updatedAt: article.updated_at,
    wordCount: article.body
      .replace(/<[^>]+>/g, " ")
      .trim()
      .split(/\s+/)
      .filter(Boolean).length,
  }),
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: blog.heading, path: `/${locale}/writing/` },
    { name: article.title, path: `/${locale}/writing/${article.slug}/` },
  ]),
];
validateStructuredData(...structured);

const alternateExists = (await getPublishedArticle("fa", article.slug)) !== null;
---

<BaseLayout
  content={pageMeta}
  alternateHref={alternateExists ? `/fa/writing/${article.slug}/` : null}
  ogImage={article.featured_image?.url ?? null}
>
  {
    structured.map((block) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={jsonLdScriptContent(block)}
      />
    ))
  }
  <LongFormTemplate>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: blog.heading, href: `/${locale}/writing/` },
        { label: article.title },
      ]}
    />
    <div slot="articleLead" class="article-lead">
      {
        !alternateExists && (
          <p class="missing-translation">{blog.missingTranslation}</p>
        )
      }
      <SectionLead as="h1" heading={article.title} />
      <p class="article-lead__meta">
        {
          publishedDate && (
            <time datetime={article.published_at ?? undefined}>{publishedDate}</time>
          )
        }
        {
          article.reading_time_minutes > 0 && (
            <span>
              {formatNumber(article.reading_time_minutes, locale)} {blog.readingLabel}
            </span>
          )
        }
      </p>
      {
        article.topic_tags.length > 0 && (
          <ul role="list" class="article-lead__tags">
            {article.topic_tags.map((tag) => (
              <li>
                <a href={`/${locale}/writing/tag/${tag.slug}/`}>
                  <Chip variant="taxonomy">{tag.name}</Chip>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div slot="body" class="article-body">
      {
        hasStory && article.story ? (
          <StoryBody locale={locale} story={article.story} />
        ) : (
          <div set:html={article.body} />
        )
      }
      {
        (license || notes) && (
          <footer class="article-footer">
            {license && (
              <p>
                {blog.licenseLabel}: {license}
              </p>
            )}
            {notes && (
              <aside class="article-a11y">
                <p>{notes}</p>
              </aside>
            )}
          </footer>
        )
      }
    </div>
    <div slot="related" class="article-related">
      <SeriesNav
        locale={locale}
        prev={neighbors.prev}
        next={neighbors.next}
        prevLabel={blog.prevLabel}
        nextLabel={blog.nextLabel}
        seriesLabel={blog.seriesNavLabel}
      />
      {
        primaryTag && tagSiblings.length > 0 && (
          <div class="article-related__siblings">
            <p class="article-related__label">{primaryTag.name}</p>
            <ul role="list" class="article-related__list">
              {tagSiblings.map((sibling) => (
                <li>
                  <a href={`/${locale}/writing/${sibling.slug}/`}>{sibling.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </LongFormTemplate>
</BaseLayout>

<style>
  .missing-translation {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .article-lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .article-lead__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
  }

  .article-lead__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-lead__tags a {
    text-decoration: none;
  }

  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    font-family: var(--font-display);
    margin-block-start: var(--space-6);
  }

  .article-body :global(p),
  .article-body :global(li) {
    line-height: 1.7;
  }

  .article-body :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--color-border-subtle);
    color: var(--color-ink-muted);
  }

  .article-footer {
    margin-block-start: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .article-a11y {
    margin-block-start: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border-subtle);
  }

  .article-related {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .article-related__label {
    margin: 0;
    color: var(--color-ink-tertiary);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [dir="rtl"] .article-related__label {
    letter-spacing: 0;
    text-transform: none;
  }

  .article-related__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
