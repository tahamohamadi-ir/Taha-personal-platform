---
/* WF-07E adoption: writing tag page onto EditorialIndexTemplate (frozen
   route-map family "writing tag"). Results are ContentRow rows from the
   existing tag loader helpers; the loader exposes no featured flag, no
   pagination and the family had no filter controls, so the featured slot
   and the filters slot stay honestly unfilled - nothing is invented. The
   tag page had no visible intro copy, so the lead renders the tag name
   only. The date label reuses the existing generic dictionary value from
   the projects namespace (the blog namespace carries no date label today).
   All copy comes from the locale dictionary. */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import EditorialIndexTemplate from "../../../../layouts/EditorialIndexTemplate.astro";
import SectionLead from "../../../../components/content/SectionLead.astro";
import ContentRow from "../../../../components/content/ContentRow.astro";
import ContentState from "../../../../components/ui/ContentState.astro";
import { content } from "../../../../data/content";
import { formatDate } from "../../../../lib/format";
import {
  articlesForTag,
  getPublishedArticles,
  getTopicTags,
} from "../../../../lib/cms/articles";

export async function getStaticPaths() {
  const locale = "en" as const;
  const tags = await getTopicTags(locale);
  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: { tag },
  }));
}

const locale = "en" as const;
const pageContent = content[locale];
const blog = pageContent.blog;
const { tag } = Astro.props;
const articles = articlesForTag(await getPublishedArticles(locale), tag.slug);
const dateLabel = pageContent.projects.dateLabel;
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${tag.name} — ${blog.heading}`,
      description: blog.intro,
    },
  }}
  alternateHref={`/fa/writing/tag/${tag.slug}/`}
>
  <EditorialIndexTemplate>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: blog.heading, href: `/${locale}/writing/` },
        { label: tag.name },
      ]}
    />
    <SectionLead slot="sectionLead" as="h1" heading={tag.name} />
    {
      articles.length === 0 ? (
        <ContentState slot="results" kind="empty" explanation={blog.empty} />
      ) : (
        <div slot="results">
          {articles.map((article) => (
            <ContentRow
              title={article.title}
              href={`/${locale}/writing/${article.slug}/`}
              excerpt={article.excerpt}
              metadata={
                article.published_at
                  ? [{ label: dateLabel, value: formatDate(article.published_at, locale) }]
                  : undefined
              }
              tags={article.topic_tags.map((t) => t.name)}
            />
          ))}
        </div>
      )
    }
  </EditorialIndexTemplate>
</BaseLayout>
