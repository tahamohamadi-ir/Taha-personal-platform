---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/blog/Breadcrumbs.astro";
import ArticleCard from "../../../components/blog/ArticleCard.astro";
import { content } from "../../../data/content";
import { getPublishedArticles } from "../../../lib/cms/articles";

const locale = "en" as const;
const pageContent = content[locale];
const articles = await getPublishedArticles(locale);
const blog = pageContent.blog;
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${blog.heading} — ${pageContent.name}`,
      description: blog.intro,
    },
  }}
  alternateHref="/fa/writing/"
>
  <section class="blog-page">
    <Breadcrumbs
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: blog.heading },
      ]}
    />
    <h1>{blog.heading}</h1>
    <p class="blog-intro">{blog.intro}</p>
    {
      articles.length === 0 ? (
        <p class="blog-empty">{blog.empty}</p>
      ) : (
        <div class="blog-list">
          {articles.map((article) => (
            <ArticleCard
              locale={locale}
              article={article}
              readingLabel={blog.readingLabel}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .blog-page {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 2.5rem) 3rem;
  }

  .blog-page h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin: 0 0 0.75rem;
  }

  .blog-intro,
  .blog-empty {
    color: var(--color-ink-muted);
    margin: 0 0 1.5rem;
  }
</style>
