---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/blog/Breadcrumbs.astro";
import ArticleCard from "../../../../components/blog/ArticleCard.astro";
import { content } from "../../../../data/content";
import {
  articlesForSeries,
  getPublishedArticles,
  getPublishedSeries,
} from "../../../../lib/cms/articles";

export async function getStaticPaths() {
  const locale = "en" as const;
  const seriesList = await getPublishedSeries(locale);
  return seriesList.map((series) => ({
    params: { slug: series.slug },
    props: { series },
  }));
}

const locale = "en" as const;
const pageContent = content[locale];
const blog = pageContent.blog;
const { series } = Astro.props;
const articles = articlesForSeries(await getPublishedArticles(locale), series.slug);
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${series.title} — ${blog.heading}`,
      description: series.description || blog.intro,
    },
  }}
  alternateHref={`/fa/writing/series/${series.slug}/`}
>
  <section class="blog-page">
    <Breadcrumbs
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: blog.heading, href: `/${locale}/writing/` },
        { label: series.title },
      ]}
    />
    <h1>{series.title}</h1>
    {series.description && <p class="blog-intro">{series.description}</p>}
    {
      articles.length === 0 ? (
        <p class="blog-empty">{blog.empty}</p>
      ) : (
        articles.map((article) => (
          <ArticleCard
            locale={locale}
            article={article}
            readingLabel={blog.readingLabel}
          />
        ))
      )
    }
  </section>
</BaseLayout>

<style>
  .blog-page {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 2.5rem) 3rem;
  }

  .blog-page h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin: 0 0 0.75rem;
  }

  .blog-intro,
  .blog-empty {
    color: var(--color-ink-muted);
    margin: 0 0 1.5rem;
  }
</style>
