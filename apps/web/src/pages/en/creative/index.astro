---
/* WF-07D: creative index adopted onto CollectionIndexTemplate. Results are
   a MediaTile grid (reserved 4/3 frame, caption, record link per tile);
   the list DTO carries no image fields, so tiles honestly render the
   MediaTile failed-variant placeholder - no invented imagery. Creative has
   no URL-backed filters and no pagination today, so the filters and
   pagination slots are left unfilled (nothing invented). */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CollectionIndexTemplate from "../../../layouts/CollectionIndexTemplate.astro";
import SectionLead from "../../../components/content/SectionLead.astro";
import MediaTile from "../../../components/content/MediaTile.astro";
import MetadataGroup from "../../../components/content/MetadataGroup.astro";
import ContentState from "../../../components/ui/ContentState.astro";
import { content } from "../../../data/content";
import { isCmsOriginBuild } from "../../../lib/cms/client";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getCreativeWorks } from "../../../lib/cms/creative";

const locale = "en" as const;
const pageContent = content[locale];
const t = pageContent.creative;
const items = await getCreativeWorks(locale);

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: t.heading, path: `/${locale}/creative/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout
  cmsBuildOrigin={isCmsOriginBuild() ? "cms" : "snapshot"}
  content={{
    ...pageContent,
    meta: { title: `${t.heading} — ${pageContent.name}`, description: t.intro },
  }}
  alternateHref="/fa/creative/"
>
  {structured.map((block) => <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(block)} />)}
  <CollectionIndexTemplate>
    <Breadcrumbs slot="breadcrumbs" items={[{ label: pageContent.name, href: `/${locale}/` }, { label: t.heading }]} />
    <SectionLead slot="sectionLead" as="h1" heading={t.heading} summary={t.intro} />
    {
      items.length === 0 ? (
        <ContentState slot="results" kind="empty" explanation={t.empty} />
      ) : (
        <div slot="results" class="creative-grid">
          {items.map((item) => (
            <div class="creative-grid__cell">
              <MediaTile
                caption={item.title}
                record={{ href: `/${locale}/creative/${item.slug}/`, label: item.title }}
                width={4}
                height={3}
              />
              <MetadataGroup
                items={[
                  { label: t.creatorLabel, value: item.creator_name },
                  { label: t.roleLabel, value: item.creator_role },
                  { label: t.dateLabel, value: item.creation_date ?? "" },
                ]}
              />
            </div>
          ))}
        </div>
      )
    }
  </CollectionIndexTemplate>
</BaseLayout>

<style>
  .creative-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(var(--space-24), 1fr));
  }

  .creative-grid__cell {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }
</style>
