---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { content } from "../../../data/content";
import { isCmsOriginBuild } from "../../../lib/cms/client";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getPublications } from "../../../lib/cms/publications";

const locale = "en" as const;
const pageContent = content[locale];
const catalog = pageContent.catalog;
const publications = await getPublications(locale);

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: catalog.publicationsHeading, path: `/${locale}/publications/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout cmsBuildOrigin={isCmsOriginBuild() ? "cms" : "snapshot"}
  content={{
    ...pageContent,
    meta: {
      title: `${catalog.publicationsHeading} — ${pageContent.name}`,
      description: catalog.publicationsIntro,
    },
  }}
  alternateHref="/fa/publications/"
>
  {
    structured.map((block) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={jsonLdScriptContent(block)}
      />
    ))
  }
  <section class="catalog-page">
    <Breadcrumbs
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: catalog.publicationsHeading },
      ]}
    />
    <h1>{catalog.publicationsHeading}</h1>
    <p class="lead">{catalog.publicationsIntro}</p>
    {
      publications.length === 0 ? (
        <div class="empty-state">
          <p>{catalog.publicationsEmpty}</p>
          <p>{catalog.emptyNextAction}</p>
        </div>
      ) : (
        <ul class="catalog-list">
          {publications.map((pub) => (
            <li>
              <a href={`/${locale}/publications/${pub.slug}/`}>{pub.title}</a>
              {pub.authors && <p class="meta">{pub.authors}</p>}
              {(pub.venue || pub.date) && (
                <p class="meta">
                  {[pub.venue, pub.date].filter(Boolean).join(" · ")}
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .catalog-page {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 2.5rem) 3rem;
  }
  .catalog-page h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin: 0 0 0.5rem;
  }
  .lead,
  .meta {
    color: var(--color-ink-muted);
  }
  .catalog-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1.25rem;
  }
  .catalog-list a {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
</style>
