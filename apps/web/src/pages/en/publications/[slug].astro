---
/* WF-07B adoption: publication detail onto EvidenceDetailTemplate (frozen
   route-map family "publication detail"). Evidence anatomy: lead (title +
   authors), MetadataGroup for the labeled record facts (license, DOI as a
   bdi-isolated omitted-when-absent item) with the unlabeled venue/date
   source line (the locale dictionaries own no venue/date labels - none
   were invented), body (abstract, citation block, links/files), and the
   related close back to Research. Unavailable translation renders the
   ContentState status panel in the lead. Copy from the locale dictionary. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import EvidenceDetailTemplate from "../../../layouts/EvidenceDetailTemplate.astro";
import SectionLead from "../../../components/content/SectionLead.astro";
import MetadataGroup from "../../../components/content/MetadataGroup.astro";
import ContentState from "../../../components/ui/ContentState.astro";
import { content } from "../../../data/content";
import {
  breadcrumbJsonLd,
  jsonLdScriptContent,
  scholarlyArticleJsonLd,
  validateStructuredData,
} from "../../../data/structured";
import {
  getPublication,
  getPublications,
} from "../../../lib/cms/publications";

export async function getStaticPaths() {
  const locale = "en" as const;
  const publications = await getPublications(locale);
  return publications.map((pub) => ({ params: { slug: pub.slug } }));
}

const locale = "en" as const;
const pageContent = content[locale];
const catalog = pageContent.catalog;
const slug = Astro.params.slug as string;
const publication = await getPublication(locale, slug);
if (!publication) {
  return Astro.redirect(`/${locale}/publications/`, 302);
}

const description =
  (publication.abstract || "").trim() ||
  [publication.authors, publication.venue].filter(Boolean).join(" \u2014 ") ||
  catalog.publicationsIntro;

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: catalog.publicationsHeading, path: `/${locale}/publications/` },
    {
      name: publication.title,
      path: `/${locale}/publications/${publication.slug}/`,
    },
  ]),
];
const scholarly = scholarlyArticleJsonLd({
  locale,
  title: publication.title,
  slug: publication.slug,
  authors: publication.authors,
  venue: publication.venue,
  date: publication.date,
  doi: publication.doi,
  url: publication.url,
});
if (scholarly) structured.push(scholarly);
validateStructuredData(...structured);
const alternateExists =
  (await getPublication("fa", publication.slug)) !== null;
const pdfHref = publication.pdf?.url || publication.pdf_url || "";

const metadataItems = [
  { label: catalog.licenseLabel, value: publication.license },
  { label: "DOI", value: publication.doi, ltr: true },
];
const hasSourceLine = Boolean(publication.venue || publication.date);
---

<BaseLayout
  content={{
    ...pageContent,
    meta: {
      title: `${publication.title} \u2014 ${pageContent.name}`,
      description,
    },
  }}
  alternateHref={
    alternateExists ? `/fa/publications/${publication.slug}/` : null
  }
>
  {
    structured.map((block) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={jsonLdScriptContent(block)}
      />
    ))
  }
  <EvidenceDetailTemplate>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: pageContent.name, href: `/${locale}/` },
        { label: catalog.publicationsHeading, href: `/${locale}/publications/` },
        { label: publication.title },
      ]}
    />
    <div slot="lead">
      <SectionLead
        as="h1"
        heading={publication.title}
        summary={publication.authors || undefined}
      />
      {
        !alternateExists && (
          <ContentState
            kind="unavailable-translation"
            explanation={catalog.missingTranslation}
          />
        )
      }
    </div>
    <div slot="metadata">
      <MetadataGroup items={metadataItems} />
      {
        hasSourceLine && (
          <p class="publication-source">
            {[publication.venue, publication.date].filter(Boolean).join(" \u00b7 ")}
          </p>
        )
      }
    </div>
    <div slot="body" class="publication-body">
      {
        publication.abstract && (
          <>
            <h2>{catalog.abstractHeading}</h2>
            <p>{publication.abstract}</p>
          </>
        )
      }
      {
        publication.citation_text ? (
          <>
            <h2>{catalog.citationLabel}</h2>
            <pre class="citation">{publication.citation_text}</pre>
          </>
        ) : (
          <p class="publication-meta">{catalog.citationUnavailable}</p>
        )
      }
      {
        publication.citation_count != null && (
          <p class="publication-meta">Citations: {publication.citation_count}</p>
        )
      }
      {
        publication.url && (
          <p>
            <a href={publication.url} rel="noopener noreferrer">
              {publication.url}
            </a>
          </p>
        )
      }
      {
        pdfHref ? (
          <p>
            <a href={pdfHref} rel="noopener noreferrer">
              PDF
            </a>
          </p>
        ) : publication.access_state !== "public" ? (
          <p class="publication-meta">{catalog.restrictedNote}</p>
        ) : null
      }
    </div>
    <div slot="related" class="publication-related">
      <p>
        <a href={`/${locale}/research/`}>{catalog.parentResearchLabel}</a>
      </p>
    </div>
  </EvidenceDetailTemplate>
</BaseLayout>

<style>
  .publication-source {
    margin: var(--space-3) 0 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
  }
  .publication-body h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin: var(--space-6) 0 var(--space-2);
  }
  .publication-meta {
    color: var(--color-ink-muted);
  }
  .citation {
    white-space: pre-wrap;
    font-family: var(--font-body);
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
  }
</style>
