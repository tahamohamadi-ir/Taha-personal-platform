---
/* WF-07F adoption: teaching index onto EditorialIndexTemplate (frozen
   route-map family "teaching"). Results are ContentRow items; the type
   badge carries the raw CMS level value because the locale dictionary
   has no level labels (PF-06: CMS fields only, no invented translations);
   format/language render through the row's MetadataGroup with absent
   values omitted. The loader exposes no featured flag and the family has
   no URL-backed filters, so the featured and filters slots stay unfilled
   (nothing invented). Honest empty state via ContentState. No enrolment,
   progress, or certificate UI exists - this is a publishing library. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import EditorialIndexTemplate from "../../../layouts/EditorialIndexTemplate.astro";
import SectionLead from "../../../components/content/SectionLead.astro";
import ContentRow from "../../../components/content/ContentRow.astro";
import ContentState from "../../../components/ui/ContentState.astro";
import { content } from "../../../data/content";
import { isCmsOriginBuild } from "../../../lib/cms/client";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getCourses } from "../../../lib/cms/courses";

const locale = "en" as const;
const pageContent = content[locale];
const t = pageContent.teaching;
const items = await getCourses(locale);

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: t.heading, path: `/${locale}/teaching/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout
  cmsBuildOrigin={isCmsOriginBuild() ? "cms" : "snapshot"}
  content={{
    ...pageContent,
    meta: { title: `${t.heading} — ${pageContent.name}`, description: t.intro },
  }}
  alternateHref="/fa/teaching/"
>
  {structured.map((block) => <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(block)} />)}
  <EditorialIndexTemplate>
    <Breadcrumbs slot="breadcrumbs" items={[{ label: pageContent.name, href: `/${locale}/` }, { label: t.heading }]} />
    <SectionLead slot="sectionLead" as="h1" heading={t.heading} summary={t.intro} />
    {
      items.length === 0 ? (
        <ContentState slot="results" kind="empty" explanation={t.empty} />
      ) : (
        <div slot="results" class="course-list">
          {items.map((item) => (
            <ContentRow
              type={item.level}
              title={item.title}
              href={`/${locale}/teaching/${item.slug}/`}
              excerpt={item.description || undefined}
              metadata={[
                { label: t.formatLabel, value: item.course_format },
                { label: t.languageLabel, value: item.course_language },
              ]}
            />
          ))}
        </div>
      )
    }
  </EditorialIndexTemplate>
</BaseLayout>
