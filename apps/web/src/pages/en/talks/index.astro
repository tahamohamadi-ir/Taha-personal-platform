---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { content } from "../../../data/content";
import { isCmsOriginBuild } from "../../../lib/cms/client";
import { breadcrumbJsonLd, jsonLdScriptContent, validateStructuredData } from "../../../data/structured";
import { getTalks } from "../../../lib/cms/publications";

const locale = "en" as const;
const pageContent = content[locale];
const catalog = pageContent.catalog;
const items = await getTalks(locale);
const alt = "fa";

const structured = [
  breadcrumbJsonLd([
    { name: pageContent.name, path: `/${locale}/` },
    { name: catalog.talksHeading, path: `/${locale}/talks/` },
  ]),
];
validateStructuredData(...structured);
---

<BaseLayout cmsBuildOrigin={isCmsOriginBuild() ? "cms" : "snapshot"}
  content={{
    ...pageContent,
    meta: {
      title: `${catalog.talksHeading} — ${pageContent.name}`,
      description: catalog.talksIntro,
    },
  }}
  alternateHref={`/${alt}/talks/`}
>
  {structured.map((block) => (
    <script type="application/ld+json" is:inline set:html={jsonLdScriptContent(block)} />
  ))}
  <section class="catalog-page">
    <Breadcrumbs items={[
      { label: pageContent.name, href: `/${locale}/` },
      { label: catalog.talksHeading },
    ]} />
    <h1>{catalog.talksHeading}</h1>
    <p class="lead">{catalog.talksIntro}</p>
    {items.length === 0 ? (
      <div class="empty-state">
        <p>{catalog.talksEmpty}</p>
        <p>{catalog.emptyNextAction}</p>
      </div>
    ) : (
      <ul class="catalog-list">
        {items.map((item) => (
          <li>
            <a href={`/${locale}/talks/${item.slug}/`}>{item.title}</a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .catalog-page { max-width: 44rem; margin-inline: auto; padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 2.5rem) 3rem; }
  .catalog-page h1 { font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.4rem); margin: 0 0 0.5rem; }
  .lead { color: var(--color-ink-muted); }
  .catalog-list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1rem; }
  .catalog-list a { font-family: var(--font-display); font-size: 1.15rem; }
</style>
