# Secrets and local configuration
.env
.env.*
!.env.example

# Backup automation secrets: the real environment file lives at
# /etc/taha-backup.env on the VPS and never in Git; only the .example is tracked.
infra/backup/*.env
!infra/backup/*.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node and generated frontend output
node_modules/
dist/
build/
.astro/
.cache/
coverage/

# Local runtime data and logs
*.log
media/
!apps/cms/apps/media/
!apps/cms/apps/media/**
apps/cms/apps/media/**/__pycache__/
apps/cms/apps/media/**/*.py[cod]
staticfiles/
static/
!apps/cms/apps/admin/static/
!apps/cms/apps/admin/static/**
postgres-data/
*.sqlite3

# OS file-system artifacts
.DS_Store
Thumbs.db
desktop.ini

# Owner source assets (drafts; processed files in apps/web/public/)
Assets/

# Editors and IDEs
.idea/
.vscode/

# Agent-local control-plane state (OpenCode, Serena, Claude Code).
# Project agent definitions are versioned; everything else stays local.
.opencode/*
!.opencode/agent/
.serena/
.claude/
.cursor/

# Local worktrees
.worktrees/
worktrees/

# graphify pipeline outputs (regenerate with /graphify)
graphify-out/

# Nested sample/research copies — never commit from this repo
Samples/

# Playwright local artifacts
**/test-results/
**/playwright-report/
**/blob-report/

# Local archive for deduplicated/legacy files (never commit)
_archive/

# Local editor/agent tooling state
.serena/
