# Stage 1: Build
FROM node:24-alpine AS build
WORKDIR /app

ARG CMS_API_BASE=""
ENV CMS_API_BASE=${CMS_API_BASE}

COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
RUN cd apps/web && npm ci

COPY apps/web/ ./apps/web/
RUN cd apps/web && npm run build

# Stage 2: Serve
FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

LABEL org.opencontainers.image.source="https://github.com/tahamohamadi-ir/Taha-personal-platform"
LABEL org.opencontainers.image.description="Taha personal platform — static web (nginx)"

RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY infra/web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

# nginx:alpine already runs as nginx user via its entrypoint
CMD ["nginx", "-g", "daemon off;"]
