# Caddy reverse-proxy snippet for the CMS runtime.
# Add this block inside the site block in /etc/caddy/Caddyfile.
# /admin/ and /health/ are reverse-proxied to the cms service;
# all other paths keep serving the static site from disk.
# The cms container must publish its port to 127.0.0.1:18000 on the host.

handle /admin/* {
	reverse_proxy 127.0.0.1:18000 {
		header_down X-Robots-Tag "noindex, nofollow"
		header_down Cache-Control "no-store, no-cache, must-revalidate"
	}
}

handle /health/* {
	reverse_proxy 127.0.0.1:18000
}
