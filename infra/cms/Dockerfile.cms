# syntax=docker/dockerfile:1
# NOT-APPLIED — candidate only; deploy requires owner capacity decision (RISK-0007) and a separate Task Spec
#
# Candidate multi-stage image for the CMS runtime (Django 5.2 / Wagtail 7.4 / Ninja).
# Build context is the repository root (needed for apps/cms/ + uv.lock).
# NOT built anywhere yet; runtime env vars (DJANGO_SECRET_KEY, POSTGRES_*, etc.)
# come from the compose .env at runtime — never baked into the image.
#
# Deploy slice must add a repo-root .dockerignore (exclude apps/cms/.venv,
# dev.sqlite3, __pycache__) before the first real build.

FROM python:3.12-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.8.5 /uv /uvx /bin/
WORKDIR /build
COPY apps/cms/pyproject.toml apps/cms/uv.lock ./
RUN uv sync --frozen --no-dev

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=builder /build/.venv ./.venv
COPY apps/cms ./
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin app \
    && mkdir -p staticfiles media \
    && chown -R app:app /app
# Build-time-only dummy values for collectstatic; not secrets and never used at runtime.
RUN ALLOWED_HOSTS=localhost DJANGO_SECRET_KEY=build-time-only-no-secret \
    ./.venv/bin/python manage.py collectstatic --noinput

USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["./.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/', timeout=3)"]
CMD ["./.venv/bin/gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "config.wsgi:application"]
