# Production Caddyfile — tahamohamadi.ir (HOST edge)
#
# HISTORICAL / ROLLBACK ONLY: the Compose edge (infra/caddy/Caddyfile.compose)
# is live since DEFER-0031 CLOSED (LOG-0210). CD reloads Compose caddy while
# repository variable CADDY_EDGE=compose; this host-edge file is kept for
# rollback per infra/caddy/HOST-CADDY-DISABLE.md. Do NOT edit
# /etc/caddy/Caddyfile on the VPS directly; change this file and push to main.
#
# Compose-edge alternative (Docker DNS upstreams): infra/caddy/Caddyfile.compose
# Host disable + cutover/rollback: infra/caddy/HOST-CADDY-DISABLE.md
# and DEPLOY_RUNBOOK § "Caddy-in-Compose cutover".

(taha_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# DEFER-0021: Report-Only first. Designed so existing inline JSON-LD,
		# About/catalog scripts, and primaryColor style injection are allowed
		# when later switched to enforce. Owner must confirm demo hosts before
		# adding them to frame-src and before enforce mode.
		# Placeholders (uncomment + replace after owner approval):
		#   https://OWNER_APPROVED_DEMO_HOST
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; media-src 'self'; frame-src 'self'; object-src 'none'"
	}
}

# Rollback until rsync /opt/taha/site/current is removed: restore
# root * /opt/taha/site/current + file_server (see static-site.caddy).
# 404 body+status come from nginx (try_files =404 + error_page). Do not
# re-proxy /404.html here — that would turn 404 into 200 and break smoke.
(taha_application_routes) {
	reverse_proxy 127.0.0.1:13080
}

tahamohamadi.ir {
	# Legacy static assets served directly from /var/www/html
	handle /fonts/* {
		root * /var/www/html
		file_server
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, OPTIONS"
	}

	handle /presentation* {
		root * /var/www/html
		file_server
	}

	import taha_security_headers

	# --- CMS reverse proxy routes (Django/Ninja on 127.0.0.1:18000) ---

	redir /admin /admin/ 308

	handle /admin/* {
		reverse_proxy 127.0.0.1:18000 {
			header_down X-Robots-Tag "noindex, nofollow"
			header_down Cache-Control "no-store, no-cache, must-revalidate"
		}
	}

	handle /health/* {
		reverse_proxy 127.0.0.1:18000
	}

	handle /static/* {
		reverse_proxy 127.0.0.1:18000 {
			header_down X-Robots-Tag "noindex, nofollow"
			header_down Cache-Control "public, max-age=3600"
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:18000 {
			header_down Cache-Control "public, max-age=60"
		}
	}

	handle /media/* {
		reverse_proxy 127.0.0.1:18000 {
			header_down Cache-Control "public, max-age=86400"
		}
	}

	redir /preview/share /preview/share/ 308

	handle /preview/share/* {
		reverse_proxy 127.0.0.1:18000 {
			header_down X-Robots-Tag "noindex, nofollow, noarchive"
			header_down Cache-Control "no-store, no-cache, must-revalidate"
		}
	}

	redir /staff /staff/ 308

	handle /staff/* {
		reverse_proxy 127.0.0.1:18000 {
			header_down X-Robots-Tag "noindex, nofollow"
			header_down Cache-Control "no-store, no-cache, must-revalidate"
		}
	}

	# Catch-all: nginx web container (Astro dist on loopback 13080)
	import taha_application_routes
}

www.tahamohamadi.ir {
	redir https://tahamohamadi.ir{uri} permanent
}

http://85.192.29.196 {
	redir https://tahamohamadi.ir{uri} permanent
}

https://85.192.29.196 {
	tls internal

	handle /fonts/* {
		root * /var/www/html
		file_server
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, OPTIONS"
	}

	handle /presentation* {
		root * /var/www/html
		file_server
	}

	import taha_security_headers
	import taha_application_routes
}
