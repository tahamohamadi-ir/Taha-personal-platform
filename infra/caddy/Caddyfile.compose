# In-Compose Caddyfile — ADR-0027 Slice 4 / DEFER-0031
#
# Used only when Compose service `caddy` (profile `edge`) owns public 80/443.
# Upstream targets are Docker DNS names on network `cms_internal`.
#
# Host edge (infra/caddy/Caddyfile + systemd caddy) must be stopped before this
# process binds 80/443. See DEPLOY_RUNBOOK § "Caddy-in-Compose cutover".
#
# Deploy / reload (owner, after cutover):
#   docker compose -f infra/cms/docker-compose.cms.yml --profile edge \
#     up -d caddy
#   # or: bash infra/deploy/caddy-compose-reload.sh
#
# Do NOT point caddy-sync.sh at this file while host Caddy still owns the ports.

(taha_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# DEFER-0021: Report-Only first. Designed so existing inline JSON-LD,
		# About/catalog scripts, and primaryColor style injection are allowed
		# when later switched to enforce. Owner must confirm demo hosts before
		# adding them to frame-src and before enforce mode.
		# Placeholders (uncomment + replace after owner approval):
		#   https://OWNER_APPROVED_DEMO_HOST
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; media-src 'self'; frame-src 'self'; object-src 'none'"
	}
}

# Catch-all public HTML: nginx `web` on the Compose network (port 8080).
(taha_application_routes) {
	reverse_proxy web:8080
}

tahamohamadi.ir {
	# Legacy static assets from the host (mounted read-only into the container).
	handle /fonts/* {
		root * /var/www/html
		file_server
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, OPTIONS"
	}

	handle /presentation* {
		root * /var/www/html
		file_server
	}

	import taha_security_headers

	redir /admin /admin/ 308

	handle /admin/* {
		reverse_proxy cms:8000 {
			header_down X-Robots-Tag "noindex, nofollow"
			header_down Cache-Control "no-store, no-cache, must-revalidate"
		}
	}

	handle /health/* {
		reverse_proxy cms:8000
	}

	handle /static/* {
		reverse_proxy cms:8000 {
			header_down X-Robots-Tag "noindex, nofollow"
			header_down Cache-Control "public, max-age=3600"
		}
	}

	handle /api/* {
		reverse_proxy cms:8000 {
			header_down Cache-Control "public, max-age=60"
		}
	}

	handle /media/* {
		reverse_proxy cms:8000 {
			header_down Cache-Control "public, max-age=86400"
		}
	}

	redir /preview/share /preview/share/ 308

	handle /preview/share/* {
		reverse_proxy cms:8000 {
			header_down X-Robots-Tag "noindex, nofollow, noarchive"
			header_down Cache-Control "no-store, no-cache, must-revalidate"
		}
	}

	# Django staff HTML after Wagtail removal (DEBT-0003 CLOSED / PR #69).
	# `/admin/*` does not match `/staff/*` — both must be proxied.
	redir /staff /staff/ 308

	handle /staff/* {
		reverse_proxy cms:8000 {
			header_down X-Robots-Tag "noindex, nofollow"
			header_down Cache-Control "no-store, no-cache, must-revalidate"
		}
	}

	import taha_application_routes
}

www.tahamohamadi.ir {
	redir https://tahamohamadi.ir{uri} permanent
}

http://85.192.29.196 {
	redir https://tahamohamadi.ir{uri} permanent
}

https://85.192.29.196 {
	tls internal

	handle /fonts/* {
		root * /var/www/html
		file_server
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, OPTIONS"
	}

	handle /presentation* {
		root * /var/www/html
		file_server
	}

	import taha_security_headers
	import taha_application_routes
}
